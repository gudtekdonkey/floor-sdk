{
  "name": "@floorlaunchpad/sdk",
  "version": "0.1.1",
  "description": "FLOOR: one API for FLOOR launches on every chain. Chain adapters: @floorlaunchpad/sdk-evm, @floorlaunchpad/sdk-solana.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gudtekdonkey/floor-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/gudtekdonkey/floor-sdk/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/gudtekdonkey/floor-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
