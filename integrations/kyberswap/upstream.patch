+// tracked is a USDC-at-currency1 pool as Track keeps it, with the pool's tick at -370540 (engine tick 370539).
+func tracked() *Hook {
+	h := &Hook{Hook: &uniswapv4.BaseHook{}, Extra: Extra{
+		TickSpacing: 60, QuoteIsCurrency1: true, FloorTick: 375660, Rates: testRates,
+		CushionLower: 375060, HasCushion: true,
+	}}
+	h.tick, h.hasTick = -370540, true
+	return h
+}
+
+// The registered factory rebuilds the hook from the tracked extra and the pool's tick, and the address's permission
+// bits select beforeSwap and afterSwap with both return deltas (0x20cc: beforeInitialize | beforeSwap | afterSwap |
+// beforeSwapReturnDelta | afterSwapReturnDelta).
+func TestFactory_RegisteredAndPermissions(t *testing.T) {
+	addr := common.HexToAddress("0xe44886ffe0a894c6C5900d77A51c7d49732C60Cc")
+	extra := tracked().Extra
+	hX, err := json.Marshal(extra)
+	require.NoError(t, err)
+	hook, ok := uniswapv4.GetHook(addr, &uniswapv4.HookParam{
+		HookExtra: uniswapv4.HookExtra(hX),
+		Pool:      &entity.Pool{Extra: `{"liquidity":1,"sqrtPriceX96":1,"tickSpacing":60,"tick":-370540,"ticks":[]}`},
+	})
+	require.True(t, ok)
+	h, isFloor := hook.(*Hook)
+	require.True(t, isFloor)
+	assert.Equal(t, extra, h.Extra)
+	assert.Equal(t, -370540, h.tick)
+	assert.True(t, h.hasTick)
+	assert.Equal(t, string(valueobject.ExchangeUniswapV4Floor), h.GetExchange())
+	assert.True(t, h.CanBeforeSwap(addr))
+	assert.True(t, h.CanAfterSwap(addr))
+
+	const (
+		beforeInitialize      = 1 << 13
+		beforeSwap            = 1 << 7
+		afterSwap             = 1 << 6
+		beforeSwapReturnDelta = 1 << 3
+		afterSwapReturnDelta  = 1 << 2
+	)
+	flags := (uint16(addr[18])<<8 | uint16(addr[19])) & 0x3fff
+	assert.Equal(t, uint16(beforeInitialize|beforeSwap|afterSwap|beforeSwapReturnDelta|afterSwapReturnDelta), flags)
+
+	// a pool whose extra carries no tick is never priced
+	hook, _ = uniswapv4.GetHook(addr, &uniswapv4.HookParam{HookExtra: uniswapv4.HookExtra(hX)})
+	_, err = hook.BeforeSwap(&uniswapv4.BeforeSwapParams{CalcOut: true, AmountSpecified: big.NewInt(1e6)})
+	assert.ErrorIs(t, err, ErrPoolNotTracked)
+}
+
+func TestBeforeSwap_Refusals(t *testing.T) {
+	h := tracked()
+	_, err := h.BeforeSwap(&uniswapv4.BeforeSwapParams{CalcOut: false, AmountSpecified: big.NewInt(1e6)})
+	assert.ErrorIs(t, err, ErrExactOutNotSupported, "the hook reverts ExactOutNotSupported")
+
+	_, err = (&Hook{Hook: &uniswapv4.BaseHook{}}).BeforeSwap(&uniswapv4.BeforeSwapParams{CalcOut: true,
+		AmountSpecified: big.NewInt(1e6)})
+	assert.ErrorIs(t, err, ErrPoolNotTracked)
+
+	_, err = h.BeforeSwap(&uniswapv4.BeforeSwapParams{CalcOut: true, AmountSpecified: big.NewInt(0)})
+	assert.ErrorIs(t, err, uniswapv4.ErrInvalidAmountIn)
+
+	h.bidReplaced = true
+	_, err = h.BeforeSwap(&uniswapv4.BeforeSwapParams{CalcOut: true, AmountSpecified: big.NewInt(1e6)})
+	assert.ErrorIs(t, err, ErrBidReplacePending)
+}
+
+// A buy (quote in; the quote is currency1, so oneForZero) takes its fees before the swap at the pre-swap skim; a sell
+// takes nothing before it. Both override the LP fee to 0.25%.
+func TestBeforeSwap_BuyTakesFeesSellDoesNot(t *testing.T) {
+	h := tracked()
+	amount := big.NewInt(1_000_000_000)
+
+	buy, err := h.BeforeSwap(&uniswapv4.BeforeSwapParams{CalcOut: true, ZeroForOne: false, AmountSpecified: amount})
+	require.NoError(t, err)
+	require.NoError(t, uniswapv4.ValidateBeforeSwapResult(buy))
+	// engine tick 370539, dear edge 375540: distance 5001, closeness 10000 - 3107 = 6893, skim 100 - 68 = 32;
+	// gap 375060 - 370539 = 4521: m = 10000 + 5000 * 2289 / 2877 = 13978, skim 32 * 13978 / 10000 = 44
+	assert.Equal(t, big.NewInt(1_000_000_000*(44+50+25+25)/10_000), buy.DeltaSpecified)
+	assert.Zero(t, buy.DeltaUnspecified.Sign())
+	assert.Equal(t, uniswapv4.FeeAmount(lpFeePips), buy.SwapFee)
+	assert.Equal(t, int64(gasBeforeSwap+gasTakeFees), buy.Gas)
+
+	sell, err := h.BeforeSwap(&uniswapv4.BeforeSwapParams{CalcOut: true, ZeroForOne: true, AmountSpecified: amount})
+	require.NoError(t, err)
+	assert.Zero(t, sell.DeltaSpecified.Sign())
+	assert.Equal(t, uniswapv4.FeeAmount(lpFeePips), sell.SwapFee)
+	assert.Equal(t, int64(gasBeforeSwap), sell.Gas)
+}
+
+func afterSwap(h *Hook, zeroForOne bool, amountOut int64, tick int, remaining uint64,
+) (*uniswapv4.AfterSwapResult, *SwapInfo, error) {
+	params := &uniswapv4.BeforeSwapParams{CalcOut: true, ZeroForOne: zeroForOne, AmountSpecified: big.NewInt(1e18)}
+	before, err := h.BeforeSwap(params)
+	if err != nil {
+		return nil, nil, err
+	}
+	res, err := h.AfterSwap(&uniswapv4.AfterSwapParams{
+		BeforeSwapParams: params,
+		AmountIn:         params.AmountSpecified,
+		AmountOut:        big.NewInt(amountOut),
+		BeforeSwapResult: before,
+		PoolSwapInfo: &uniswapv4.PoolSwapInfo{
+			RemainingAmountIn:     uint256.NewInt(remaining),
+			NextStateSqrtRatioX96: uint256.NewInt(1),
+			NextStateTickCurrent:  tick,
+		},
+	})
+	return res, before.SwapInfo.(*SwapInfo), err
+}
+
+// A sell takes its fees after the swap at the post-swap skim. One that ends in the bid band (engine tick at or past
+// the dear edge, 375540 here) is flagged and costs the bid re-place's gas; applying it stops the pool quoting.
+func TestAfterSwap_SellSkimAtThePostSwapPriceAndTheBand(t *testing.T) {
+	h := tracked()
+	// engine tick 370539 (raw -370540): distance 5001 from the dear edge, sell skim 100 + 400 * 6893 / 10000 = 375
+	res, info, err := afterSwap(h, true, 1_000_000_000, -370540, 0)
+	require.NoError(t, err)
+	assert.Equal(t, big.NewInt(1_000_000_000*(375+75+0+25)/10_000), res.HookFee)
+	assert.Equal(t, int64(gasTakeFees), res.Gas)
+	assert.Equal(t, SwapInfo{Tick: -370540}, *info)
+
+	// engine tick 375539 is one tick short of the band
+	_, info, err = afterSwap(h, true, 1_000_000_000, -375540, 0)
+	require.NoError(t, err)
+	assert.False(t, info.BandReached)
+
+	// engine tick 375540 is in it: the at-floor sell skim, 500
+	res, info, err = afterSwap(h, true, 1_000_000_000, -375541, 0)
+	require.NoError(t, err)
+	assert.Equal(t, big.NewInt(1_000_000_000*(500+75+0+25)/10_000), res.HookFee)
+	assert.Equal(t, int64(gasTakeFees+gasBidReplace), res.Gas)
+	assert.Equal(t, SwapInfo{Tick: -375541, BandReached: true}, *info)
+
+	cloned := h.CloneState().(*Hook)
+	cloned.UpdateBalance(info)
+	assert.Equal(t, -375541, cloned.tick)
+	_, err = cloned.BeforeSwap(&uniswapv4.BeforeSwapParams{CalcOut: true, AmountSpecified: big.NewInt(1e6)})
+	assert.ErrorIs(t, err, ErrBidReplacePending)
+	// the original is untouched
+	assert.Equal(t, -370540, h.tick)
+	assert.False(t, h.bidReplaced)
+
+	// a buy takes nothing after the swap, but its post-swap tick moves the hook's view of the pool
+	res, info, err = afterSwap(h, false, 1_000_000_000, -369000, 0)
+	require.NoError(t, err)
+	assert.Zero(t, res.HookFee.Sign())
+	h.UpdateBalance(info)
+	assert.Equal(t, -369000, h.tick)
+}
+
+// The V4Quoter refuses a swap the pool cannot fill whole; the buy's fees were taken on the whole input.
+func TestAfterSwap_PartialFillAndMissingStateRefused(t *testing.T) {
+	_, _, err := afterSwap(tracked(), false, 1, -369000, 1)
+	assert.ErrorIs(t, err, ErrPartialFill)
+
+	h := tracked()
+	_, err = h.AfterSwap(&uniswapv4.AfterSwapParams{
+		BeforeSwapParams: &uniswapv4.BeforeSwapParams{CalcOut: true}, AmountOut: big.NewInt(1),
+	})
+	assert.ErrorIs(t, err, ErrMissingPostSwapState)
+
+	_, err = h.AfterSwap(&uniswapv4.AfterSwapParams{BeforeSwapParams: &uniswapv4.BeforeSwapParams{CalcOut: false}})
+	assert.ErrorIs(t, err, ErrExactOutNotSupported)
+}
+
+// fill sets every nil *big.Int reachable in v to zero, so a decode target can be ABI-encoded.
+func fill(v reflect.Value) {
+	switch v.Kind() {
+	case reflect.Pointer:
+		if v.Type() == reflect.TypeOf(&big.Int{}) && v.IsNil() {
+			v.Set(reflect.ValueOf(new(big.Int)))
+		}
+	case reflect.Struct:
+		for i := 0; i < v.NumField(); i++ {
+			fill(v.Field(i))
+		}
+	case reflect.Array:
+		for i := 0; i < v.Len(); i++ {
+			fill(v.Index(i))
+		}
+	default:
+	}
+}
+
+// Track's answers, encoded in the contracts' own shapes (poolState's 57 words, execute's bytes around stairs()'s 71,
+// StateView's slot0), decode through the embedded ABIs exactly as ethrpc decodes them, and extraFrom keeps what the
+// fee rule reads.
+func TestTrack_DecodesTheContractsAnswers(t *testing.T) {
+	usdc := common.HexToAddress("0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913")
+	state := poolStateRPC{
+		PoolBound: true, TickSpacing: big.NewInt(60), FloorTick: big.NewInt(-1200),
+		SkimBuyFarBps: big.NewInt(200), SkimSellFarBps: big.NewInt(200), SkimSellAtFloorBps: big.NewInt(300),
+		CreatorBuyBps: big.NewInt(75), CreatorSellBps: big.NewInt(75), HolderSellBps: big.NewInt(10),
+		TeamFeeBps: big.NewInt(25), QuoteToken: usdc, QuoteIsCurrency1: true,
+	}
+	state.PoolKey.Currency0, state.PoolKey.Currency1 = common.HexToAddress("0x1111111111111111111111111111111111111111"), usdc
+	fill(reflect.ValueOf(&state).Elem())
+	stairs := stairsRPC{CushionLower: big.NewInt(-1860), CushionLiq: big.NewInt(42)}
+	stairs.Step[3].Cheap = big.NewInt(-7)
+	fill(reflect.ValueOf(&stairs).Elem())
+
+	stateData, err := hookABI.Methods["poolState"].Outputs.Pack(state)
+	require.NoError(t, err)
+	assert.Len(t, stateData, 57*32)
+	stairsData, err := poolViewsABI.Methods["stairs"].Outputs.Pack(stairs)
+	require.NoError(t, err)
+	assert.Len(t, stairsData, 71*32)
+	executeData, err := hookABI.Methods["execute"].Outputs.Pack(stairsData)
+	require.NoError(t, err)
+	slot0Data, err := stateViewABI.Methods["getSlot0"].Outputs.Pack(big.NewInt(1), big.NewInt(-5), big.NewInt(1000|300<<12),
+		big.NewInt(0))
+	require.NoError(t, err)
+
+	var gotState poolStateResp
+	require.NoError(t, hookABI.UnpackIntoInterface(&gotState, "poolState", stateData))
+	var raw []byte
+	require.NoError(t, hookABI.UnpackIntoInterface(&raw, "execute", executeData))
+	var gotStairs stairsResp
+	require.NoError(t, unpackStairs(raw, &gotStairs))
+	var slot0 slot0RPC
+	require.NoError(t, stateViewABI.UnpackIntoInterface(&slot0, "getSlot0", slot0Data))
+	assert.Equal(t, jsonOf(t, state), jsonOf(t, gotState.PoolState))
+	assert.Equal(t, jsonOf(t, stairs), jsonOf(t, gotStairs.Stairs))
+
+	extra, err := extraFrom(&gotState.PoolState, &gotStairs.Stairs, &slot0)
+	require.NoError(t, err)
+	assert.Equal(t, Extra{
+		TickSpacing: 60, QuoteIsCurrency1: true, FloorTick: -1200,
+		Rates:        Rates{SkimBuyFar: 200, SkimSellFar: 200, SkimSellAtFloor: 300, CreatorBuy: 75, CreatorSell: 75, HolderSell: 10, TeamFee: 25},
+		CushionLower: -1860, HasCushion: true, ProtocolFee: 1000 | 300<<12,
+	}, extra)
+
+	assert.ErrorIs(t, unpackStairs(stairsData[:10*32], &gotStairs), ErrInvalidStairs)
+}
+
+func jsonOf(t *testing.T, v any) string {
+	t.Helper()
+	b, err := json.Marshal(v)
+	require.NoError(t, err)
+	return string(b)
+}
+
+func TestExtraFrom_Refusals(t *testing.T) {
+	usdc := common.HexToAddress("0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913")
+	base := func() (poolStateRPC, stairsRPC, slot0RPC) {
+		s := poolStateRPC{PoolBound: true, TickSpacing: big.NewInt(60), FloorTick: big.NewInt(1200), QuoteToken: usdc,
+			SkimBuyFarBps: big.NewInt(200), SkimSellFarBps: big.NewInt(200), SkimSellAtFloorBps: big.NewInt(300),
+			TeamFeeBps: big.NewInt(25)}
+		s.PoolKey.Currency0 = usdc
+		fill(reflect.ValueOf(&s).Elem())
+		st := stairsRPC{}
+		fill(reflect.ValueOf(&st).Elem())
+		return s, st, slot0RPC{ProtocolFee: new(big.Int)}
+	}
+
+	s, st, s0 := base()
+	_, err := extraFrom(&s, &st, &s0)
+	require.NoError(t, err)
+
+	// a pool whose launch has not graduated is kept untracked, not refused
+	s.PoolBound = false
+	extra, err := extraFrom(&s, &st, &s0)
+	require.NoError(t, err)
+	assert.Equal(t, Extra{}, extra)
+
+	for name, mutate := range map[string]func(*poolStateRPC, *stairsRPC, *slot0RPC){
+		"no spacing":            func(s *poolStateRPC, _ *stairsRPC, _ *slot0RPC) { s.TickSpacing.SetInt64(0) },
+		"floor tick past int24": func(s *poolStateRPC, _ *stairsRPC, _ *slot0RPC) { s.FloorTick.SetInt64(1 << 23) },
+		"protocol fee past 24 bits": func(_ *poolStateRPC, _ *stairsRPC, s0 *slot0RPC) {
+			s0.ProtocolFee.SetInt64(1 << 24)
+		},
+		"orientation": func(s *poolStateRPC, _ *stairsRPC, _ *slot0RPC) { s.QuoteIsCurrency1 = true },
+		"rate past 100%": func(s *poolStateRPC, _ *stairsRPC, _ *slot0RPC) {
+			s.CreatorSellBps.SetInt64(10_001)
+		},
+		"platform fee past its cap": func(s *poolStateRPC, _ *stairsRPC, _ *slot0RPC) { s.TeamFeeBps.SetInt64(51) },
+		"sell takes sum to 100%": func(s *poolStateRPC, _ *stairsRPC, _ *slot0RPC) {
+			s.CreatorSellBps.SetInt64(5_000)
+			s.HolderSellBps.SetInt64(4_675)
+		},
+	} {
+		s, st, s0 := base()
+		mutate(&s, &st, &s0)
+		_, err := extraFrom(&s, &st, &s0)
+		assert.Error(t, err, name)
+	}
+}
diff --git a/pkg/liquidity-source/uniswap/v4/hooks/floor/math.go b/pkg/liquidity-source/uniswap/v4/hooks/floor/math.go
new file mode 100644
index 0000000..5869798
--- /dev/null
+++ b/pkg/liquidity-source/uniswap/v4/hooks/floor/math.go
@@ -0,0 +1,101 @@
+package floor
+
+import (
+	"github.com/holiman/uint256"
+
+	uniswapv4 "github.com/KyberNetwork/kyberswap-dex-lib/pkg/liquidity-source/uniswap/v4"
+)
+
+// bandTicks mirrors SingletonFloorEngine._bandTicks: BID_BAND_TICKS rounded up to the pool's spacing (120 at 60).
+func bandTicks(tickSpacing int) int {
+	return (bidBandTicks + tickSpacing - 1) / tickSpacing * tickSpacing
+}
+
+// marketTick mirrors SingletonFloorEngine._market: the pool's raw tick in the engine frame. A quote at currency1 maps
+// to -tick - 1 (not -tick).
+func marketTick(rawTick int, quoteIsCurrency1 bool) int {
+	if quoteIsCurrency1 {
+		return -rawTick - 1
+	}
+	return rawTick
+}
+
+// skimBpsAt mirrors FloorHookMath.skimBps: the skim in bps at distance ticks from the bid band's dear edge
+// (dearEdge - current, engine frame). A buy ramps from its at-floor rate at the band to its far rate SKIM_RAMP_TICKS
+// away; a sell ramps from its at-floor rate down to its far rate, and is flat when its far rate is at or above its
+// at-floor rate.
+func skimBpsAt(isBuy bool, distance int, r *Rates) int {
+	closeness := 0
+	if distance <= 0 {
+		closeness = bpsDenominator
+	} else if distance < skimRampTicks {
+		closeness = bpsDenominator - distance*bpsDenominator/skimRampTicks
+	}
+	if isBuy {
+		far, at := int(r.SkimBuyFar), int(r.SkimBuyAtFloor)
+		if far >= at {
+			return far - (far-at)*closeness/bpsDenominator
+		}
+		return far + (at-far)*closeness/bpsDenominator
+	}
+	far, at := int(r.SkimSellFar), int(r.SkimSellAtFloor)
+	if far >= at {
+		return far
+	}
+	return far + (at-far)*closeness/bpsDenominator
+}
+
+// gapSkimBps mirrors SingletonFloorEngine._gapSkim (FloorPolicy.STAIR_GAP_SKIM = 2, the linear ramp): a buy's ramped
+// skim scaled by how far the price stands above the standing cushion's top, gap = cushionLower - current (engine
+// frame). Untouched at or under 2,232 ticks, 1.5x at and past 5,109, linear (floored) between; a scaled skim is
+// capped at 1,500 bps. No standing cushion: untouched.
+func gapSkimBps(bps int, hasCushion bool, cushionLower, current int) int {
+	if !hasCushion {
+		return bps
+	}
+	gap := cushionLower - current
+	var m int
+	if gap >= gapSkimTicks {
+		m = gapSkimMultBps
+	} else if gap > gapSkimFromTicks {
+		m = bpsDenominator + (gapSkimMultBps-bpsDenominator)*(gap-gapSkimFromTicks)/(gapSkimTicks-gapSkimFromTicks)
+	} else {
+		return bps
+	}
+	return min(bps*m/bpsDenominator, gapSkimMaxBps)
+}
+
+// hookTakes mirrors SingletonFloorEngine._takeFees: skim, creator fee, holder tax and platform fee, each
+// leg * bps / 10,000 rounded down, summed.
+func hookTakes(isBuy bool, leg *uint256.Int, skimBps int, r *Rates) (*uint256.Int, error) {
+	creator, holder := r.CreatorSell, r.HolderSell
+	if isBuy {
+		creator, holder = r.CreatorBuy, r.HolderBuy
+	}
+	var total, part, bps uint256.Int
+	for _, rate := range [4]uint64{uint64(skimBps), uint64(creator), uint64(holder), uint64(r.TeamFee)} {
+		if rate == 0 {
+			continue
+		}
+		bps.SetUint64(rate)
+		if _, overflow := part.MulOverflow(leg, &bps); overflow {
+			return nil, ErrFeeOverflow
+		}
+		part.Div(&part, uint256.NewInt(bpsDenominator))
+		total.Add(&total, &part)
+	}
+	return &total, nil
+}
+
+// swapFee is the fee the swap is charged in pips: the hook's LP fee override composed with the PoolManager's
+// protocol fee for the direction, as ProtocolFeeLibrary.calculateSwapFee does.
+func swapFee(protocolFee uint32, zeroForOne bool) uniswapv4.FeeAmount {
+	pf := protocolFee & 0xfff
+	if !zeroForOne {
+		pf = protocolFee >> 12 & 0xfff
+	}
+	if pf == 0 {
+		return lpFeePips
+	}
+	return uniswapv4.FeeAmount(pf + lpFeePips - pf*lpFeePips/uint32(uniswapv4.FeeMax))
+}
diff --git a/pkg/liquidity-source/uniswap/v4/hooks/floor/math_test.go b/pkg/liquidity-source/uniswap/v4/hooks/floor/math_test.go
new file mode 100644
index 0000000..9375efa
--- /dev/null
+++ b/pkg/liquidity-source/uniswap/v4/hooks/floor/math_test.go
@@ -0,0 +1,105 @@
+package floor
+
+import (
+	"testing"
+
+	"github.com/holiman/uint256"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	uniswapv4 "github.com/KyberNetwork/kyberswap-dex-lib/pkg/liquidity-source/uniswap/v4"
+)
+
+var testRates = Rates{
+	SkimBuyFar: 100, SkimSellFar: 100, SkimBuyAtFloor: 0, SkimSellAtFloor: 500,
+	CreatorBuy: 50, CreatorSell: 75, HolderBuy: 25, HolderSell: 0, TeamFee: 25,
+}
+
+func TestMarketTickAndBand(t *testing.T) {
+	assert.Equal(t, -5, marketTick(-5, false))
+	assert.Equal(t, 4, marketTick(-5, true), "a currency1 quote maps -tick - 1, not -tick")
+	assert.Equal(t, 120, bandTicks(60))
+	assert.Equal(t, 200, bandTicks(100))
+	assert.Equal(t, 120, bandTicks(1))
+}
+
+// skimBpsAt must be FloorHookMath.skimBps at its corners and in between.
+func TestSkimBpsAt(t *testing.T) {
+	// at or inside the dear edge: the at-floor rate; at or past the ramp: the far rate
+	assert.Equal(t, 0, skimBpsAt(true, 0, &testRates))
+	assert.Equal(t, 0, skimBpsAt(true, -50, &testRates))
+	assert.Equal(t, 100, skimBpsAt(true, skimRampTicks, &testRates))
+	assert.Equal(t, 500, skimBpsAt(false, 0, &testRates))
+	assert.Equal(t, 100, skimBpsAt(false, skimRampTicks+1, &testRates))
+	// half way: closeness 10,000 - floor(8,047 * 10,000 / 16,094) = 5,000
+	assert.Equal(t, 50, skimBpsAt(true, 8047, &testRates))
+	assert.Equal(t, 300, skimBpsAt(false, 8047, &testRates))
+	// one tick into the ramp: closeness 10,000 - floor(10,000 / 16,094) = 10,000, still the at-floor rate
+	assert.Equal(t, 0, skimBpsAt(true, 1, &testRates))
+	assert.Equal(t, 500, skimBpsAt(false, 1, &testRates))
+	// a sell whose far rate is at or above its at-floor rate does not ramp
+	flat := testRates
+	flat.SkimSellAtFloor = 100
+	assert.Equal(t, 100, skimBpsAt(false, 0, &flat))
+	// a buy whose at-floor rate is above its far rate ramps the other way
+	inverted := testRates
+	inverted.SkimBuyAtFloor = 300
+	assert.Equal(t, 300, skimBpsAt(true, 0, &inverted))
+	assert.Equal(t, 200, skimBpsAt(true, 8047, &inverted))
+	assert.Equal(t, 100, skimBpsAt(true, skimRampTicks, &inverted))
+}
+
+// gapSkimBps must be SingletonFloorEngine._gapSkim: 1x to 2,232 ticks, a linear ramp to 1.5x at 5,109, capped at
+// 1,500 bps.
+func TestGapSkimBps(t *testing.T) {
+	const top = 10_000
+	at := func(bps, gap int) int { return gapSkimBps(bps, true, top, top-gap) }
+
+	// at and under 2,232 ticks: untouched, not even capped
+	for _, gap := range []int{-500, 0, 2_232} {
+		assert.Equal(t, []int{75, 100, 1_000, 1_600}, []int{at(75, gap), at(100, gap), at(1_000, gap), at(1_600, gap)})
+	}
+	// 2,233: m = 10,000 + floor(5,000 * 1 / 2,877) = 10,001, and a scaled skim is capped
+	assert.Equal(t, []int{1_000, 1_500}, []int{at(1_000, 2_233), at(1_600, 2_233)})
+	// half way, 3,670: m = 10,000 + floor(5,000 * 1,438 / 2,877) = 12,499
+	assert.Equal(t, []int{93, 124, 1_249}, []int{at(75, 3_670), at(100, 3_670), at(1_000, 3_670)})
+	// 5,108: m = 14,998; 5,109 and past: 15,000
+	assert.Equal(t, 1_499, at(1_000, 5_108))
+	for _, gap := range []int{5_109, 5_110, 20_000} {
+		assert.Equal(t, []int{112, 150, 1_500, 1_500}, []int{at(75, gap), at(100, gap), at(1_000, gap), at(1_001, gap)})
+	}
+	// no cushion standing: untouched, whatever its edge says; a zero ramp stays zero
+	assert.Equal(t, 1_000, gapSkimBps(1_000, false, top, top-20_000))
+	assert.Equal(t, 0, at(0, 20_000))
+}
+
+// hookTakes must be SingletonFloorEngine._takeFees: four rates off one leg, each rounded down, summed.
+func TestHookTakes(t *testing.T) {
+	total, err := hookTakes(true, uint256.NewInt(10_001), 100, &testRates)
+	require.NoError(t, err)
+	assert.Equal(t, uint64(100+50+25+25), total.Uint64())
+
+	// a sell takes the sell side's creator and holder rates
+	total, err = hookTakes(false, uint256.NewInt(10_001), 300, &testRates)
+	require.NoError(t, err)
+	assert.Equal(t, uint64(300+75+0+25), total.Uint64())
+
+	// each part rounds down on its own: 3 * floor(399 * 25 / 10,000) = 0, not floor(399 * 75 / 10,000) = 2
+	r := Rates{CreatorBuy: 25, HolderBuy: 25, TeamFee: 25}
+	total, err = hookTakes(true, uint256.NewInt(399), 0, &r)
+	require.NoError(t, err)
+	assert.Zero(t, total.Uint64())
+
+	_, err = hookTakes(true, new(uint256.Int).SetAllOne(), 1, &testRates)
+	assert.ErrorIs(t, err, ErrFeeOverflow)
+}
+
+// swapFee is the hook's 0.25% override composed with the PoolManager's protocol fee for the swap's direction, as
+// ProtocolFeeLibrary.calculateSwapFee: protocolFee + lpFee - protocolFee * lpFee / 1e6.
+func TestSwapFee(t *testing.T) {
+	assert.Equal(t, uniswapv4.FeeAmount(2_500), swapFee(0, true))
+	assert.Equal(t, uniswapv4.FeeAmount(2_500), swapFee(0, false))
+	const packed = 1_000 | 300<<12 // zeroForOne 0.1%, oneForZero 0.03%
+	assert.Equal(t, uniswapv4.FeeAmount(1_000+2_500-2), swapFee(packed, true))
+	assert.Equal(t, uniswapv4.FeeAmount(300+2_500-0), swapFee(packed, false))
+}
diff --git a/pkg/liquidity-source/uniswap/v4/hooks/floor/quoter_match_test.go b/pkg/liquidity-source/uniswap/v4/hooks/floor/quoter_match_test.go
new file mode 100644
index 0000000..5c44cfb
--- /dev/null
+++ b/pkg/liquidity-source/uniswap/v4/hooks/floor/quoter_match_test.go
@@ -0,0 +1,415 @@
+package floor
+
+import (
+	"math/big"
+	"os"
+	"path/filepath"
+	"slices"
+	"strconv"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/goccy/go-json"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/KyberNetwork/kyberswap-dex-lib/pkg/entity"
+	uniswapv3 "github.com/KyberNetwork/kyberswap-dex-lib/pkg/liquidity-source/uniswap/v3"
+	uniswapv4 "github.com/KyberNetwork/kyberswap-dex-lib/pkg/liquidity-source/uniswap/v4"
+	poolpkg "github.com/KyberNetwork/kyberswap-dex-lib/pkg/source/pool"
+	"github.com/KyberNetwork/kyberswap-dex-lib/pkg/valueobject"
+)
+
+// The simulator must agree with Uniswap's V4Quoter (Base 0x0d5e0F971ED27FBfF6c2837bf31316121532048D, which runs the
+// real SingletonFloorHook through PoolManager.unlock) to the wei. Each testdata file is one Cook launch created,
+// sold out and graduated on a fork of Base, read at six pool states (fresh, after a 3 ETH buy, after a ratchet, after
+// a big buy above the cushion, after selling half the bag, after a deep sell into the bid): the PoolManager's slot0,
+// liquidity, every tick bitmap word and every initialised tick's liquidityNet (StateView), the hook's poolState(id)
+// and stairs(), and the quoter's answer for 15 buy and sell sizes (null: the quoter reverted). Three layouts: native
+// ETH at currency0, USDC at currency0, USDC at currency1. 270 quotes in all.
+// Pure fixtures, no network: these run in CI.
+
+const (
+	hookAddr = "0xe44886ffe0a894c6c5900d77a51c7d49732c60cc"
+	baseWETH = "0x4200000000000000000000000000000000000006"
+	// The launch token's address is not part of the snapshot and plays no part in pricing; these stand in for it,
+	// on the side of the quote the pool key puts it.
+	tokenBelowQuote = "0x1111111111111111111111111111111111111111"
+	tokenAboveQuote = "0xf111111111111111111111111111111111111111"
+)
+
+type pair struct {
+	K int
+	V string
+}
+
+func (p *pair) UnmarshalJSON(b []byte) error {
+	var raw [2]json.RawMessage
+	if err := json.Unmarshal(b, &raw); err != nil {
+		return err
+	}
+	if err := json.Unmarshal(raw[0], &p.K); err != nil {
+		return err
+	}
+	return json.Unmarshal(raw[1], &p.V)
+}
+
+type snapshot struct {
+	Pool struct {
+		SqrtPriceX96 string `json:"sqrtPriceX96"`
+		Tick         int    `json:"tick"`
+		Liquidity    string `json:"liquidity"`
+		TickSpacing  int    `json:"tickSpacing"`
+		ProtocolFee  uint32 `json:"protocolFee"`
+		Bitmap       []pair `json:"bitmap"`
+		LiquidityNet []pair `json:"liquidityNet"`
+	} `json:"pool"`
+	QuoteIsCurrency1 bool `json:"quoteIsCurrency1"`
+	FloorTick        int  `json:"floorTick"`
+	Rates            struct {
+		SkimBuyFarBps, SkimSellFarBps, SkimBuyAtFloorBps, SkimSellAtFloorBps   int64
+		CreatorBuyBps, CreatorSellBps, HolderBuyBps, HolderSellBps, TeamFeeBps int64
+	} `json:"rates"`
+	Cushion struct {
+		CushionLower int    `json:"cushionLower"`
+		CushionLiq   string `json:"cushionLiq"`
+	} `json:"cushion"`
+	GapSkim bool `json:"gapSkim"`
+}
+
+type expectedQuote struct {
+	Side      string  `json:"side"`
+	AmountIn  string  `json:"amountIn"`
+	AmountOut *string `json:"amountOut"`
+}
+
+type fixtureCase struct {
+	State    string          `json:"state"`
+	Block    string          `json:"block"`
+	PoolID   string          `json:"poolId"`
+	Snapshot snapshot        `json:"snapshot"`
+	Expected []expectedQuote `json:"expected"`
+}
+
+type fixture struct {
+	ChainID int           `json:"chainId"`
+	Label   string        `json:"label"`
+	Quote   string        `json:"quote"`
+	Cases   []fixtureCase `json:"cases"`
+}
+
+func loadFixtures(t *testing.T) []fixture {
+	t.Helper()
+	files, err := filepath.Glob("testdata/*.json")
+	require.NoError(t, err)
+	require.Len(t, files, 3)
+	fixtures := make([]fixture, 0, len(files))
+	for _, f := range files {
+		raw, err := os.ReadFile(f)
+		require.NoError(t, err)
+		var fx fixture
+		require.NoError(t, json.Unmarshal(raw, &fx))
+		fixtures = append(fixtures, fx)
+	}
+	return fixtures
+}
+
+func bi(t *testing.T, s string) *big.Int {
+	t.Helper()
+	v, ok := new(big.Int).SetString(s, 10)
+	require.True(t, ok, s)
+	return v
+}
+
+// hookExtraOf runs the snapshot's poolState and stairs answers through extraFrom, the same conversion Track makes.
+func hookExtraOf(t *testing.T, s *snapshot, quote string) Extra {
+	t.Helper()
+	require.True(t, s.GapSkim, "every FLOOR set on the five chains carries the gap buy skim")
+	state := poolStateRPC{
+		PoolBound:          true,
+		TickSpacing:        big.NewInt(int64(s.Pool.TickSpacing)),
+		FloorTick:          big.NewInt(int64(s.FloorTick)),
+		SkimBuyFarBps:      big.NewInt(s.Rates.SkimBuyFarBps),
+		SkimSellFarBps:     big.NewInt(s.Rates.SkimSellFarBps),
+		SkimBuyAtFloorBps:  big.NewInt(s.Rates.SkimBuyAtFloorBps),
+		SkimSellAtFloorBps: big.NewInt(s.Rates.SkimSellAtFloorBps),
+		CreatorBuyBps:      big.NewInt(s.Rates.CreatorBuyBps),
+		CreatorSellBps:     big.NewInt(s.Rates.CreatorSellBps),
+		HolderBuyBps:       big.NewInt(s.Rates.HolderBuyBps),
+		HolderSellBps:      big.NewInt(s.Rates.HolderSellBps),
+		TeamFeeBps:         big.NewInt(s.Rates.TeamFeeBps),
+		QuoteIsCurrency1:   s.QuoteIsCurrency1,
+	}
+	state.QuoteToken = common.HexToAddress(quote)
+	if s.QuoteIsCurrency1 {
+		state.PoolKey.Currency0, state.PoolKey.Currency1 = common.HexToAddress(tokenBelowQuote), state.QuoteToken
+	} else {
+		state.PoolKey.Currency0, state.PoolKey.Currency1 = state.QuoteToken, common.HexToAddress(tokenAboveQuote)
+	}
+	stairs := stairsRPC{CushionLower: big.NewInt(int64(s.Cushion.CushionLower)), CushionLiq: bi(t, s.Cushion.CushionLiq)}
+	extra, err := extraFrom(&state, &stairs, &slot0RPC{ProtocolFee: big.NewInt(int64(s.Pool.ProtocolFee))})
+	require.NoError(t, err)
+	return extra
+}
+
+// poolTokens returns the pool's two currencies in key order, the launch token and the quote as the simulator names
+// them (native ETH is WETH in the pool's token list, flagged native in StaticExtra).
+func poolTokens(fx *fixture, quoteIsCurrency1 bool) (tokens [2]string, token, quote string, nativeQuote bool) {
+	quote = fx.Quote
+	if nativeQuote = new(big.Int).SetBytes(common.HexToAddress(quote).Bytes()).Sign() == 0; nativeQuote {
+		quote = baseWETH
+	}
+	if quoteIsCurrency1 {
+		return [2]string{tokenBelowQuote, quote}, tokenBelowQuote, quote, nativeQuote
+	}
+	token = tokenAboveQuote
+	return [2]string{quote, token}, token, quote, nativeQuote
+}
+
+func newSim(t *testing.T, fx *fixture, c *fixtureCase) (sim *uniswapv4.PoolSimulator, token, quote string) {
+	t.Helper()
+	s := &c.Snapshot
+	tokens, token, quote, nativeQuote := poolTokens(fx, s.QuoteIsCurrency1)
+
+	// Every initialised tick is in the bitmap and has a liquidityNet entry, and nothing else.
+	var bitmapTicks []int
+	for _, w := range s.Pool.Bitmap {
+		word := bi(t, w.V)
+		for bit := 0; bit < 256; bit++ {
+			if word.Bit(bit) == 1 {
+				bitmapTicks = append(bitmapTicks, (w.K*256+bit)*s.Pool.TickSpacing)
+			}
+		}
+	}
+	ticks := make([]uniswapv4.Tick, 0, len(s.Pool.LiquidityNet))
+	netTicks := make([]int, 0, len(s.Pool.LiquidityNet))
+	for _, p := range s.Pool.LiquidityNet {
+		net := bi(t, p.V)
+		gross := new(big.Int).Abs(net) // the walk reads only liquidityNet; any non-zero gross marks the tick initialised
+		if gross.Sign() == 0 {
+			gross.SetInt64(1)
+		}
+		ticks = append(ticks, uniswapv4.Tick{Index: p.K, LiquidityGross: gross, LiquidityNet: net})
+		netTicks = append(netTicks, p.K)
+	}
+	slices.Sort(bitmapTicks)
+	require.Equal(t, bitmapTicks, netTicks, "bitmap and liquidityNet disagree")
+
+	hookExtra, err := json.Marshal(hookExtraOf(t, s, fx.Quote))
+	require.NoError(t, err)
+	extra, err := json.Marshal(uniswapv4.Extra{
+		Extra: &uniswapv3.Extra{
+			Liquidity:    bi(t, s.Pool.Liquidity),
+			SqrtPriceX96: bi(t, s.Pool.SqrtPriceX96),
+			TickSpacing:  uint64(s.Pool.TickSpacing),
+			Tick:         big.NewInt(int64(s.Pool.Tick)),
+			Ticks:        ticks,
+		},
+		HookExtra: hookExtra,
+	})
+	require.NoError(t, err)
+	staticExtra, err := json.Marshal(uniswapv4.StaticExtra{
+		IsNative:     [2]bool{nativeQuote, false},
+		Fee:          0x800000, // the dynamic-fee flag every FLOOR pool key carries
+		TickSpacing:  int32(s.Pool.TickSpacing),
+		HooksAddress: common.HexToAddress(hookAddr),
+	})
+	require.NoError(t, err)
+
+	sim, err = uniswapv4.NewPoolSimulator(entity.Pool{
+		Address:  c.PoolID,
+		Exchange: string(valueobject.ExchangeUniswapV4Floor),
+		Type:     uniswapv4.DexType,
+		Tokens:   []*entity.PoolToken{{Address: tokens[0], Swappable: true}, {Address: tokens[1], Swappable: true}},
+		// reserves only cap swap sizes in the simulator; the pool's real balances sit in the PoolManager
+		Reserves:    entity.PoolReserves{"1" + zeros(45), "1" + zeros(45)},
+		StaticExtra: string(staticExtra),
+		Extra:       string(extra),
+		BlockNumber: mustUint(t, c.Block),
+	}, valueobject.ChainID(fx.ChainID))
+	require.NoError(t, err)
+	return sim, token, quote
+}
+
+func zeros(n int) string {
+	b := make([]byte, n)
+	for i := range b {
+		b[i] = '0'
+	}
+	return string(b)
+}
+
+func mustUint(t *testing.T, s string) uint64 {
+	t.Helper()
+	v, err := strconv.ParseUint(s, 10, 64)
+	require.NoError(t, err)
+	return v
+}
+
+func quoteOf(sim *uniswapv4.PoolSimulator, e *expectedQuote, token, quote string, amountIn *big.Int,
+) (*poolpkg.CalcAmountOutResult, error) {
+	tokenIn, tokenOut := quote, token
+	if e.Side == "sell" {
+		tokenIn, tokenOut = token, quote
+	}
+	return sim.CalcAmountOut(poolpkg.CalcAmountOutParams{
+		TokenAmountIn: poolpkg.TokenAmount{Token: tokenIn, Amount: amountIn},
+		TokenOut:      tokenOut,
+	})
+}
+
+// checkCase asserts every quote of a state; zero is what the quoter answers for a dust buy the fees eat whole, and a
+// zero-output quote is an error here, as for every source. It returns how many quotes matched an amount, how many
+// were refused as the quoter refused them, and how many were dust.
+func checkCase(t *testing.T, sim *uniswapv4.PoolSimulator, c *fixtureCase, token, quote string) (matched, refused, dust int) {
+	t.Helper()
+	for i := range c.Expected {
+		e := &c.Expected[i]
+		res, err := quoteOf(sim, e, token, quote, bi(t, e.AmountIn))
+		switch {
+		case e.AmountOut == nil:
+			assert.Error(t, err, "%s %s: the quoter reverted", e.Side, e.AmountIn)
+			refused++
+		case *e.AmountOut == "0":
+			if err == nil {
+				assert.Zero(t, res.TokenAmountOut.Amount.Sign(), "%s %s", e.Side, e.AmountIn)
+			}
+			dust++
+		default:
+			if assert.NoError(t, err, "%s %s", e.Side, e.AmountIn) {
+				assert.Equal(t, *e.AmountOut, res.TokenAmountOut.Amount.String(), "%s %s", e.Side, e.AmountIn)
+				assert.Zero(t, res.RemainingTokenAmountIn.Amount.Sign())
+				matched++
+			}
+		}
+	}
+	return
+}
+
+func TestQuoterMatch_Fixtures(t *testing.T) {
+	var matched, refused, dust int
+	for _, fx := range loadFixtures(t) {
+		for i := range fx.Cases {
+			c := &fx.Cases[i]
+			t.Run(fx.Label+"/"+c.State, func(t *testing.T) {
+				sim, token, quote := newSim(t, &fx, c)
+				m, r, d := checkCase(t, sim, c, token, quote)
+				matched, refused, dust = matched+m, refused+r, dust+d
+			})
+		}
+	}
+	t.Logf("quotes: %d matched to the wei, %d refused as the quoter refused, %d dust (quoter 0)", matched, refused, dust)
+	assert.Equal(t, 270, matched+refused+dust)
+	assert.Equal(t, 2, refused)
+}
+
+// The two buys between recorded states change only the price: no ratchet runs and no position moves. Swapping the
+// same amount on the earlier state's simulator and applying it with UpdateBalance must land on the later state's
+// price, tick and liquidity, and quote every one of the later state's sizes exactly -- the hook's own view of the
+// tick, which the next buy's skim reads, moves with the pool.
+func TestQuoterMatch_BuysAppliedWithUpdateBalance(t *testing.T) {
+	for _, fx := range loadFixtures(t) {
+		for _, step := range []struct {
+			from, to         string
+			native, erc20Buy string
+		}{
+			{"fresh", "after 3 ETH buy", "3000000000000000000", "3000000000"},
+			{"after a ratchet", "after a big buy above the cushion", "12000000000000000000", "12000000000"},
+		} {
+			t.Run(fx.Label+"/"+step.to, func(t *testing.T) {
+				from, to := caseNamed(t, &fx, step.from), caseNamed(t, &fx, step.to)
+				require.Equal(t, from.Snapshot.Pool.LiquidityNet, to.Snapshot.Pool.LiquidityNet)
+				require.Equal(t, hookExtraOf(t, &from.Snapshot, fx.Quote), hookExtraOf(t, &to.Snapshot, fx.Quote))
+
+				sim, token, quote := newSim(t, &fx, from)
+				amount := step.erc20Buy
+				if _, _, _, native := poolTokens(&fx, from.Snapshot.QuoteIsCurrency1); native {
+					amount = step.native
+				}
+				amountIn := bi(t, amount)
+				res, err := quoteOf(sim, &expectedQuote{Side: "buy"}, token, quote, amountIn)
+				require.NoError(t, err)
+				sim.UpdateBalance(poolpkg.UpdateBalanceParams{
+					TokenAmountIn:  poolpkg.TokenAmount{Token: quote, Amount: amountIn},
+					TokenAmountOut: *res.TokenAmountOut,
+					SwapInfo:       res.SwapInfo,
+				})
+
+				assert.Equal(t, to.Snapshot.Pool.SqrtPriceX96, sim.V3Pool.SqrtRatioX96.Dec())
+				assert.Equal(t, to.Snapshot.Pool.Tick, sim.V3Pool.TickCurrent)
+				assert.Equal(t, to.Snapshot.Pool.Liquidity, sim.V3Pool.Liquidity.Dec())
+				m, r, d := checkCase(t, sim, to, token, quote)
+				assert.Equal(t, len(to.Expected), m+r+d)
+			})
+		}
+	}
+}
+
+// A sell that reaches the bid band makes the hook re-place its bid inside the swap. Its own quote is exact (the
+// fixtures' sells after "selling half the bag" are such sells), but the simulated pool no longer describes the real
+// one, so once it is applied the pool refuses every quote until it is tracked again. A sell that stays above the
+// band leaves the pool quotable.
+func TestQuoterMatch_SellIntoTheBandStopsQuoting(t *testing.T) {
+	sellInfo := func(t *testing.T, c *fixtureCase, sim *uniswapv4.PoolSimulator, token, quote string, e *expectedQuote,
+	) (*poolpkg.CalcAmountOutResult, *SwapInfo) {
+		res, err := quoteOf(sim, e, token, quote, bi(t, e.AmountIn))
+		require.NoError(t, err)
+		assert.Equal(t, *e.AmountOut, res.TokenAmountOut.Amount.String())
+		info := res.SwapInfo.(uniswapv4.SwapInfo).HookSwapInfo.(*SwapInfo)
+		dearEdge := c.Snapshot.FloorTick - bandTicks(c.Snapshot.Pool.TickSpacing)
+		assert.Equal(t, marketTick(info.Tick, c.Snapshot.QuoteIsCurrency1) >= dearEdge, info.BandReached)
+		return res, info
+	}
+	largestSell := func(c *fixtureCase) *expectedQuote {
+		var largest *expectedQuote
+		for i := range c.Expected {
+			if e := &c.Expected[i]; e.Side == "sell" && e.AmountOut != nil {
+				largest = e
+			}
+		}
+		return largest
+	}
+	apply := func(sim *uniswapv4.PoolSimulator, token string, e *expectedQuote, res *poolpkg.CalcAmountOutResult) {
+		amountIn, _ := new(big.Int).SetString(e.AmountIn, 10)
+		sim.UpdateBalance(poolpkg.UpdateBalanceParams{
+			TokenAmountIn:  poolpkg.TokenAmount{Token: token, Amount: amountIn},
+			TokenAmountOut: *res.TokenAmountOut,
+			SwapInfo:       res.SwapInfo,
+		})
+	}
+
+	for _, fx := range loadFixtures(t) {
+		t.Run(fx.Label, func(t *testing.T) {
+			c := caseNamed(t, &fx, "after a big buy above the cushion")
+			sim, token, quote := newSim(t, &fx, c)
+			e := largestSell(c)
+			res, info := sellInfo(t, c, sim, token, quote, e)
+			require.False(t, info.BandReached)
+			apply(sim, token, e, res)
+			_, err := quoteOf(sim, &expectedQuote{Side: "buy"}, token, quote, big.NewInt(1_000_000))
+			require.NoError(t, err)
+
+			c = caseNamed(t, &fx, "after selling half the bag")
+			sim, token, quote = newSim(t, &fx, c)
+			e = largestSell(c)
+			res, info = sellInfo(t, c, sim, token, quote, e)
+			require.True(t, info.BandReached)
+			apply(sim, token, e, res)
+			for _, side := range []string{"buy", "sell"} {
+				_, err = quoteOf(sim, &expectedQuote{Side: side}, token, quote, big.NewInt(1_000_000))
+				assert.ErrorIs(t, err, ErrBidReplacePending, side)
+			}
+		})
+	}
+}
+
+func caseNamed(t *testing.T, fx *fixture, state string) *fixtureCase {
+	t.Helper()
+	for i := range fx.Cases {
+		if fx.Cases[i].State == state {
+			return &fx.Cases[i]
+		}
+	}
+	t.Fatalf("%s: no state %q", fx.Label, state)
+	return nil
+}
