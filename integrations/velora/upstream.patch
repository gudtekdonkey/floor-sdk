@@ -0,0 +1,131 @@
+/* eslint-disable no-console */
+// npx jest src/dex/uniswap-v4/hooks/floor/floor-hook-events.test.ts
+import dotenv from 'dotenv';
+dotenv.config();
+
+import { Network } from '../../../../constants';
+import { DummyDexHelper } from '../../../../dex-helper';
+import { testEventSubscriber } from '../../../../../tests/utils-events';
+import { UniswapV4Config } from '../../config';
+import { PoolState } from '../../types';
+import { UniswapV4Pool } from '../../uniswap-v4-pool';
+import { FloorHook } from './floor-hook';
+import { FloorHookStateSubscriber } from './floor-hook-state';
+import { FloorHookState } from './types';
+
+jest.setTimeout(500 * 1000);
+
+const dexKey = 'FloorHook';
+
+// eventName -> blockNumbers
+type EventMappings = Record<string, number[]>;
+
+async function fetchHookState(
+  subscriber: FloorHookStateSubscriber,
+  blockNumber: number,
+): Promise<FloorHookState> {
+  const state = await subscriber.generateState(blockNumber);
+  return { pools: { ...state.pools } } as FloorHookState;
+}
+
+describe('FloorHook events', () => {
+  describe('BSC', () => {
+    const network = Network.BSC;
+    const poolId =
+      '0x5259c52ce22be9d859d73e8b29bed5d316053fe4b9afab637d986812041d89ff';
+
+    const eventsToTest: EventMappings = {
+      // the hook registers the pool (no state before it)
+      PoolRegistered: [127476136],
+      // graduation: Initialize, Seeded, LadderSeeded, StairsPlaced,
+      // Ratcheted and the PoolManager's ModifyLiquidity in one block
+      // later ratchets: StairsCollected, ReserveSplit, CushionPlaced too
+      Ratcheted: [127476189, 127478515, 127478582, 127478583],
+      // swaps and other hook events do not move the pool's pricing state
+      Swap: [127478455, 127478467],
+      Unrelated: [127476247],
+    };
+
+    Object.entries(eventsToTest).forEach(([eventName, blockNumbers]) => {
+      describe(eventName, () => {
+        blockNumbers.forEach(blockNumber => {
+          it(`State after ${blockNumber}`, async () => {
+            const dexHelper = new DummyDexHelper(network);
+            const logger = dexHelper.getLogger(dexKey);
+            const subscriber = new FloorHookStateSubscriber(
+              dexKey,
+              network,
+              dexHelper,
+              logger,
+            );
+            subscriber.addPoolId(poolId);
+
+            await testEventSubscriber(
+              subscriber,
+              subscriber.addressesSubscribed,
+              (_blockNumber: number) =>
+                fetchHookState(subscriber, _blockNumber),
+              blockNumber,
+              `${dexKey}_${poolId}`,
+              dexHelper.provider,
+            );
+          });
+        });
+      });
+    });
+
+    // the FLOOR pool's own v4 state: the hook overrides the LP fee on every
+    // swap of this dynamic-fee pool, and ratchets move its positions
+    describe('UniswapV4Pool BNB / FLOOR launch', () => {
+      const poolEvents: EventMappings = {
+        Swap: [
+          127478455, // buy
+          127478459, // buy
+          127478467, // sell
+          127478504, // sell
+          127478531, // buy
+          127478882, // sell
+        ],
+        ModifyLiquidity: [127478515, 127478582, 127478583],
+      };
+
+      Object.entries(poolEvents).forEach(([eventName, blockNumbers]) => {
+        describe(eventName, () => {
+          blockNumbers.forEach(blockNumber => {
+            it(`State after ${blockNumber}`, async () => {
+              const dexHelper = new DummyDexHelper(network);
+              const logger = dexHelper.getLogger(dexKey);
+              const config = UniswapV4Config.UniswapV4[network];
+
+              const uniswapV4Pool = new UniswapV4Pool(
+                dexHelper,
+                'UniswapV4',
+                network,
+                config,
+                logger,
+                '',
+                poolId,
+                '0x0000000000000000000000000000000000000000',
+                '0x7935f6ecc173913ac06186d2892bfa73e2fbdb1d',
+                '8388608',
+                '0xe44886ffe0a894c6c5900d77a51c7d49732c60cc',
+                '60',
+                new FloorHook(dexHelper, network, logger),
+              );
+
+              await testEventSubscriber(
+                uniswapV4Pool,
+                uniswapV4Pool.addressesSubscribed,
+                (_blockNumber: number): Promise<PoolState> =>
+                  uniswapV4Pool.generateState(_blockNumber),
+                blockNumber,
+                `UniswapV4_${config.poolManager}_${poolId}`,
+                dexHelper.provider,
+              );
+            });
+          });
+        });
+      });
+    });
+  });
+});
diff --git a/src/dex/uniswap-v4/hooks/floor/floor-hook-integration.test.ts b/src/dex/uniswap-v4/hooks/floor/floor-hook-integration.test.ts
new file mode 100644
index 0000000..885c7f8
--- /dev/null
+++ b/src/dex/uniswap-v4/hooks/floor/floor-hook-integration.test.ts
@@ -0,0 +1,128 @@
+/* eslint-disable no-console */
+// npx jest src/dex/uniswap-v4/hooks/floor/floor-hook-integration.test.ts
+import dotenv from 'dotenv';
+dotenv.config();
+import { DummyDexHelper } from '../../../../dex-helper';
+import {
+  ETHER_ADDRESS,
+  Network,
+  NULL_ADDRESS,
+  SwapSide,
+} from '../../../../constants';
+import { Token } from '../../../../types';
+import { UniswapV4 } from '../../uniswap-v4';
+import { SubgraphPool } from '../../types';
+import { FloorHook } from './floor-hook';
+
+jest.setTimeout(500 * 1000);
+
+const dexKey = 'UniswapV4';
+
+// Compares the pool math plus the FLOOR hook against Uniswap's V4Quoter on
+// the live chain, on every FLOOR pool the registry lists (up to POOLS_TO_TEST)
+const POOLS_TO_TEST = 5;
+
+const AMOUNTS = [0n, 10n ** 12n, 10n ** 15n, 10n ** 17n, 10n ** 18n];
+
+function testNetwork(network: Network) {
+  describe(`FLOOR pools on ${network}`, () => {
+    const dexHelper = new DummyDexHelper(network);
+    let blockNumber: number;
+    let uniswapV4: UniswapV4;
+    let pools: SubgraphPool[] = [];
+
+    beforeAll(async () => {
+      blockNumber = await dexHelper.web3Provider.eth.getBlockNumber();
+      uniswapV4 = new UniswapV4(network, dexKey, dexHelper);
+      await uniswapV4.initializePricing(blockNumber);
+
+      const hook = new FloorHook(
+        dexHelper,
+        network,
+        dexHelper.getLogger(dexKey),
+      );
+      pools = (await hook.getPools(blockNumber)).slice(0, POOLS_TO_TEST);
+    });
+
+    it('lists FLOOR pools', () => {
+      expect(pools.length).toBeGreaterThan(0);
+    });
+
+    it('prices exact input both ways as the V4Quoter does', async () => {
+      for (const pool of pools) {
+        for (const zeroForOne of [true, false]) {
+          const srcAddress = zeroForOne
+            ? pool.token0.address
+            : pool.token1.address;
+          const destAddress = zeroForOne
+            ? pool.token1.address
+            : pool.token0.address;
+
+          const toToken = (address: string): Token => ({
+            address: address === NULL_ADDRESS ? ETHER_ADDRESS : address,
+            decimals: 18,
+          });
+
+          const prices = await uniswapV4.getPricesVolume(
+            toToken(srcAddress),
+            toToken(destAddress),
+            AMOUNTS,
+            SwapSide.SELL,
+            blockNumber,
+            [pool.id],
+          );
+
+          const onChain = await uniswapV4.queryPriceFromRpc(
+            zeroForOne,
+            AMOUNTS.slice(1),
+            {
+              id: pool.id,
+              key: {
+                currency0: pool.token0.address,
+                currency1: pool.token1.address,
+                fee: pool.fee,
+                tickSpacing: parseInt(pool.tickSpacing),
+                hooks: pool.hooks,
+              },
+            },
+            SwapSide.SELL,
+            blockNumber,
+          );
+
+          console.log(pool.id, zeroForOne, prices?.[0]?.prices, onChain);
+
+          if (onChain.every(amount => amount === 0n)) {
+            expect(prices).toEqual([]);
+            continue;
+          }
+
+          expect(prices![0].prices).toEqual([0n, ...onChain]);
+        }
+      }
+    });
+
+    it('does not price exact output', async () => {
+      for (const pool of pools) {
+        const prices = await uniswapV4.getPricesVolume(
+          {
+            address:
+              pool.token0.address === NULL_ADDRESS
+                ? ETHER_ADDRESS
+                : pool.token0.address,
+            decimals: 18,
+          },
+          { address: pool.token1.address, decimals: 18 },
+          AMOUNTS,
+          SwapSide.BUY,
+          blockNumber,
+          [pool.id],
+        );
+
+        expect(prices).toEqual([]);
+      }
+    });
+  });
+}
+
+testNetwork(Network.BASE);
+testNetwork(Network.BSC);
diff --git a/src/dex/uniswap-v4/hooks/floor/floor-hook-math.ts b/src/dex/uniswap-v4/hooks/floor/floor-hook-math.ts
