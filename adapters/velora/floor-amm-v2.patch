diff --git a/src/dex/floor-amm/floor-amm-pool.ts b/src/dex/floor-amm/floor-amm-pool.ts
new file mode 100644
index 00000000..7660508a
--- /dev/null
+++ b/src/dex/floor-amm/floor-amm-pool.ts
@@ -0,0 +1,86 @@
+// One launch's state for the dex: its book, read from the `launchBook` and `launchFeeCurve` views at a block. The views
+// ARE the state, so there is no replay: any log of the launch (topic 1 = its id) re-reads the book at that log's block.
+
+import type { DeepReadonly } from 'ts-essentials';
+import type { BlockHeader, Log, Logger } from '../../types';
+import { StatefulEventSubscriber } from '../../stateful-event-subscriber';
+import type { IDexHelper } from '../../dex-helper/idex-helper';
+import { FN, OUT, calldata, decode, topicUint } from './abi';
+import type { AbiValue } from './evm/abi-coder';
+import { bookFromView } from './book';
+import type { LaunchMeta, PoolState } from './types';
+
+/** An `eth_call` at a block. */
+export type EthCall = (
+  to: string,
+  data: string,
+  blockNumber: number | 'latest',
+) => Promise<string>;
+
+/**
+ * `launchBook(id)` and `launchFeeCurve(id)` at one block, as the math's `Book` (≈ 17 KB of return data: an off-chain
+ * `eth_call`).
+ */
+export async function readState(
+  call: EthCall,
+  floorAmm: string,
+  id: bigint,
+  quoteDecimals: number,
+  blockNumber: number | 'latest',
+): Promise<PoolState> {
+  const [bookOut, curveOut] = await Promise.all([
+    call(floorAmm, calldata(FN.launchBook, [id]), blockNumber),
+    call(floorAmm, calldata(FN.launchFeeCurve, [id]), blockNumber),
+  ]);
+  const [t] = decode(OUT.launchBook, bookOut) as AbiValue[][];
+  const [curve] = decode(OUT.launchFeeCurve, curveOut) as AbiValue[][];
+  return { book: bookFromView(t, curve), quoteDecimals };
+}
+
+export class FloorAmmEventPool extends StatefulEventSubscriber<PoolState> {
+  readonly floorAmm: string;
+  readonly meta: LaunchMeta;
+  readonly quoteDecimals: number;
+  private readonly call: EthCall;
+
+  constructor(
+    parentName: string,
+    dexHelper: IDexHelper,
+    floorAmm: string,
+    meta: LaunchMeta,
+    quoteDecimals: number,
+    logger: Logger,
+  ) {
+    super(parentName, `${floorAmm}_${meta.id}`, dexHelper, logger);
+    this.floorAmm = floorAmm;
+    this.meta = meta;
+    this.quoteDecimals = quoteDecimals;
+    this.addressesSubscribed = [floorAmm];
+    this.call = async (to, data, blockNumber) =>
+      dexHelper.provider.call({ to, data }, blockNumber);
+  }
+
+  async generateState(
+    blockNumber: number | 'latest' = 'latest',
+  ): Promise<DeepReadonly<PoolState>> {
+    return readState(
+      this.call,
+      this.floorAmm,
+      this.meta.id,
+      this.quoteDecimals,
+      blockNumber,
+    ) as Promise<DeepReadonly<PoolState>>;
+  }
+
+  /** A log of the proxy for this launch (topic 1 = its id) moves the book: read it again at the log's block. */
+  protected async processLog(
+    _state: DeepReadonly<PoolState>,
+    log: Readonly<Log>,
+    _blockHeader: Readonly<BlockHeader>,
+  ): Promise<DeepReadonly<PoolState> | null> {
+    if (log.address.toLowerCase() !== this.floorAmm.toLowerCase()) return null;
+    if (log.topics.length < 2 || topicUint(log.topics[1]) !== this.meta.id)
+      return null;
+    return this.generateState(log.blockNumber);
+  }
+}
diff --git a/src/dex/floor-amm/floor-amm-v2.test.ts b/src/dex/floor-amm/floor-amm-v2.test.ts
new file mode 100644
index 00000000..399c6753
--- /dev/null
+++ b/src/dex/floor-amm/floor-amm-v2.test.ts
@@ -0,0 +1,452 @@
+// The FloorAmm dex against the protocol's golden book walks (`testdata/book.json`, copied verbatim from its goldens):
+// every buy and sell priced by `amountOut` is the golden receipt's (a refund, a part fill or a refusal prices 0); the
+// `launchBook` and `launchFeeCurve` views decode to the golden book; and the dex on a mock chain prices, routes and sizes a launch.
+
+import { readFileSync } from 'fs';
+import { join } from 'path';
+import { BIDS_MAX, RANGES_MAX, emptyRange } from './math/v2/book';
+import type { Book, Range } from './math/v2/book';
+import { bytesToHex, encodeAbi, functionSelector } from './evm/abi-coder';
+import type { AbiValue } from './evm/abi-coder';
+import { FN, LAUNCH_CREATED_DATA, LAUNCH_CREATED_LISTED, OUT, TOPIC, decode } from './abi';
+import { GAS_FLAT, GAS_MAX, TOKEN_SCALE, amountOut, bookFromView, dexLiquidity, gasFor, walk } from './book';
+import { FloorAmm } from './floor-amm';
+import { ETHER_ADDRESS, Network, SwapSide } from '../../constants';
+
+type Row = Record<string, any>;
+interface Case {
+  id: string;
+  fn: string;
+  state_in?: Row;
+  args: Row;
+  out: Row;
+}
+
+const cases: Case[] = JSON.parse(
+  readFileSync(
+    join(process.cwd(), 'src/dex/floor-amm/testdata/book.json'),
+    'utf8',
+  ),
+).cases;
+
+const big = (v: unknown): bigint => BigInt(v as string);
+
+const rangeFrom = (r: Row): Range => ({
+  sqrtA: big(r.sqrt_a),
+  sqrtB: big(r.sqrt_b),
+  tokens: big(r.tokens),
+  askLeft: big(r.ask_left),
+  back: big(r.back),
+  place: big(r.place),
+  thetaBps: r.theta_bps,
+  psiBps: r.psi_bps,
+  kind: r.kind,
+  class: r.class,
+  msCapPpm: r.ms_cap_ppm ?? 0,
+});
+
+/** A golden book → the math's `Book`, ranges padded to the fixed 48, bands to the math's 24. */
+function bookFrom(b: Row): Book {
+  const ranges = (b.ranges as Row[]).map(rangeFrom);
+  while (ranges.length < RANGES_MAX) ranges.push(emptyRange());
+  return {
+    sqrtP: big(b.sqrt_p),
+    sqrtF: big(b.sqrt_f),
+    sqrtLMax: big(b.sqrt_l_max),
+    floor: big(b.floor),
+    floorTokens: big(b.floor_tokens),
+    nBands: b.n_bands,
+    nC: b.n_c,
+    bandEdge: (b.band_edge as string[]).slice(0, BIDS_MAX + 1).map(big),
+    bandMoney: (b.band_money as string[]).slice(0, BIDS_MAX).map(big),
+    bandTokens: (b.band_tokens as string[]).slice(0, BIDS_MAX).map(big),
+    bandF: (b.band_f as string[]).slice(0, BIDS_MAX).map(big),
+    bandFClaim: (b.band_f_claim as string[]).slice(0, BIDS_MAX).map(big),
+    ckAtF: big(b.ck_at_f),
+    ckFloorTokens: big(b.ck_floor_tokens),
+    feePpm: b.fee_ppm.map(Number),
+    feeStartPpm: (b.fee_start_ppm ?? [0, 0, 0, 0, 0]).map(Number),
+    sqrtFeeA: big(b.sqrt_fee_a ?? '0'),
+    sqrtFeeB: big(b.sqrt_fee_b ?? '0'),
+    graduated: b.graduated,
+    nRanges: b.n_ranges,
+    ranges,
+  };
+}
+
+/** The golden receipt's amount out as the dex prices it: 0 on a refund (but dust: ≤ 1 ppm of gross, no budget hit), a
+ * part fill or a refusal. */
+function goldenOut(c: Case): bigint {
+  if (c.out.err !== undefined) return 0n;
+  if (c.fn === 'buy') {
+    const refund = big(c.out.refund);
+    const dust = !c.out.budget_hit && refund * 1_000_000n <= big(c.args.gross);
+    return refund > 0n && !dust ? 0n : big(c.out.tokens) * TOKEN_SCALE;
+  }
+  return big(c.out.unfilled) > 0n ? 0n : big(c.out.out);
+}
+
+const walks = cases.filter(
+  c =>
+    (c.fn === 'buy' || c.fn === 'sell') &&
+    c.state_in !== undefined &&
+    big(c.fn === 'buy' ? c.args.min_tokens : c.args.min_out) === 0n,
+);
+
+/** The `launchBook` words of a book, as the contract returns them (24 band slots; the curve is `launchFeeCurve`'s). */
+function viewWords(b: Book): AbiValue[] {
+  const ranges: AbiValue[] = [];
+  for (let i = 0; i < RANGES_MAX; i++) {
+    const r = b.ranges[i];
+    ranges.push(
+      i < b.nRanges
+        ? [
+            r.sqrtA,
+            r.sqrtB,
+            r.tokens,
+            r.askLeft,
+            r.back,
+            r.place,
+            BigInt(r.thetaBps),
+            BigInt(r.psiBps),
+            BigInt(r.kind),
+            BigInt(r.class),
+          ]
+        : Array(10).fill(0n),
+    );
+  }
+  return [
+    [
+      b.sqrtP,
+      b.sqrtF,
+      b.floor,
+      [...b.bandMoney],
+      BigInt(b.nRanges),
+      ranges,
+      b.sqrtLMax,
+      b.floorTokens,
+      [...b.bandTokens],
+      [...b.bandEdge],
+      BigInt(b.nBands),
+      BigInt(b.nC),
+      [...b.bandF],
+      [...b.bandFClaim],
+      b.ckAtF,
+      b.ckFloorTokens,
+      b.graduated,
+      b.feePpm.map(BigInt),
+    ],
+  ];
+}
+
+/** The `launchFeeCurve` words of a book. */
+const curveWords = (b: Book): AbiValue[] => [
+  [b.feeStartPpm.map(BigInt), b.sqrtFeeA, b.sqrtFeeB],
+];
+
+/** A curve launch: its fees move with market cap (`sqrtFeeB` 0 = flat). */
+const hasCurve = (b: Book): boolean => b.sqrtFeeB !== 0n;
+
+/** The book the views give: all but the per-range Milestone cap, which the walk never reads. */
+const fromViews = (b: Book): Book => ({
+  ...b,
+  ranges: b.ranges.map(r => ({ ...r, msCapPpm: 0 })),
+});
+
+const pad32 = (a: string): string => '0x' + a.slice(2).padStart(64, '0');
+
+/** A `LaunchCreated` log of the proxy (indexed id, token, quote; `listed` in the data). */
+function launchLog(
+  amm: string,
+  id: bigint,
+  token: string,
+  quote: string,
+  listed: boolean,
+  blockNumber: number,
+): { address: string; topics: string[]; data: string; blockNumber: number } {
+  const values: AbiValue[] = LAUNCH_CREATED_DATA.map(ty =>
+    ty === 'bool' ? listed : ty === 'string' ? '' : ty === 'address' ? '0x' + '00'.repeat(20) : ty === 'bytes32' ? new Uint8Array(32) : 0n,
+  );
+  return {
+    address: amm,
+    topics: [TOPIC.LaunchCreated, pad32('0x' + id.toString(16)), pad32(token), pad32(quote)],
+    data: bytesToHex(encodeAbi(LAUNCH_CREATED_DATA, values)),
+    blockNumber,
+  };
+}
+
+describe('FloorAmm v2', () => {
+  it('prices every golden buy and sell as the golden receipt', () => {
+    let buys = 0;
+    let sells = 0;
+    let zero = 0;
+    for (const c of walks) {
+      const b = bookFrom(c.state_in!);
+      const amount =
+        c.fn === 'buy' ? big(c.args.gross) : big(c.args.tokens) * TOKEN_SCALE;
+      expect([c.id, amountOut(b, c.fn === 'buy', amount)]).toEqual([
+        c.id,
+        goldenOut(c),
+      ]);
+      if (goldenOut(c) === 0n) zero++;
+      else if (c.fn === 'buy') buys++;
+      else sells++;
+    }
+    expect(buys).toBeGreaterThan(10);
+    expect(sells).toBeGreaterThan(5);
+    expect(zero).toBeGreaterThan(0);
+  });
+
+  it('prices a sell of a non-whole math unit on its whole units, as sellFromBalance fills it', () => {
+    // `sellFromBalance` sells `free − free % 10¹²` and returns the rest to the recipient: the golden sell of `tokens`
+    let n = 0;
+    for (const c of walks) {
+      if (c.fn !== 'sell') continue;
+      const b = bookFrom(c.state_in!);
+      const whole = big(c.args.tokens) * TOKEN_SCALE;
+      for (const rest of [1n, 123_456_789n, TOKEN_SCALE - 1n]) {
+        expect([c.id, rest, amountOut(b, false, whole + rest)]).toEqual([
+          c.id,
+          rest,
+          goldenOut(c),
+        ]);
+        n++;
+      }
+    }
+    expect(n).toBeGreaterThan(15);
+    const c = walks.find(x => x.fn === 'sell' && goldenOut(x) > 0n)!;
+    expect(amountOut(bookFrom(c.state_in!), false, TOKEN_SCALE - 1n)).toBe(0n);
+  });
+
+  it('prices a full buy whose refund is dust at its tokens, as buyFromBalance fills it', () => {
+    const dust = walks.filter(
+      c =>
+        c.fn === 'buy' &&
+        c.out.err === undefined &&
+        big(c.out.refund) > 0n &&
+        !c.out.budget_hit &&
+        big(c.out.refund) * 1_000_000n <= big(c.args.gross),
+    );
+    expect(dust.length).toBeGreaterThan(4);
+    for (const c of dust)
+      expect([
+        c.id,
+        amountOut(bookFrom(c.state_in!), true, big(c.args.gross)),
+      ]).toEqual([c.id, big(c.out.tokens) * TOKEN_SCALE]);
+  });
+
+  it('decodes the launchBook and launchFeeCurve views to the golden book, its fee curve included', () => {
+    let n = 0;
+    let curves = 0;
+    for (const c of walks) {
+      const b = bookFrom(c.state_in!);
+      const raw = bytesToHex(encodeAbi(OUT.launchBook, viewWords(b)));
+      const [t] = decode(OUT.launchBook, raw) as AbiValue[][];
+      const rawCurve = bytesToHex(encodeAbi(OUT.launchFeeCurve, curveWords(b)));
+      const [curve] = decode(OUT.launchFeeCurve, rawCurve) as AbiValue[][];
+      const got = bookFromView(t, curve);
+      expect(got).toEqual(fromViews(b));
+      const amount =
+        c.fn === 'buy' ? big(c.args.gross) : big(c.args.tokens) * TOKEN_SCALE;
+      expect([c.id, amountOut(got, c.fn === 'buy', amount)]).toEqual([
+        c.id,
+        goldenOut(c),
+      ]);
+      n++;
+      if (hasCurve(b)) curves++;
+    }
+    expect(n).toBeGreaterThan(20);
+    expect(curves).toBeGreaterThan(5);
+  });
+
+  it('prices, routes and sizes a launch on a mock chain', async () => {
+    // a curve launch whose sell, priced at the curve's end rate (`launchBook.feePpm` alone), is not the golden one
+    const atEnd = (b: Book): Book => ({ ...b, sqrtFeeB: 0n });
+    const c = walks.find(
+      x =>
+        x.fn === 'sell' &&
+        goldenOut(x) > 0n &&
+        hasCurve(bookFrom(x.state_in!)) &&
+        amountOut(
+          atEnd(bookFrom(x.state_in!)),
+          false,
+          big(x.args.tokens) * TOKEN_SCALE,
+        ) !== goldenOut(x),
+    )!;
+    expect(c).toBeDefined();
+    const b = bookFrom(c.state_in!);
+    const amm = '0x00000000000000000000000000000000000000aa';
+    const token = '0x00000000000000000000000000000000000000bb';
+    const sel = (sig: string): string => bytesToHex(functionSelector(sig));
+    const word = (types: string[], v: AbiValue[]): string =>
+      bytesToHex(encodeAbi(types, v));
+    const answers: Record<string, string> = {
+      [sel(FN.launchBook)]: bytesToHex(
+        encodeAbi(OUT.launchBook, viewWords(b)),
+      ),
+      [sel(FN.launchFeeCurve)]: bytesToHex(
+        encodeAbi(OUT.launchFeeCurve, curveWords(b)),
+      ),
+    };
+    const usd: bigint[] = [];
+    const dexHelper: any = {
+      getLogger: () => ({
+        info() {},
+        warn() {},
+        error() {},
+        debug() {},
+        trace() {},
+      }),
+      provider: {
+        call: async (tx: { to: string; data: string }) =>
+          answers[tx.data.slice(0, 10)],
+        getLogs: async () => [
+          launchLog(amm, 1n, token, '0x0000000000000000000000000000000000000000', true, 50),
+        ],
+      },
+      blockManager: { subscribeToLogs() {} },
+      getTokenUSDPrice: async (_t: unknown, amount: bigint) => {
+        usd.push(amount);
+        return Number(amount);
+      },
+    };
+    const dex = new FloorAmm(Network.BASE, 'FloorAmm', dexHelper, {
+      floorAmm: amm,
+      maxLaunches: 10,
+    });
+    await dex.initializePricing(100);
+    const eth = { address: ETHER_ADDRESS, decimals: 18 };
+    const tok = { address: token, decimals: 18 };
+    const ids = await dex.getPoolIdentifiers(eth, tok, SwapSide.SELL, 100);
+    expect(ids).toEqual([`floorAmm_${amm}_1`.toLowerCase()]);
+    const tokensIn = big(c.args.tokens) * TOKEN_SCALE;
+    const prices = await dex.getPricesVolume(
+      tok,
+      eth,
+      [0n, tokensIn],
+      SwapSide.SELL,
+      100,
+    );
+    expect(prices![0].prices).toEqual([0n, goldenOut(c)]);
+    expect(prices![0].data.isBuy).toBe(false);
+    expect(
+      await dex.getPricesVolume(tok, eth, [tokensIn], SwapSide.BUY, 100),
+    ).toBeNull();
+    const p = dex.getDexParam(
+      ETHER_ADDRESS,
+      token,
+      '1000000000000000',
+      '1',
+      '0x00000000000000000000000000000000000000cc',
+      { ...prices![0].data, isBuy: true },
+      SwapSide.SELL,
+    );
+    expect(p.exchangeData.slice(0, 10)).toBe(sel(FN.buy));
+    expect(p.targetExchange).toBe(amm);
+    expect((p as any).transferSrcTokenBeforeSwap).toBe(undefined);
+    const sell = dex.getDexParam(
+      token,
+      ETHER_ADDRESS,
+      '1000000000000',
+      '1',
+      '0x00000000000000000000000000000000000000cc',
+      prices![0].data,
+      SwapSide.SELL,
+    );
+    expect(sell.exchangeData.slice(0, 10)).toBe(sel(FN.sellFromBalance));
+    expect((sell as any).transferSrcTokenBeforeSwap).toBe(amm);
+    const top = await dex.getTopPoolsForToken(token, 5);
+    expect(top.length).toBe(1);
+    expect(usd).toEqual([dexLiquidity(b)]);
+  });
+
+  /** A mock chain of several launches: the book of every id is the same golden book, their quotes are what each log says. */
+  async function chain(
+    metas: { id: bigint; token: string; quote: string; listed: boolean }[],
+    opts: { maxLaunches?: number; usd?: (quote: string, amount: bigint) => number; listedQuotes?: string[] } = {},
+  ) {
+    const c = walks.find(x => x.fn === 'buy' && goldenOut(x) > 0n)!;
+    const b = bookFrom(c.state_in!);
+    const amm = '0x00000000000000000000000000000000000000aa';
+    const sel = (sig: string): string => bytesToHex(functionSelector(sig));
+    const listedQuotes = opts.listedQuotes ?? [];
+    const calls: string[] = [];
+    const subs: any[] = [];
+    const dexHelper: any = {
+      getLogger: () => ({ info() {}, warn() {}, error() {}, debug() {}, trace() {} }),
+      provider: {
+        call: async (tx: { to: string; data: string }) => {
+          const s4 = tx.data.slice(0, 10);
+          calls.push(s4);
+          if (s4 === sel(FN.launchBook)) return bytesToHex(encodeAbi(OUT.launchBook, viewWords(b)));
+          if (s4 === sel(FN.launchFeeCurve)) return bytesToHex(encodeAbi(OUT.launchFeeCurve, curveWords(b)));
+          if (s4 === sel(FN.quoteEntry)) {
+            const q = '0x' + tx.data.slice(34, 74);
+            return bytesToHex(encodeAbi(OUT.quoteEntry, [[listedQuotes.includes(q), true, 18n, 0n, 1n, 0n, 1n]]));
+          }
+          throw new Error('unexpected call ' + s4);
+        },
+        getLogs: async () => metas.map((m, i) => launchLog(amm, m.id, m.token, m.quote, m.listed, 10 + i)),
+      },
+      blockManager: { subscribeToLogs: (s: any) => subs.push(s) },
+      getTokenUSDPrice: async (t: { address: string }, amount: bigint) => (opts.usd ? opts.usd(t.address, amount) : Number(amount)),
+    };
+    const dex = new FloorAmm(Network.BASE, 'FloorAmm', dexHelper, { floorAmm: amm, maxLaunches: opts.maxLaunches ?? 100, readBatch: 2 });
+    return { dex, amm, calls, subs, b };
+  }
+  const tokenN = (n: number): string => '0x' + n.toString(16).padStart(40, '0');
+  const NATIVE = '0x0000000000000000000000000000000000000000';
+
+  it('discovers launches from the LaunchCreated logs, whatever their number (no newest-N cut), listed from the log', async () => {
+    const metas = Array.from({ length: 7 }, (_, i) => ({ id: BigInt(i + 1), token: tokenN(0x100 + i), quote: NATIVE, listed: true }));
+    const { dex, calls } = await chain(metas, { maxLaunches: 100 });
+    await dex.initializePricing(200);
+    expect(dex.pools.size).toBe(7);
+    expect([...dex.pools.values()].every(p => p.meta.listed)).toBe(true);
+    expect(calls.includes(bytesToHex(functionSelector(FN.launchCount)).slice(0, 10))).toBe(false);
+  });
+
+  it('keeps the most liquid launches, not the newest, when there are more than maxLaunches', async () => {
+    const metas = [1, 2, 3].map(i => ({ id: BigInt(i), token: tokenN(0x200 + i), quote: i === 1 ? '0x00000000000000000000000000000000000000e1' : NATIVE, listed: true }));
+    // launch 1 (the oldest) is the most liquid in USD; launches 2 and 3 share a quote worth little
+    const { dex } = await chain(metas, { maxLaunches: 2, listedQuotes: ['0x00000000000000000000000000000000000000e1'], usd: (q, a) => (q === '0x00000000000000000000000000000000000000e1' ? Number(a) * 1000 : Number(a)) });
+    await dex.initializePricing(200);
+    expect(dex.pools.size).toBe(2);
+    expect(dex.pools.has(tokenN(0x201))).toBe(true);
+  });
+
+  it('adds a launch from its LaunchCreated log through the factory feed, and an unlisted-quote one when its quote is written', async () => {
+    const quote = '0x00000000000000000000000000000000000000e2';
+    const listedQuotes: string[] = [];
+    const { dex, amm } = await chain([], { listedQuotes });
+    await dex.initializePricing(200);
+    const feed = dex.feed!;
+    expect(feed.addressesSubscribed).toEqual([amm]);
+    await feed.processLogs([launchLog(amm, 9n, tokenN(0x300), NATIVE, true, 210), launchLog(amm, 10n, tokenN(0x301), quote, false, 211)]);
+    expect([...dex.pools.keys()]).toEqual([tokenN(0x300)]);
+    expect([...dex.pending.keys()]).toEqual([tokenN(0x301)]);
+    // the registry lists the quote: QuoteWritten re-checks the launch
+    await dex.onQuoteWritten(quote, 220);
+    expect(dex.pools.has(tokenN(0x301))).toBe(false); // written, still unlisted: stays pending
+    listedQuotes.push(quote);
+    await feed.processLogs([{ address: amm, topics: [TOPIC.QuoteWritten, pad32(quote)], data: '0x', blockNumber: 230 }]);
+    expect(dex.pools.has(tokenN(0x301))).toBe(true);
+    expect(dex.pending.size).toBe(0);
+  });
+
+  it('prices the gas of a hop from the walk: gasFor(side, steps), never under the measured flat figure', () => {
+    const c = walks.find(x => x.fn === 'buy' && goldenOut(x) > 0n)!;
+    const w = walk(bookFrom(c.state_in!), true, big(c.args.gross));
+    expect(w.amountOut).toBe(goldenOut(c));
+    expect(w.steps).toBe(c.out.steps);
+    for (const side of ['buy', 'sell'] as const) {
+      let last = 0;
+      for (const steps of [0, 1, 4, 5, 12, 10_000]) {
+        const g = gasFor(side, steps);
+        expect(g).toBeGreaterThanOrEqual(Math.max(GAS_FLAT[side], last));
+        expect(g).toBeLessThanOrEqual(GAS_MAX);
+        last = g;
+      }
+    }
+  });
+});
