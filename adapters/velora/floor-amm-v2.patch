+// FloorAmmV2's ABI as the dex reads it: the trade entry points, the launch lookups and the book views (`launchBook`,
+// `launchFeeCurve`). The words are `evm/sigs.ts` (printed from the program's interface); `evm/abi-coder.ts` codes them.
+
+import {
+  bytesToHex,
+  decodeAbi,
+  encodeCall,
+  eventTopic,
+  hexToBytes,
+} from './evm/abi-coder';
+import type { AbiValue } from './evm/abi-coder';
+import { EV } from './evm/sigs';
+
+export {
+  EV,
+  FN,
+  LAUNCH_CREATED_DATA,
+  LAUNCH_CREATED_LISTED,
+  OUT,
+} from './evm/sigs';
+
+/** No expiry: the router enforces its own deadline. */
+export const NO_DEADLINE = (1n << 256n) - 1n;
+
+export const TOPIC = {
+  LaunchCreated: eventTopic(EV.LaunchCreated),
+  /** The quote registry's `QuoteWritten(token indexed, enabled, createFee, usdCentsX64)`: a quote listed after a launch was
+   * created makes that launch routable. */
+  QuoteWritten: eventTopic(EV.QuoteWritten),
+};
+
+export const calldata = (sig: string, values: readonly AbiValue[]): string =>
+  bytesToHex(encodeCall(sig, values));
+export const decode = (types: readonly string[], hex: string): AbiValue[] =>
+  decodeAbi(types, hexToBytes(hex));
+export const topicUint = (t: string): bigint => BigInt(t);
+export const topicAddress = (t: string): string =>
+  `0x${t.slice(-40)}`.toLowerCase();
diff --git a/src/dex/floor-amm/book.ts b/src/dex/floor-amm/book.ts
new file mode 100644
index 00000000..61d23c94
--- /dev/null
+++ b/src/dex/floor-amm/book.ts
@@ -0,0 +1,165 @@
+// The `launchBook` view → the math's `Book`, the exact-in amount out, and the launch's liquidity. Every amount is the
+// program's own v2 book walk (`math/v2/trade.ts`), the same integers the contract runs.
+
+import { BIDS_MAX, RANGES_MAX, emptyRange } from './math/v2/book';
+import type { Book, Range } from './math/v2/book';
+import { quoteBookBuy, quoteBookSell } from './math/v2/trade';
+import type { AbiValue } from './evm/abi-coder';
+
+/** Chain units per math unit of a launch token (18 − 6 decimals). */
+export const TOKEN_SCALE = 1_000_000_000_000n;
+
+const n = (v: AbiValue): number => Number(v as bigint);
+
+/**
+ * The ABI-decoded `launchBook` and `launchFeeCurve` tuples (one block) → the math's `Book`. `launchBook.feePpm` is the
+ * curve's end; the curve (`feeStartPpm`, √ knots, `sqrtFeeB` 0 = flat) is `launchFeeCurve`'s, so a curve launch
+ * prices exactly. The per-range Milestone cap is not in the views; the walk never reads it.
+ */
+export function bookFromView(t: AbiValue[], curve: AbiValue[]): Book {
+  const feeStartPpm = (curve[0] as bigint[]).map(Number);
+  if (feeStartPpm.length !== 5)
+    throw new RangeError(`launchFeeCurve: ${feeStartPpm.length} legs`);
+  const nRanges = n(t[4]);
+  if (nRanges > RANGES_MAX)
+    throw new RangeError(`launchBook: nRanges ${nRanges} > ${RANGES_MAX}`);
+  const bandMoney = t[3] as bigint[];
+  const bandTokens = t[8] as bigint[];
+  const bandEdge = t[9] as bigint[];
+  const nBands = n(t[10]);
+  const nC = n(t[11]);
+  const bandF = t[12] as bigint[];
+  const bandFClaim = t[13] as bigint[];
+  if (
+    nBands > BIDS_MAX ||
+    nBands > bandMoney.length ||
+    nC > nBands ||
+    bandTokens.length !== bandMoney.length ||
+    bandEdge.length !== bandMoney.length + 1 ||
+    bandF.length !== bandMoney.length ||
+    bandFClaim.length !== bandMoney.length
+  )
+    throw new RangeError(
+      `launchBook: bands ${nBands} (C ${nC}) of ${bandMoney.length} / ${bandTokens.length} / ${bandEdge.length} / ${bandF.length} / ${bandFClaim.length}`,
+    );
+  for (let i = BIDS_MAX; i < bandMoney.length; i++)
+    if (
+      bandMoney[i] !== 0n ||
+      bandTokens[i] !== 0n ||
+      bandF[i] !== 0n ||
+      bandFClaim[i] !== 0n
+    )
+      throw new RangeError(`launchBook: band ${i} is set`);
+  const pad = (xs: bigint[], len: number): bigint[] =>
+    Array.from({ length: len }, (_, i) => xs[i] ?? 0n);
+  const view = t[5] as AbiValue[][];
+  const ranges: Range[] = Array.from({ length: RANGES_MAX }, (_, i) => {
+    if (i >= nRanges) return emptyRange();
+    const r = view[i];
+    return {
+      sqrtA: r[0] as bigint,
+      sqrtB: r[1] as bigint,
+      tokens: r[2] as bigint,
+      askLeft: r[3] as bigint,
+      back: r[4] as bigint,
+      place: r[5] as bigint,
+      thetaBps: n(r[6]),
+      psiBps: n(r[7]),
+      kind: n(r[8]),
+      class: n(r[9]),
+      msCapPpm: 0,
+    };
+  });
+  return {
+    sqrtP: t[0] as bigint,
+    sqrtF: t[1] as bigint,
+    sqrtLMax: t[6] as bigint,
+    floor: t[2] as bigint,
+    floorTokens: t[7] as bigint,
+    nBands,
+    nC,
+    bandEdge: pad(bandEdge, BIDS_MAX + 1),
+    bandMoney: pad(bandMoney, BIDS_MAX),
+    bandTokens: pad(bandTokens, BIDS_MAX),
+    bandF: pad(bandF, BIDS_MAX),
+    bandFClaim: pad(bandFClaim, BIDS_MAX),
+    ckAtF: t[14] as bigint,
+    ckFloorTokens: t[15] as bigint,
+    feePpm: (t[17] as bigint[]).map(Number),
+    feeStartPpm,
+    sqrtFeeA: curve[1] as bigint,
+    sqrtFeeB: curve[2] as bigint,
+    graduated: t[16] as boolean,
+    nRanges,
+    ranges,
+  };
+}
+
+/** A buy's refund is dust when the book filled it whole and only the last base units could not buy one more math unit:
+ * `refund ≤ 1 ppm of gross` and no step budget hit (a hit is a part fill, still priced 0). The contract sends it to
+ * `refundTo` (the recipient on `buyFromBalance`, msg.sender on the native `buy`). */
+export function isDustRefund(
+  gross: bigint,
+  refund: bigint,
+  budgetHit: boolean,
+): boolean {
+  return refund > 0n && !budgetHit && refund * 1_000_000n <= gross;
+}
+
+/**
+ * Exact-in, as the contract's `buy` / `buyFromBalance` / `sellFromBalance` fill it: a buy returns chain-unit tokens, a
+ * sell quote base units. A sell is priced on its whole math units (`amountIn − amountIn % 10¹²`): `sellFromBalance`
+ * sells those and returns the sub-unit rest (< 10⁻⁶ token) to the recipient; less than one whole unit prices 0. A buy
+ * filled whole but for a dust refund (`isDustRefund`) is priced at its tokens, the dust going to `refundTo`. 0 when the
+ * trade would refund more (a buy that leaves money, a sell not all filled) or is refused. A buy's first-time money
+ * splits at its end on chain (F, then C + K, then the Marketcap Milestones) and C + K is re-laid as the mirror of the
+ * ask, moving nothing the walk reads, so the walk is the fill; the book as read holds the bid a sell walks.
+ */
+export function amountOut(book: Book, isBuy: boolean, amountIn: bigint): bigint {
+  return walk(book, isBuy, amountIn).amountOut;
+}
+
+/** `amountOut` and the walk's step count (what `gasFor` prices); `steps` is 0 when nothing is priced. */
+export function walk(
+  book: Book,
+  isBuy: boolean,
+  amountIn: bigint,
+): { amountOut: bigint; steps: number } {
+  try {
+    if (isBuy) {
+      const r = quoteBookBuy(book, amountIn);
+      const whole =
+        r.refund === 0n || isDustRefund(amountIn, r.refund, r.budgetHit);
+      return { amountOut: whole ? r.tokens * TOKEN_SCALE : 0n, steps: r.steps };
+    }
+    // `sellFromBalance` sells the whole math units and sends the sub-unit rest back to the recipient
+    const units = amountIn / TOKEN_SCALE;
+    if (units === 0n) return { amountOut: 0n, steps: 0 };
+    const r = quoteBookSell(book, units);
+    return { amountOut: r.unfilled > 0n ? 0n : r.out, steps: r.steps };
+  } catch {
+    return { amountOut: 0n, steps: 0 };
+  }
+}
+
+/** Gas of a plain hop at its MEASURED worst over every launch state (presets 1 and 3), rounded up. */
+export const GAS_FLAT = { buy: 700_000, sell: 750_000 } as const;
+/** [est.] gas per walk step beyond `GAS_FLAT_STEPS`: unmeasured (the SDK's `v2/router.ts` holds the same numbers). */
+export const GAS_PER_STEP = { buy: 40_000, sell: 40_000 } as const;
+export const GAS_FLAT_STEPS = 4;
+export const GAS_MAX = 1_500_000;
+
+/** `gasFor(side, steps)`: the measured flat figure up to `GAS_FLAT_STEPS` walk steps, [est.] per step beyond, capped. */
+export function gasFor(side: 'buy' | 'sell', steps: number): number {
+  const extra = Math.max(0, Math.trunc(steps) - GAS_FLAT_STEPS);
+  return Math.min(GAS_MAX, GAS_FLAT[side] + extra * GAS_PER_STEP[side]);
+}
+
+/** The launch's liquidity = the bid money, F + C + K (`floor` + every segment's money), plus the money in place (the
+ * Bonding flat's before graduation; 0 after), in quote base units. */
+export function dexLiquidity(b: Book): bigint {
+  let s = b.floor;
+  for (let i = 0; i < b.nBands; i++) s += b.bandMoney[i];
+  for (let i = 0; i < b.nRanges; i++) s += b.ranges[i].place;
+  return s;
+}
