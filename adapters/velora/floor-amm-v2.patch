diff --git a/src/dex/floor-amm/types.ts b/src/dex/floor-amm/types.ts
new file mode 100644
index 00000000..8d439dd4
--- /dev/null
+++ b/src/dex/floor-amm/types.ts
@@ -0,0 +1,44 @@
+import type { Address } from '../../types';
+import type { Book } from './math/v2/book';
+
+/** One launch's market as the pool keeps it: the book the views return, read at one block. */
+export type PoolState = {
+  /** `launchBook` as the math's `Book` (`book.ts` `bookOf`): what `getPricesVolume` walks a copy of. */
+  book: Book;
+  /** The quote's decimals (18 for the native quote). */
+  quoteDecimals: number;
+};
+
+/** The route's data: which launch, which way. */
+export type FloorAmmData = {
+  /** The FloorAmm proxy (one address on every chain). */
+  exchange: Address;
+  launchId: string;
+  /** true: quote → token (`buy*`); false: token → quote (`sell*`). */
+  isBuy: boolean;
+};
+
+export type DexParams = {
+  /** The FloorAmm proxy (one CREATE2 address on every chain). */
+  floorAmm: Address;
+  /** The most launches the dex keeps, by liquidity (USD), never by recency. */
+  maxLaunches: number;
+  /** The first block `initializePricing` reads `LaunchCreated` logs from (the proxy's deploy block; default 0). */
+  deployBlock?: number;
+  /** Blocks per `getLogs` call at startup (default 100,000). */
+  logRange?: number;
+  /** Launches whose books are read at once at startup (default 25). */
+  readBatch?: number;
+  /** Price launches whose quote is not on FLOOR's quote registry (default false: they are not routed). */
+  routeUnlisted?: boolean;
+};
+
+/** A launch as discovered (`LaunchCreated`, or `launchToken` / `launchQuote`). */
+export type LaunchMeta = {
+  id: bigint;
+  token: Address;
+  /** The quote as FloorAmm stores it: `0x0…0` is the native quote. */
+  quote: Address;
+  /** The quote was on the registry when the launch was created (`LaunchCreated.listed`), or is on it now. */
+  listed: boolean;
+};
