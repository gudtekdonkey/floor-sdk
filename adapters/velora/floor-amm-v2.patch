+// FloorAmm on Velora: the FLOOR Program's EVM contract, ONE per chain, every launch trading against it from its first block
+// (there is no pool contract: a "pool" here is one launch id). A launch's state is its book (`launchBook`), read at a
+// block by the event pool (`floor-amm-pool.ts`); prices are the program's own book walk on a copy of it (`book.ts`).
+// The route calls the program's router entry points, `buyFromBalance` / `sellFromBalance` (the executor sends the
+// token in first), or `buy` with `msg.value` for a launch quoted in the native token.
+//
+// Buys and sells are never paused: there is no "paused" pool state to read. Fill-and-refund: a buy the book cannot
+// fill whole refunds the rest and is priced 0; a buy filled whole but for dust (refund <= 1 ppm of gross, no step
+// budget hit) is priced at its tokens, the dust to `refundTo`. A sell is priced on its whole 10^-6-token units, the
+// rest returned to the recipient. Exact-in only (SwapSide.SELL): FloorAmm has no exact-out entry point.
+
+import type {
+  AdapterExchangeParam,
+  Address,
+  DexExchangeParam,
+  ExchangePrices,
+  Logger,
+  NumberAsString,
+  PoolLiquidity,
+  PoolPrices,
+  Token,
+} from '../../types';
+import { ETHER_ADDRESS, NULL_ADDRESS, SwapSide } from '../../constants';
+import type { Network } from '../../constants';
+import type { IDexHelper } from '../../dex-helper/idex-helper';
+import type { IDex } from '../idex';
+import { SimpleExchange } from '../simple-exchange';
+import * as CALLDATA_GAS_COST from '../../calldata-gas-cost';
+import { getBigIntPow, getDexKeysWithNetwork } from '../../utils';
+import { FloorAmmConfig } from './config';
+import { FloorAmmEventPool } from './floor-amm-pool';
+import { FloorAmmLaunchFeed } from './launch-feed';
+import {
+  FN,
+  LAUNCH_CREATED_DATA,
+  LAUNCH_CREATED_LISTED,
+  NO_DEADLINE,
+  OUT,
+  TOPIC,
+  calldata,
+  decode,
+  topicAddress,
+  topicUint,
+} from './abi';
+import type { AbiValue } from './evm/abi-coder';
+import type { DexParams, FloorAmmData, LaunchMeta, PoolState } from './types';
+import { dexLiquidity, gasFor, walk } from './book';
+
+const lc = (a: string): string => a.toLowerCase();
+
+export class FloorAmm extends SimpleExchange implements IDex<FloorAmmData> {
+  readonly hasConstantPriceLargeAmounts = false;
+  // a launch quoted in the native token takes it as `msg.value` (`buy` payable): 0x0…0 on chain, ETHER_ADDRESS here
+  readonly needWrapNative = false;
+  readonly isFeeOnTransferSupported = false;
+
+  public static dexKeysWithNetwork: { key: string; networks: Network[] }[] =
+    getDexKeysWithNetwork(FloorAmmConfig) as {
+      key: string;
+      networks: Network[];
+    }[];
+
+  readonly logger: Logger;
+  readonly params: DexParams;
+  /** token (lower case) → its launch's event pool. */
+  readonly pools = new Map<string, FloorAmmEventPool>();
+  /** Launches seen but not routed (their quote is unlisted now): checked again when a quote is written (`QuoteWritten`). */
+  readonly pending = new Map<string, LaunchMeta>();
+  /** The factory subscriber: `LaunchCreated` and `QuoteWritten` logs of the proxy reach the dex through it. */
+  feed: FloorAmmLaunchFeed | null = null;
+
+  constructor(
+    network: Network,
+    dexKey: string,
+    dexHelper: IDexHelper,
+    params: DexParams = FloorAmmConfig[dexKey][network],
+  ) {
+    super(dexHelper, dexKey);
+    this.logger = dexHelper.getLogger(dexKey);
+    this.params = params;
+  }
+
+  /** On chain the native quote is 0x0…0; dex-lib names it `ETHER_ADDRESS`. */
+  private static quoteOf(t: Address): Address {
+    return lc(t) === ETHER_ADDRESS ? NULL_ADDRESS : lc(t);
+  }
+
+  private async view(
+    to: string,
+    sig: string,
+    args: AbiValue[],
+    out: readonly string[],
+    blockNumber: number | 'latest',
+  ): Promise<AbiValue[]> {
+    return decode(
+      out,
+      await this.dexHelper.provider.call(
+        { to, data: calldata(sig, args) },
+        blockNumber,
+      ),
+    );
+  }
+
+  /**
+   * Load every launch from the proxy's `LaunchCreated` logs (the log carries `listed`, so a restart keeps the create flag),
+   * read their books at `blockNumber` in batches, keep the `maxLaunches` with the most liquidity (USD), then subscribe the
+   * factory feed so a launch created later is added as its log arrives (`onLaunchCreated`).
+   */
+  async initializePricing(blockNumber: number): Promise<void> {
+    const amm = this.params.floorAmm;
+    const from = this.params.deployBlock ?? 0;
+    const span = this.params.logRange ?? 100_000;
+    const metas: LaunchMeta[] = [];
+    for (let lo = from; lo <= blockNumber; lo += span) {
+      const logs = await this.dexHelper.provider.getLogs({
+        address: amm,
+        topics: [TOPIC.LaunchCreated],
+        fromBlock: lo,
+        toBlock: Math.min(blockNumber, lo + span - 1),
+      });
+      for (const log of logs) {
+        const meta = FloorAmm.launchOf(amm, log);
+        if (meta) metas.push(meta);
+      }
+    }
+    const batch = this.params.readBatch ?? 25;
+    for (let i = 0; i < metas.length; i += batch)
+      await Promise.all(
+        metas.slice(i, i + batch).map(m => this.addLaunch(m, blockNumber)),
+      );
+    await this.keepMostLiquid();
+    this.feed = new FloorAmmLaunchFeed(this, this.dexKey, this.dexHelper, this.logger);
+    await this.feed.initialize(blockNumber);
+  }
+
+  /** A `LaunchCreated` log of the proxy → the launch, or null. */
+  static launchOf(
+    floorAmm: string,
+    log: { address: string; topics: string[]; data: string },
+  ): LaunchMeta | null {
+    if (lc(log.address) !== lc(floorAmm) || log.topics[0] !== TOPIC.LaunchCreated)
+      return null;
+    const data = decode(LAUNCH_CREATED_DATA, log.data);
+    return {
+      id: topicUint(log.topics[1]),
+      token: topicAddress(log.topics[2]),
+      quote: topicAddress(log.topics[3]),
+      listed: data[LAUNCH_CREATED_LISTED] === true,
+    };
+  }
+
+  /** A pool's liquidity in USD (`dexLiquidity` of its latest book), 0 before it has a state. */
+  private async liquidityUSD(pool: FloorAmmEventPool): Promise<number> {
+    const st = pool.getStaleState() as PoolState | null;
+    if (!st) return 0;
+    return this.dexHelper.getTokenUSDPrice(
+      {
+        address:
+          pool.meta.quote === NULL_ADDRESS ? ETHER_ADDRESS : pool.meta.quote,
+        decimals: st.quoteDecimals,
+      },
+      dexLiquidity(st.book),
+    );
+  }
+
+  /** Keep the `maxLaunches` launches with the most liquidity, never the newest: a drop is the least liquid. */
+  private async keepMostLiquid(): Promise<void> {
+    if (this.pools.size <= this.params.maxLaunches) return;
+    const ranked = await Promise.all(
+      [...this.pools].map(async ([token, pool]) => ({
+        token,
+        usd: await this.liquidityUSD(pool),
+      })),
+    );
+    ranked.sort((a, b) => b.usd - a.usd);
+    for (const r of ranked.slice(this.params.maxLaunches))
+      this.pools.delete(r.token);
+  }
+
+  /**
+   * A launch is priced when its quote was on FLOOR's quote registry at create (`LaunchCreated.listed`) or is on it now
+   * (`quoteEntry(quote).listed`). A launch on an unlisted quote (any ERC-20, with a price its creator declared) is not
+   * routed unless `routeUnlisted` is set: nothing has vetted the quote token's transfer behaviour. Returns the quote's
+   * decimals, or null when the launch is not routed.
+   */
+  async quoteDecimals(
+    meta: LaunchMeta,
+    blockNumber: number,
+  ): Promise<number | null> {
+    if (meta.quote === NULL_ADDRESS) return 18;
+    const [entry] = (await this.view(
+      this.params.floorAmm,
+      FN.quoteEntry,
+      [meta.quote],
+      OUT.quoteEntry,
+      blockNumber,
+    )) as AbiValue[][];
+    if (entry[0] === true) return Number(entry[2] as bigint);
+    if (!meta.listed && !this.params.routeUnlisted) return null;
+    const [dec] = (await this.view(
+      meta.quote,
+      FN.decimals,
+      [],
+      OUT.decimals,
+      blockNumber,
+    )) as bigint[];
+    return Number(dec);
+  }
+
+  /** A launch the dex prices from now on (from `initializePricing`, or a `LaunchCreated` log via `onLaunchCreated`). */
+  async addLaunch(
+    meta: LaunchMeta,
+    blockNumber: number,
+  ): Promise<FloorAmmEventPool | null> {
+    const decimals = await this.quoteDecimals(meta, blockNumber);
+    if (decimals === null) {
+      this.pending.set(lc(meta.token), meta);
+      return null;
+    }
+    this.pending.delete(lc(meta.token));
+    const pool = new FloorAmmEventPool(
+      this.dexKey,
+      this.dexHelper,
+      this.params.floorAmm,
+      meta,
+      decimals,
+      this.logger,
+    );
+    await pool.initialize(blockNumber);
+    this.pools.set(lc(meta.token), pool);
+    return pool;
+  }
+
+  /** dex-lib's factory hook: a `LaunchCreated` log of the FloorAmm proxy (via `FloorAmmLaunchFeed`). */
+  async onLaunchCreated(log: {
+    address: string;
+    topics: string[];
+    data: string;
+    blockNumber: number;
+  }): Promise<FloorAmmEventPool | null> {
+    const meta = FloorAmm.launchOf(this.params.floorAmm, log);
+    if (!meta) return null;
+    const pool = await this.addLaunch(meta, log.blockNumber);
+    await this.keepMostLiquid();
+    return pool;
+  }
+
+  /** A quote was (re-)written: every pending launch on it is checked again and added if it is now routed. */
+  async onQuoteWritten(quote: string, blockNumber: number): Promise<void> {
+    for (const meta of [...this.pending.values()])
+      if (meta.quote === lc(quote)) await this.addLaunch(meta, blockNumber);
+  }
+
+  /** The pool of a (quote, token) pair in either order, and the direction. */
+  private match(
+    src: Token,
+    dest: Token,
+  ): { pool: FloorAmmEventPool; isBuy: boolean } | null {
+    const [s, d] = [
+      FloorAmm.quoteOf(src.address),
+      FloorAmm.quoteOf(dest.address),
+    ];
+    const asToken = this.pools.get(d);
+    if (asToken && asToken.meta.quote === s)
+      return { pool: asToken, isBuy: true };
+    const asSrc = this.pools.get(s);
+    if (asSrc && asSrc.meta.quote === d) return { pool: asSrc, isBuy: false };
+    return null;
+  }
+
+  private poolId(pool: FloorAmmEventPool): string {
+    return `${this.dexKey}_${lc(this.params.floorAmm)}_${
+      pool.meta.id
+    }`.toLowerCase();
+  }
+
+  async getPoolIdentifiers(
+    srcToken: Token,
+    destToken: Token,
+    side: SwapSide,
+    _blockNumber: number,
+  ): Promise<string[]> {
+    if (side !== SwapSide.SELL) return [];
+    const m = this.match(srcToken, destToken);
+    return m ? [this.poolId(m.pool)] : [];
+  }
+
+  async getPricesVolume(
+    srcToken: Token,
+    destToken: Token,
+    amounts: bigint[],
+    side: SwapSide,
+    blockNumber: number,
+    limitPools?: string[],
+  ): Promise<null | ExchangePrices<FloorAmmData>> {
+    if (side !== SwapSide.SELL) return null;
+    const m = this.match(srcToken, destToken);
+    if (!m) return null;
+    const id = this.poolId(m.pool);
+    if (limitPools && !limitPools.includes(id)) return null;
+    const state = m.pool.getState(blockNumber) as PoolState | null;
+    if (!state) return null;
+    const unit = walk(
+      state.book,
+      m.isBuy,
+      getBigIntPow(srcToken.decimals),
+    ).amountOut;
+    const walks = amounts.map(a => walk(state.book, m.isBuy, a));
+    const prices = walks.map(w => w.amountOut);
+    if (prices.every(p => p === 0n)) return null;
+    return [
+      {
+        prices,
+        unit,
+        data: {
+          exchange: this.params.floorAmm,
+          launchId: m.pool.meta.id.toString(),
+          isBuy: m.isBuy,
+        },
+        poolIdentifiers: [id],
+        exchange: this.dexKey,
+        gasCost: walks.map(w => gasFor(m.isBuy ? 'buy' : 'sell', w.steps)),
+        poolAddresses: [this.params.floorAmm],
+      },
+    ];
+  }
+
+  getCalldataGasCost(_poolPrices: PoolPrices<FloorAmmData>): number | number[] {
+    // the widest call: id, two amounts, two addresses, the deadline word
+    return (
+      CALLDATA_GAS_COST.DEX_OVERHEAD +
+      CALLDATA_GAS_COST.FUNCTION_SELECTOR +
+      CALLDATA_GAS_COST.INDEX +
+      CALLDATA_GAS_COST.AMOUNT * 2 +
+      CALLDATA_GAS_COST.ADDRESS * 2 +
+      CALLDATA_GAS_COST.FULL_WORD
+    );
+  }
+
+  /**
+   * The hop's call. ERC-20 in: the executor transfers the source to FloorAmm first (`transferSrcTokenBeforeSwap`) and calls
+   * `buyFromBalance(id, minOut, recipient, refundTo = recipient, deadline)` / `sellFromBalance(id, minOut, recipient,
+   * deadline)`: no approval, and a buy's refund (dust only, as priced) goes to the recipient. Native in: `buy(id,
+   * srcAmount, minOut, recipient, deadline)` with `msg.value = srcAmount` (its dust refund goes to msg.sender, the
+   * executor). The deadline is the router's: none here. `minOut` is `destAmount`; the program reverts under it.
+   */
+  getDexParam(
+    srcToken: Address,
+    _destToken: Address,
+    srcAmount: NumberAsString,
+    destAmount: NumberAsString,
+    recipient: Address,
+    data: FloorAmmData,
+    side: SwapSide,
+  ): DexExchangeParam {
+    if (side !== SwapSide.SELL)
+      throw new Error(`${this.dexKey}: exact-in only`);
+    const id = BigInt(data.launchId);
+    const minOut = BigInt(destAmount);
+    const ethIn = lc(srcToken) === ETHER_ADDRESS;
+    const exchangeData = !data.isBuy
+      ? calldata(FN.sellFromBalance, [id, minOut, recipient, NO_DEADLINE])
+      : ethIn
+      ? calldata(FN.buy, [
+          id,
+          BigInt(srcAmount),
+          minOut,
+          recipient,
+          NO_DEADLINE,
+        ])
+      : calldata(FN.buyFromBalance, [
+          id,
+          minOut,
+          recipient,
+          recipient,
+          NO_DEADLINE,
+        ]);
+    return {
+      needWrapNative: this.needWrapNative,
+      dexFuncHasRecipient: true,
+      exchangeData,
+      targetExchange: data.exchange,
+      // buy* → BuyResult (tokensOut first); sell* → quoteOut: the amount out is the first word either way
+      returnAmountPos: 0,
+      ...(ethIn ? {} : { transferSrcTokenBeforeSwap: data.exchange }),
+    };
+  }
+
+  /** Augustus v5's adapters: none (FloorAmm routes through v6's `getDexParam`). */
+  getAdapters(_side: SwapSide): { name: string; index: number }[] | null {
+    return null;
+  }
+
+  /** Augustus v5's adapter param: a placeholder (v6 does not use it). */
+  getAdapterParam(
+    _srcToken: Address,
+    _destToken: Address,
+    _srcAmount: NumberAsString,
+    _destAmount: NumberAsString,
+    data: FloorAmmData,
+    _side: SwapSide,
+  ): AdapterExchangeParam {
+    return { targetExchange: data.exchange, payload: '0x', networkFee: '0' };
+  }
+
+  /** A launch's liquidity is F + C + K (`book.ts` `dexLiquidity`), in USD; its connector is the other side. */
+  async getTopPoolsForToken(
+    tokenAddress: Address,
+    limit: number,
+  ): Promise<PoolLiquidity[]> {
+    const t = FloorAmm.quoteOf(tokenAddress);
+    const out: PoolLiquidity[] = [];
+    for (const pool of this.pools.values()) {
+      const isToken = pool.meta.token === t;
+      if (!isToken && pool.meta.quote !== t) continue;
+      const st = pool.getStaleState() as PoolState | null;
+      if (!st) continue;
+      const quote = {
+        address:
+          pool.meta.quote === NULL_ADDRESS ? ETHER_ADDRESS : pool.meta.quote,
+        decimals: st.quoteDecimals,
+      };
+      const liquidityUSD = await this.dexHelper.getTokenUSDPrice(
+        quote,
+        dexLiquidity(st.book),
+      );
+      out.push({
+        exchange: this.dexKey,
+        address: this.params.floorAmm,
+        connectorTokens: [
+          isToken ? quote : { address: pool.meta.token, decimals: 18 },
+        ],
+        liquidityUSD,
+      });
+    }
+    return out.sort((a, b) => b.liquidityUSD - a.liquidityUSD).slice(0, limit);
+  }
+
+  releaseResources(): void {
+    this.pools.clear();
+  }
+}
diff --git a/src/dex/floor-amm/launch-feed.ts b/src/dex/floor-amm/launch-feed.ts
new file mode 100644
index 00000000..605ad84f
--- /dev/null
+++ b/src/dex/floor-amm/launch-feed.ts
@@ -0,0 +1,39 @@
+// The factory subscriber: the FloorAmm proxy's `LaunchCreated` and `QuoteWritten` logs reach the dex through it. dex-lib's
+// block manager delivers a subscribed address's logs in order; a launch created after startup is added as its log arrives,
+// a launch whose quote is listed later is added when the quote is written. State: none (the pools hold the launches).
+
+import type { BlockHeader, Log, Logger } from '../../types';
+import { StatefulEventSubscriber } from '../../stateful-event-subscriber';
+import { TOPIC, topicAddress } from './abi';
+import type { IDexHelper } from '../../dex-helper/idex-helper';
+import type { FloorAmm } from './floor-amm';
+
+type Feed = Record<string, never>;
+
+export class FloorAmmLaunchFeed extends StatefulEventSubscriber<Feed> {
+  private readonly dex: FloorAmm;
+
+  constructor(dex: FloorAmm, dexKey: string, dexHelper: IDexHelper, logger: Logger) {
+    super(dexKey, `${dex.params.floorAmm}_launches`, dexHelper, logger);
+    this.dex = dex;
+    this.addressesSubscribed = [dex.params.floorAmm];
+  }
+
+  generateState(): Feed {
+    return {};
+  }
+
+  protected async processLog(
+    state: Feed,
+    log: Readonly<Log>,
+    _blockHeader: Readonly<BlockHeader>,
+  ): Promise<Feed | null> {
+    if (log.address.toLowerCase() !== this.dex.params.floorAmm.toLowerCase())
+      return null;
+    if (log.topics[0] === TOPIC.LaunchCreated)
+      await this.dex.onLaunchCreated({ ...log, topics: [...log.topics] });
+    else if (log.topics[0] === TOPIC.QuoteWritten && log.topics.length >= 2)
+      await this.dex.onQuoteWritten(topicAddress(log.topics[1]), log.blockNumber);
+    return state;
+  }
+}
