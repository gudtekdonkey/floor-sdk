index 00000000..fa2cfc36
--- /dev/null
+++ b/src/dex/floor-amm/math/v2/relay.ts
@@ -0,0 +1,245 @@
+import { fail } from "../index";
+import { BIDS_MAX, KIND_BONDING, rangeIsFlat, rangeLiquidity } from "./book";
+import type { Book, Range } from "./book";
+import type { SplitRow } from "./split";
+import { FRAC, flatMoneyForTokens, flatTokensForMoney, liquidityForMoney, moneyBetween, sqrtAfterTokens, tokensBetween } from "./sqrt";
+import type { Sqrt } from "./sqrt";
+import { DOWN, UP, U128_MAX, U64_MAX, divW, isqrt, mulDiv, shlDiv } from "./wide";
+const CUT_NUDGES = 8;
+const ov = <T>(x: T | null): T => (x === null ? fail("Overflow") : x);
+const u128 = (x: bigint): bigint => (x > U128_MAX ? fail("Overflow") : x);
+const u64 = (x: bigint): bigint => (x > U64_MAX ? fail("Overflow") : x);
+function slice(l: bigint, a: Sqrt, hi: Sqrt, sqrtF: Sqrt): {
+    money: bigint;
+    tok: bigint;
+    fIn: bigint;
+} {
+    const money = ov(moneyBetween(l, a, hi, DOWN));
+    const tok = ov(tokensBetween(l, a, hi, UP));
+    const f = ov(flatMoneyForTokens(sqrtF, tok, UP));
+    return { money, tok, fIn: f < money ? f : money };
+}
+function cutRoot(l: bigint, hi: Sqrt, sqrtF: Sqrt, left: bigint): Sqrt | null {
+    const f2 = sqrtF * sqrtF;
+    const fHi = divW(f2, hi, UP);
+    if (fHi === null || fHi > U128_MAX)
+        return null;
+    const lt = shlDiv(left, FRAC, l, DOWN);
+    if (lt === null || lt > U128_MAX)
+        return null;
+    const sum = hi + fHi;
+    if (sum > U128_MAX)
+        return null;
+    const beta = sum - lt;
+    if (beta < 0n)
+        return null;
+    const disc = beta * beta - 4n * f2;
+    const sq = beta + isqrt(disc < 0n ? 0n : disc);
+    if (sq > U128_MAX)
+        return null;
+    return sq / 2n + (sq & 1n);
+}
+export interface RelaySeg {
+    lo: Sqrt;
+    hi: Sqrt;
+    money: bigint;
+    fIn: bigint;
+}
+function absorb(sqrtF: Sqrt, edge: Sqrt, left: bigint): RelaySeg {
+    if (edge <= sqrtF)
+        return { lo: 0n, hi: 0n, money: 0n, fIn: 0n };
+    const money = ov(mulDiv(left, edge, edge - sqrtF, DOWN));
+    const f = ov(mulDiv(money, sqrtF, edge, UP));
+    return { lo: sqrtF, hi: edge, money, fIn: f < money ? f : money };
+}
+export function mirror(ranges: readonly Range[], nRanges: number, sqrtF: Sqrt, top0: Sqrt, premium: bigint, tokCap: bigint, segMax: number = BIDS_MAX, absorbLast: boolean = false): {
+    segs: RelaySeg[];
+    tokens: bigint;
+    left: bigint;
+} {
+    const segs: RelaySeg[] = [];
+    let left = premium;
+    let tokLeft = tokCap;
+    let top = top0;
+    if (left === 0n || tokLeft === 0n || segMax <= 0 || top <= sqrtF)
+        return { segs, tokens: 0n, left };
+    let cutDone = false;
+    for (let i = nRanges - 1; i >= 0; i--) {
+        const r = ranges[i];
+        if (r.kind === KIND_BONDING || rangeIsFlat(r) || r.sqrtA >= top)
+            continue;
+        const hi = top < r.sqrtB ? top : r.sqrtB;
+        const lo = r.sqrtA > sqrtF ? r.sqrtA : sqrtF;
+        if (hi <= lo)
+            continue;
+        const l = ov(rangeLiquidity(r));
+        if (l === 0n)
+            continue;
+        if (absorbLast && segs.length + 1 === segMax)
+            break;
+        const w = slice(l, lo, hi, sqrtF);
+        if (w.money - w.fIn <= left && w.tok <= tokLeft) {
+            segs.push({ lo, hi, money: w.money, fIn: w.fIn });
+            left -= w.money - w.fIn;
+            tokLeft -= w.tok;
+            top = lo;
+            if (left === 0n || tokLeft === 0n || segs.length === segMax)
+                break;
+            continue;
+        }
+        const at = sqrtAfterTokens(l, hi, tokLeft) ?? lo;
+        const ap = cutRoot(l, hi, sqrtF, left) ?? lo;
+        let a = ap > at ? ap : at;
+        if (a < lo)
+            a = lo;
+        if (a > hi)
+            a = hi;
+        for (let k = 0; k < CUT_NUDGES + 1 && a < hi; k++, a++) {
+            const c = slice(l, a, hi, sqrtF);
+            if (c.money - c.fIn <= left && c.tok <= tokLeft) {
+                segs.push({ lo: a, hi, money: c.money, fIn: c.fIn });
+                left -= c.money - c.fIn;
+                tokLeft -= c.tok;
+                top = a;
+                break;
+            }
+        }
+        cutDone = true;
+        break;
+    }
+    if (absorbLast && !cutDone && left > 0n && tokLeft > 0n && segs.length + 1 === segMax && top > sqrtF) {
+        const g = absorb(sqrtF, top, left);
+        const tok = g.money === 0n ? 0n : ov(tokensBetween(ov(liquidityForMoney(g.lo, g.hi, g.money)), g.lo, g.hi, UP));
+        if (g.money > 0n && tok <= tokLeft) {
+            tokLeft -= tok;
+            left -= g.money - g.fIn;
+            segs.push(g);
+        }
+    }
+    return { segs, tokens: tokCap - tokLeft, left };
+}
+export interface Relay {
+    nC: number;
+    nK: number;
+    laidC: bigint;
+    laidK: bigint;
+    atF: bigint;
+    kept: number;
+}
+export function relay(b: Book, row: SplitRow, extraCk: bigint, circ: bigint, ckOut = 0n): Relay {
+    const p = b.sqrtP;
+    const f = b.sqrtF;
+    const zero = (): RelaySeg => ({ lo: 0n, hi: 0n, money: 0n, fIn: 0n });
+    let pool = u128(b.ckAtF + extraCk);
+    let floor = b.floor - b.ckAtF;
+    const edge: Sqrt[] = Array(BIDS_MAX + 1).fill(0n);
+    const segs: RelaySeg[] = Array.from({ length: BIDS_MAX }, zero);
+    const tok: bigint[] = Array(BIDS_MAX).fill(0n);
+    const claim: bigint[] = Array(BIDS_MAX).fill(0n);
+    const cflag: boolean[] = Array(BIDS_MAX).fill(false);
+    let n = 0;
+    let kept = 0;
+    for (let i = 0; i < b.nBands; i++) {
+        const lo = b.bandEdge[i + 1];
+        const hi = b.bandEdge[i];
+        const fi = b.bandF[i] < b.bandMoney[i] ? b.bandF[i] : b.bandMoney[i];
+        pool = u128(pool + b.bandMoney[i] - fi);
+        floor = u128(floor + fi);
+        const klo = lo > p ? lo : p;
+        if (hi > klo && (b.bandTokens[i] > 0n || b.bandFClaim[i] > 0n)) {
+            if (n > 0 && edge[n] !== hi) {
+                segs[n] = { lo: hi, hi: edge[n], money: 0n, fIn: 0n };
+                edge[n + 1] = hi;
+                n++;
+            }
+            edge[n] = hi;
+            segs[n] = { lo: klo, hi, money: 0n, fIn: 0n };
+            tok[n] = b.bandTokens[i];
+            claim[n] = b.bandFClaim[i];
+            cflag[n] = i < b.nC;
+            edge[n + 1] = klo;
+            n++;
+            kept++;
+        }
+        else if (b.bandTokens[i] > 0n) {
+            const t = b.bandTokens[i];
+            let mine = t;
+            if (f !== 0n) {
+                const c = ov(flatTokensForMoney(f, b.bandFClaim[i], UP));
+                mine = c < t ? c : t;
+            }
+            b.floorTokens = u64(b.floorTokens + t);
+            b.ckFloorTokens = u64(b.ckFloorTokens + t - mine);
+        }
+    }
+    if (ckOut > pool)
+        fail("Overflow");
+    pool -= ckOut;
+    const room = p > f && f > 0n;
+    if (room && n > 0 && edge[n] > p) {
+        segs[n] = { lo: p, hi: edge[n], money: 0n, fIn: 0n };
+        edge[n + 1] = p;
+        n++;
+    }
+    const nTop = n;
+    const r: Relay = { nC: 0, nK: 0, laidC: 0n, laidK: 0n, atF: 0n, kept };
+    let lk = pool;
+    if (room && n + 1 < BIDS_MAX) {
+        const cp = ov(mulDiv(pool, BigInt(row.cShareBps), 10000n, DOWN));
+        const backed = ov(flatTokensForMoney(f, floor, DOWN));
+        let cap = circ;
+        let laid: RelaySeg[];
+        let nc: number;
+        for (;;) {
+            const c = mirror(b.ranges, b.nRanges, f, p, cp, cap, BIDS_MAX - 1 - n, false);
+            nc = c.segs.length;
+            const ktop = nc > 0 ? c.segs[nc - 1].lo : p;
+            const k = mirror(b.ranges, b.nRanges, f, ktop, pool - cp + c.left, cap - c.tokens, BIDS_MAX - n - nc, true);
+            laid = [...c.segs, ...k.segs];
+            let fi = 0n;
+            for (const g of laid)
+                fi += g.fIn;
+            if (fi <= floor || cap === 0n) {
+                lk = k.left;
+                break;
+            }
+            if (cap > backed)
+                cap = backed;
+            else {
+                const short = ov(flatTokensForMoney(f, fi - floor, UP));
+                const dropped = short + BigInt(laid.length) + 1n;
+                cap = cap > dropped ? cap - dropped : 0n;
+            }
+        }
+        r.nC = nc;
+        r.nK = laid.length - nc;
+        if (n === 0 && laid.length > 0)
+            edge[0] = p;
+        laid.forEach((g, j) => {
+            segs[n + j] = g;
+            edge[n + j + 1] = g.lo;
+            cflag[n + j] = j < nc;
+            if (j < nc)
+                r.laidC += g.money - g.fIn;
+            else
+                r.laidK += g.money - g.fIn;
+        });
+        n += laid.length;
+    }
+    let fIn = 0n;
+    for (let i = nTop; i < n; i++)
+        fIn += segs[i].fIn;
+    if (floor < fIn)
+        fail("Overflow");
+    b.floor = floor - fIn + lk;
+    b.ckAtF = lk;
+    b.nBands = n;
+    b.nC = cflag.slice(0, n).filter((c) => c).length;
+    b.bandEdge = Array.from({ length: BIDS_MAX + 1 }, (_, i) => (n > 0 && i <= n ? edge[i] : 0n));
+    b.bandMoney = segs.map((g, i) => (i < n ? g.money : 0n));
+    b.bandF = segs.map((g, i) => (i < n ? g.fIn : 0n));
+    b.bandTokens = tok.map((t, i) => (i < n ? t : 0n));
+    b.bandFClaim = claim.map((c, i) => (i < n ? c : 0n));
+    r.atF = lk;
+    return r;
+}
diff --git a/src/dex/floor-amm/math/v2/split.ts b/src/dex/floor-amm/math/v2/split.ts
new file mode 100644
index 00000000..98d4147a
--- /dev/null
+++ b/src/dex/floor-amm/math/v2/split.ts
@@ -0,0 +1,148 @@
+import { fail } from "../index";
+import { KIND_BONDING, KIND_TAIL, PIECES_MAX } from "./book";
+import type { Range } from "./book";
+import { flatMoneyForTokens, sqrtOfRatio, sqrtScaleDownBps } from "./sqrt";
+import type { Sqrt } from "./sqrt";
+import { U128_MAX, UP } from "./wide";
+export const MS_TEAM = 1;
+export const MS_HOLDER = 2;
+export { PIECES_MAX };
+const ov = <T>(x: T | null): T => (x === null ? fail("Overflow") : x);
+const u128 = (x: bigint): bigint => (x > U128_MAX ? fail("Overflow") : x);
+const min = (a: bigint, b: bigint): bigint => (a < b ? a : b);
+const max = (a: bigint, b: bigint): bigint => (a > b ? a : b);
+const sat = (a: bigint, b: bigint): bigint => (a > b ? a - b : 0n);
+const cdiv = (a: bigint, d: bigint): bigint => (a + d - 1n) / d;
+const flatUp = (s: Sqrt, n: bigint): bigint => ov(flatMoneyForTokens(s, n, UP));
+export interface SplitRow {
+    phiBps: number;
+    ckBps: number;
+    wcBps: number;
+    cShareBps: number;
+    msClass: number;
+    platformMsBps: number;
+    floorMsBps: number;
+}
+export function splitRowOfRowV2(r: {
+    phiBps: number;
+    ckTargetBps?: number;
+    ckBps?: number;
+    msClass: number;
+    flags: number;
+    platformMsBps: number;
+    floorMsBps: number;
+}): SplitRow {
+    const ck = r.ckTargetBps ?? r.ckBps;
+    if (!Number.isInteger(ck))
+        throw new RangeError("splitRowOfRowV2: the row has no C + K share (`ckTargetBps`)");
+    if (r.ckTargetBps !== undefined && r.ckBps !== undefined && r.ckTargetBps !== r.ckBps) {
+        throw new RangeError(`splitRowOfRowV2: ckTargetBps ${r.ckTargetBps} and ckBps ${r.ckBps} disagree`);
+    }
+    return {
+        phiBps: r.phiBps,
+        ckBps: ck as number,
+        wcBps: 300,
+        cShareBps: 5000,
+        msClass: r.msClass,
+        platformMsBps: (r.flags & 1) !== 0 ? r.platformMsBps : 0,
+        floorMsBps: (r.flags & 2) !== 0 ? r.floorMsBps : 0,
+    };
+}
+export interface Piece {
+    sqrtLo: Sqrt;
+    sqrtHi: Sqrt;
+    money: bigint;
+    tokens: bigint;
+    range: number;
+}
+export interface SplitIn {
+    sqrtF: Sqrt;
+    sqrtP1: Sqrt;
+    fTotal: bigint;
+    fClaims: bigint;
+    ck0: bigint;
+    held: bigint;
+    sNew: bigint;
+}
+export interface Split {
+    dF: bigint;
+    ckAdd: bigint;
+    ckTake: bigint;
+    ms: bigint;
+    booked: [
+        bigint,
+        bigint,
+        bigint,
+        bigint
+    ];
+    sqrtFNew: Sqrt;
+}
+export function split(row: SplitRow, ranges: readonly Range[], inp: SplitIn, pieces: readonly Piece[]): Split {
+    let tokensSum = 0n;
+    for (const p of pieces)
+        tokensSum += p.tokens;
+    let sr = inp.sNew - tokensSum;
+    if (sr < 0n)
+        fail("Overflow");
+    let fr = inp.fTotal;
+    const phi = BigInt(row.phiBps);
+    let ckAdd = 0n;
+    let ms = 0n;
+    let topNeed = 0n;
+    const booked: [
+        bigint,
+        bigint,
+        bigint,
+        bigint
+    ] = [0n, 0n, 0n, 0n];
+    for (const pc of pieces) {
+        const r = ranges[pc.range];
+        sr += pc.tokens;
+        const lo = pc.sqrtLo;
+        const capA = cdiv(pc.money * BigInt(r.psiBps), 10000n);
+        const capB = cdiv(cdiv(pc.money * inp.sqrtF, lo) * inp.sqrtF, lo);
+        const cap = min(max(capA, capB), pc.money);
+        const n = sr + inp.held;
+        const needAll = max(flatUp(inp.sqrtF, n), cdiv(flatUp(pc.sqrtHi, n) * phi, 10000n));
+        if (r.kind !== KIND_TAIL)
+            topNeed = needAll;
+        const need = sat(needAll, fr + inp.fClaims);
+        const dF = min(cap, need);
+        fr += dF;
+        const rem = pc.money - dF;
+        if (r.thetaBps >= 10000) {
+            ckAdd += rem;
+            continue;
+        }
+        const gap = sat(cdiv(flatUp(pc.sqrtHi, sr) * BigInt(row.ckBps), 10000n), inp.ck0 + ckAdd);
+        let ck = min(rem, gap);
+        let mm = rem - ck;
+        if (r.msCapPpm > 0) {
+            const capm = (pc.money * BigInt(r.msCapPpm)) / 1000000n;
+            if (mm > capm) {
+                ck += mm - capm;
+                mm = capm;
+            }
+        }
+        ckAdd += ck;
+        ms += mm;
+    }
+    let ckTake = 0n;
+    const short = sat(topNeed, fr + inp.fClaims);
+    if (short > 0n && inp.ck0 + ckAdd > 0n) {
+        const a = min(short, ckAdd);
+        const m2 = min(short - a, ms);
+        ckTake = min(short - a - m2, inp.ck0);
+        ckAdd -= a;
+        ms -= m2;
+        fr += a + m2 + ckTake;
+    }
+    booked[2] = (ms * BigInt(row.platformMsBps)) / 10000n;
+    booked[3] = (ms * BigInt(row.floorMsBps)) / 10000n;
+    booked[row.msClass === MS_HOLDER ? 1 : 0] += ms - booked[2] - booked[3];
+    const ratio = sqrtOfRatio(fr + inp.fClaims, inp.sNew + inp.held);
+    const capSqrt = ov(sqrtScaleDownBps(inp.sqrtP1, row.wcBps));
+    const sqrtFNew = max(inp.sqrtF, ratio === null ? inp.sqrtF : min(ratio, capSqrt));
+    return { dF: fr - inp.fTotal, ckAdd: u128(ckAdd), ckTake, ms: u128(ms), booked, sqrtFNew };
+}
+export const pieceEntersSplit = (r: Range): boolean => r.kind !== KIND_BONDING;
diff --git a/src/dex/floor-amm/math/v2/sqrt.ts b/src/dex/floor-amm/math/v2/sqrt.ts
