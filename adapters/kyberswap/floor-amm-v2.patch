+package flooramm
+
+import _ "embed"
+
+// abis/FloorAmm.json: the launch lookups (`launchCount`, `launchToken`, `launchQuote`) and the registry's
+// `quoteEntry(quote)`.
+//
+//go:embed abis/FloorAmm.json
+var floorAmmJson []byte
+
+// abis/FloorAmmViewsV2.json is the book views' ABI as forge prints it; the tracker reads `launchBook(id)`.
+//
+//go:embed abis/FloorAmmViewsV2.json
+var floorAmmViewsV2Json []byte
diff --git a/pkg/liquidity-source/floor-amm/math/v2/book.go b/pkg/liquidity-source/floor-amm/math/v2/book.go
new file mode 100644
index 00000000..c848a398
--- /dev/null
+++ b/pkg/liquidity-source/floor-amm/math/v2/book.go
@@ -0,0 +1,974 @@
+package floorv2
+
+// The one book (Rust: v2::book): the row's ranges, whose first-time tokens sell from SqrtLMax up (constant product, or
+// flat when SqrtA == SqrtB), and under the price the bid: the mirror segments of C (on top) and K (below), each carrying
+// F's share (BandF) and F's claim (BandFClaim), and F's flat point at f, which also holds C + K's parked money (CkAtF).
+// No range holds money after graduation: the Bonding flat's Place / Back are the only ones, before it. Tokens a segment
+// or the F point bought resell from the piece that bought them, at its prices. Money is u128 (a U under 2^128), tokens
+// uint64 math units.
+//
+// A trade here is the WALK and the fee legs (Buy, Sell): the trader's numbers. The program then splits a buy's
+// first-time money (F, then C + K, then the Milestones) and lays C + K again under the price; neither moves anything the
+// walk reads, so a quote needs neither, and the book after a trade is the walk's, not the program's.
+
+const (
+	RangesMax    = 48
+	BidsMax      = 24 // the book's mirror segments (C + K)
+	RowBands     = 4  // a row's bands (rows::MAX_BANDS)
+	MaxWalkSteps = 24 // pieces one trade may enter (EVM); a buy past it refunds the rest, a sell returns it
+	// SolBuyWalkSteps is the pieces one buy may enter on Solana (Rust SOL_BUY_WALK_STEPS): a buy past it fills
+	// what fits and refunds the rest. EVM walks MaxWalkSteps.
+	SolBuyWalkSteps = 16
+)
+
+// RangeKind.
+const (
+	KindBonding  = 0
+	KindClimb    = 1
+	KindSaleBand = 2
+	KindRetired3 = 3 // range kind 3: retired, never reuse
+	KindUnused   = 4
+	KindTail     = 5
+)
+
+// Range is one row range at absolute edges; Tokens is its allocation (L derives from it), the rest is state. Place and
+// Back are the Bonding flat's only (0 on every other range).
+type Range struct {
+	SqrtA, SqrtB          U
+	Tokens, AskLeft, Back uint64
+	Place                 U
+	ThetaBps, PsiBps      uint16
+	Kind, Class           uint8
+}
+
+// IsFlat: SqrtA == SqrtB is a flat range (constant sum at that price).
+func (r *Range) IsFlat() bool { return eq(r.SqrtA, r.SqrtB) }
+
+// Liquidity is ⌊tokens·a·b ÷ (b − a)⌋, derived, never stored.
+func (r *Range) Liquidity() (U, error) { return LiquidityForTokens(r.SqrtA, r.SqrtB, n(r.Tokens)) }
+
+// Held is AskLeft + Back.
+func (r *Range) Held() uint64 { return r.AskLeft + r.Back }
+
+// Book is the trading part of a launch. A value copy is a full copy, as the Rust's Copy.
+type Book struct {
+	SqrtP, SqrtF, SqrtLMax U
+	// Floor is the F point's money: F's own plus CkAtF. FloorTokens is every token the point bought (F's and
+	// CkFloorTokens).
+	Floor       U
+	FloorTokens uint64
+	// Segment i is [BandEdge[i+1], BandEdge[i]], descending; 0 .. NC are C, NC .. NBands are K.
+	NBands, NC uint8
+	BandEdge   [BidsMax + 1]U
+	BandMoney  [BidsMax]U
+	BandTokens [BidsMax]uint64
+	// BandF is F's money inside segment i (<= BandMoney[i]); BandFClaim is F's claim on the tokens segment i holds.
+	BandF, BandFClaim [BidsMax]U
+	// CkAtF is C + K's money with no room to lay, parked inside Floor at f; CkFloorTokens the tokens it bought there.
+	CkAtF              U
+	CkFloorTokens      uint64
+	FeePpm             [FeeLegs]uint32
+	FeeStartPpm        [FeeLegs]uint32
+	SqrtFeeA, SqrtFeeB U
+	Graduated          bool
+	// OwnFees (Rust own_fees): true keeps the row's curve before graduation (the genesis opens); false charges
+	// PregradPpm until graduation.
+	OwnFees bool
+	NRanges uint8
+	Ranges  [RangesMax]Range
+}
+
+type pieceKind uint8
+
+const (
+	pRange pieceKind = iota
+	pBand
+	pFloor
+)
+
+type piece struct {
+	k pieceKind
+	i int
+}
+
+// WalkUp is what one walk up moved. FirstMoney is the money paid for first-time tokens (what the program splits).
+type WalkUp struct {
+	Money, FirstMoney             U
+	Tokens, FromResale, FromFirst uint64
+	Steps                         uint8
+	BudgetHit, GraduatedNow       bool
+}
+
+// WalkDown is what one walk down moved. FromPlace is the Bonding flat's money (before graduation).
+type WalkDown struct {
+	Tokens                                uint64
+	Money, FromF, FromK, FromC, FromPlace U
+	Steps                                 uint8
+	BudgetHit                             bool
+}
+
+// FeesNow is the legs' rates a trade pays: at the price before the trade (Rust fees_now).
+func (b *Book) FeesNow() [FeeLegs]uint32 {
+	return b.FeesAt(b.SqrtP)
+}
+
+// FeesAt is the legs' rates at sqrtP in this book's state (Rust fees_at: the flat legs before graduation, else the
+// curve).
+func (b *Book) FeesAt(sqrtP U) [FeeLegs]uint32 {
+	return RatesAt(b.Graduated, b.OwnFees, &b.FeePpm, &b.FeeStartPpm, b.SqrtFeeA, b.SqrtFeeB, sqrtP)
+}
+
+// charge puts one walk step's money q into a trade's fee charge at the rates where the step ends (the price now).
+func (b *Book) charge(acc *FeeAcc, q U) error {
+	if isZ(q) {
+		return nil
+	}
+	at := b.FeesNow()
+	if !acc.Add(q, &at) {
+		return ErrOverflow
+	}
+	return nil
+}
+
+// addM is a checked u128 money add (Rust checked_add on u128).
+func addM(a, b U) (U, error) {
+	c := add(a, b)
+	if !fits128(c) || lt(c, a) {
+		return zero, ErrOverflow
+	}
+	return c, nil
+}
+
+// add64 is a checked u64 add.
+func add64(a, b uint64) (uint64, error) {
+	c := a + b
+	if c < a {
+		return 0, ErrOverflow
+	}
+	return c, nil
+}
+
+// cpUp is a money-limited step up a constant-product piece: (tokens, money, new √p). Tokens round down, money up, the
+// price moves no further than paid for; a step that buys no whole token moves nothing.
+func cpUp(l, p, hi, rem U, held uint64, allAtTop bool) (uint64, U, U, error) {
+	if held == 0 || ge(p, hi) || isZ(l) {
+		return 0, zero, p, nil
+	}
+	// the piece's whole money is only an upper bound: past u128 (the tail to
+	// its top) no rem reaches it, so the step is money-limited
+	qFull, errFull := MoneyBetween(l, p, hi, Up)
+	var err error
+	var p2, q U
+	if errFull == nil && ge(rem, qFull) {
+		p2, q = hi, qFull
+	} else {
+		if p2, err = SqrtAfterMoney(l, p, rem); err != nil {
+			return 0, zero, p, err
+		}
+		p2 = umin(p2, hi)
+		if q, err = MoneyBetween(l, p, p2, Up); err != nil {
+			return 0, zero, p, err
+		}
+	}
+	if le(p2, p) {
+		return 0, zero, p, nil
+	}
+	dtU, err := TokensBetween(l, p, p2, Down)
+	if err != nil {
+		return 0, zero, p, err
+	}
+	dt := lo64(umin(dtU, n(held)))
+	if allAtTop && eq(p2, hi) {
+		// a held segment bought to its top sells all its tokens (its L is from those tokens: only rounding dust is left)
+		dt = held
+	}
+	if dt == 0 {
+		return 0, zero, p, nil
+	}
+	return dt, q, p2, nil
+}
+
+// cpDown is a token-limited step down a constant-product piece: (tokens, money, new √p). Tokens taken round up, money
+// paid down, the price falls no further than the tokens justify; a step that pays nothing moves nothing.
+func cpDown(l, lo, p U, rem uint64, held U) (uint64, U, U, error) {
+	if isZ(held) || le(p, lo) || isZ(l) {
+		return 0, zero, p, nil
+	}
+	xFull, err := TokensBetween(l, lo, p, Up)
+	if err != nil {
+		return 0, zero, p, err
+	}
+	var p2 U
+	var dx uint64
+	if ge(n(rem), xFull) {
+		p2, dx = lo, xFull.Uint64()
+	} else {
+		if p2, err = SqrtAfterTokens(l, p, n(rem)); err != nil {
+			return 0, zero, p, err
+		}
+		p2 = umax(p2, lo)
+		if ge(p2, p) {
+			return 0, zero, p, nil
+		}
+		x, err := TokensBetween(l, p2, p, Up)
+		if err != nil {
+			return 0, zero, p, err
+		}
+		dx = lo64(umin(x, n(rem)))
+	}
+	qU, err := MoneyBetween(l, p2, p, Down)
+	if err != nil {
+		return 0, zero, p, err
+	}
+	q := umin(qU, held)
+	if isZ(q) {
+		return 0, zero, p, nil
+	}
+	return dx, q, p2, nil
+}
+
+// flatCanBuy: a flat bid at s² holding money can still buy at least one whole token, for a nonzero payment.
+func flatCanBuy(s, money U) bool {
+	if isZ(money) {
+		return false
+	}
+	t, err := FlatTokensForMoney(s, money, Down)
+	if err != nil || lt(t, n(1)) {
+		return false
+	}
+	q, err := FlatMoneyForTokens(s, t, Down)
+	return err == nil && !isZ(q)
+}
+
+// EmptyBook is Book::empty.
+func EmptyBook(sqrtP U, feePpm [FeeLegs]uint32) Book { return Book{SqrtP: sqrtP, FeePpm: feePpm} }
+
+// PushRange appends a fresh range (all tokens for sale) at the top: SqrtA == SqrtB is flat; edges continue the last.
+func (b *Book) PushRange(sqrtA, sqrtB U, tokens uint64, kind, class uint8) error {
+	k := int(b.NRanges)
+	if k == RangesMax {
+		return ErrRowTooManyRanges
+	}
+	if isZ(sqrtA) || gt(sqrtA, sqrtB) || gt(sqrtB, SqrtTailEnd) || (k > 0 && !eq(b.Ranges[k-1].SqrtB, sqrtA)) {
+		return ErrSqrtRange
+	}
+	b.Ranges[k] = Range{SqrtA: sqrtA, SqrtB: sqrtB, Tokens: tokens, AskLeft: tokens, Kind: kind, Class: class}
+	b.NRanges++
+	return nil
+}
+
+func (b *Book) cpEdges(pc piece) (U, U) {
+	switch pc.k {
+	case pRange:
+		r := &b.Ranges[pc.i]
+		return umax(r.SqrtA, b.SqrtLMax), r.SqrtB
+	case pBand:
+		return b.BandEdge[pc.i+1], b.BandEdge[pc.i]
+	}
+	return b.SqrtF, b.SqrtF
+}
+
+func (b *Book) tokensOf(pc piece) uint64 {
+	switch pc.k {
+	case pRange:
+		return b.Ranges[pc.i].Held()
+	case pBand:
+		return b.BandTokens[pc.i]
+	}
+	return b.FloorTokens
+}
+
+func (b *Book) moneyOf(pc piece) U {
+	switch pc.k {
+	case pRange:
+		return b.Ranges[pc.i].Place
+	case pBand:
+		return b.BandMoney[pc.i]
+	}
+	return b.Floor
+}
+
+func (b *Book) isFlat(pc piece) bool {
+	switch pc.k {
+	case pRange:
+		return b.Ranges[pc.i].IsFlat()
+	case pFloor:
+		return true
+	}
+	return false
+}
+
+func (b *Book) flatS(pc piece) U {
+	if pc.k == pRange {
+		return b.Ranges[pc.i].SqrtA
+	}
+	return b.SqrtF
+}
+
+// flatBids: the Bonding flat's money bids (before graduation) while it can pay for a whole token.
+func (b *Book) flatBids(i int) bool {
+	r := &b.Ranges[i]
+	return r.IsFlat() && flatCanBuy(r.SqrtA, r.Place)
+}
+
+func (b *Book) floorBids() bool { return !isZ(b.SqrtF) && flatCanBuy(b.SqrtF, b.Floor) }
+
+// pieces in the walk's search order: ranges, segments, F (F only once f is set).
+func (b *Book) pieces() []piece {
+	ps := make([]piece, 0, RangesMax+BidsMax+1)
+	for i := 0; i < int(b.NRanges); i++ {
+		ps = append(ps, piece{pRange, i})
+	}
+	for i := 0; i < int(b.NBands); i++ {
+		ps = append(ps, piece{pBand, i})
+	}
+	if !isZ(b.SqrtF) {
+		ps = append(ps, piece{pFloor, 0})
+	}
+	return ps
+}
+
+func sumU(xs []U, k int) U {
+	var t U
+	for i := 0; i < k; i++ {
+		t = add(t, xs[i])
+	}
+	return t
+}
+
+// FOwn is f_own: F's money that bids (the F point less C + K's parked money, plus F's share inside every segment).
+func (b *Book) FOwn() U {
+	return add(sub(b.Floor, b.CkAtF), sumU(b.BandF[:], int(b.NBands)))
+}
+
+// FClaims is f_claims: F's claims on the tokens the segments hold.
+func (b *Book) FClaims() U { return sumU(b.BandFClaim[:], int(b.NBands)) }
+
+// CkMoney is ck_money: C + K's own money (its premium in every segment plus what waits at f).
+func (b *Book) CkMoney() U {
+	return add(sub(sumU(b.BandMoney[:], int(b.NBands)), sumU(b.BandF[:], int(b.NBands))), b.CkAtF)
+}
+
+// CkHeld is ck_held: the tokens C + K holds (in its segments and at the F point).
+func (b *Book) CkHeld() uint64 {
+	t := b.CkFloorTokens
+	for i := 0; i < int(b.NBands); i++ {
+		t += b.BandTokens[i]
+	}
+	return t
+}
+
+// BidMoney is F + C + K, the money bidding: Floor + the sum of BandMoney.
+func (b *Book) BidMoney() U { return add(b.Floor, sumU(b.BandMoney[:], int(b.NBands))) }
+
+// MoneyHeld is the bid money plus the money in place (the Bonding flat's, before graduation).
+func (b *Book) MoneyHeld() U {
+	t := b.BidMoney()
+	for i := 0; i < int(b.NRanges); i++ {
+		t = add(t, b.Ranges[i].Place)
+	}
+	return t
+}
+
+// TokensHeld is every token the book holds: for sale, bought back, and what F, K and C bought.
+func (b *Book) TokensHeld() U {
+	t := n(b.FloorTokens)
+	for i := 0; i < int(b.NBands); i++ {
+		t = add(t, n(b.BandTokens[i]))
+	}
+	for i := 0; i < int(b.NRanges); i++ {
+		t = add(t, n(b.Ranges[i].Held()))
+	}
+	return t
+}
+
+// ForSale is the sum of ask_left.
+func (b *Book) ForSale() uint64 {
+	var t uint64
+	for i := 0; i < int(b.NRanges); i++ {
+		t += b.Ranges[i].AskLeft
+	}
+	return t
+}
+
+// BoughtBack is the sum of back plus F's and the segments' tokens.
+func (b *Book) BoughtBack() uint64 {
+	t := b.FloorTokens
+	for i := 0; i < int(b.NRanges); i++ {
+		t += b.Ranges[i].Back
+	}
+	for i := 0; i < int(b.NBands); i++ {
+		t += b.BandTokens[i]
+	}
+	return t
+}
+
+// Check is Book::check (what a snapshot of the program's book must hold): contiguous non-decreasing ranges ending in a constant-product Tail at SqrtTailEnd, Bonding only
+// first, no money or buy-back in a range but the Bonding flat's, segments descending inside [f, l_max] with F's share
+// inside each, C + K's parked money inside the F point, the price in bounds.
+func (b *Book) Check() error { return b.check(true) }
+
+// CheckWalked is Check for a book a walk left: a sell can take a segment's last money while a unit of F's share stays
+// (the re-lay the program runs next dissolves it), so F's share may sit a unit over the segment's money.
+func (b *Book) CheckWalked() error { return b.check(false) }
+
+func (b *Book) check(fInside bool) error {
+	k := int(b.NRanges)
+	if k == 0 || k > RangesMax || int(b.NBands) > BidsMax || b.NC > b.NBands {
+		return ErrBookEmpty
+	}
+	if isZ(b.SqrtP) || gt(b.SqrtP, SqrtTailEnd) {
+		return ErrSqrtRange
+	}
+	for i := 0; i < k; i++ {
+		r := &b.Ranges[i]
+		if isZ(r.SqrtA) || gt(r.SqrtA, r.SqrtB) || (i > 0 && !eq(b.Ranges[i-1].SqrtB, r.SqrtA)) {
+			return ErrSqrtRange
+		}
+		if r.AskLeft+r.Back < r.AskLeft {
+			return ErrOverflow
+		}
+		if r.Kind != KindBonding && (!isZ(r.Place) || r.Back != 0) {
+			return ErrOverflow
+		}
+		if r.Kind == KindBonding && i != 0 {
+			return ErrSqrtRange
+		}
+	}
+	if !eq(b.Ranges[k-1].SqrtB, SqrtTailEnd) || b.Ranges[k-1].IsFlat() {
+		return ErrSqrtRange
+	}
+	nb := int(b.NBands)
+	if nb > 0 {
+		if gt(b.BandEdge[0], b.SqrtLMax) || lt(b.BandEdge[nb], b.SqrtF) {
+			return ErrSqrtRange
+		}
+		for i := 0; i < nb; i++ {
+			if gt(b.BandEdge[i+1], b.BandEdge[i]) {
+				return ErrSqrtRange
+			}
+			if fInside && gt(b.BandF[i], b.BandMoney[i]) {
+				return ErrOverflow
+			}
+		}
+	}
+	if gt(b.CkAtF, b.Floor) || b.CkFloorTokens > b.FloorTokens {
+		return ErrOverflow
+	}
+	return nil
+}
+
+// flatUp: the flat piece at p that sells (going up): F's tokens at f, then the flat ranges at p in order.
+func (b *Book) flatUp() (piece, bool) {
+	p := b.SqrtP
+	if !isZ(b.SqrtF) && eq(b.SqrtF, p) && b.FloorTokens > 0 {
+		return piece{pFloor, 0}, true
+	}
+	for i := 0; i < int(b.NRanges); i++ {
+		r := &b.Ranges[i]
+		if r.IsFlat() && eq(r.SqrtA, p) && r.Held() > 0 {
+			return piece{pRange, i}, true
+		}
+	}
+	return piece{}, false
+}
+
+// flatDown: the flat piece at p that buys (going down): the Bonding flat at p from the top, then F at f.
+func (b *Book) flatDown() (piece, bool) {
+	p := b.SqrtP
+	for i := int(b.NRanges) - 1; i >= 0; i-- {
+		if eq(b.Ranges[i].SqrtA, p) && b.flatBids(i) {
+			return piece{pRange, i}, true
+		}
+	}
+	if eq(b.SqrtF, p) && b.floorBids() {
+		return piece{pFloor, 0}, true
+	}
+	return piece{}, false
+}
+
+// cpPieceUp: the constant-product piece with lo <= p < hi and tokens.
+func (b *Book) cpPieceUp() (piece, bool) {
+	p := b.SqrtP
+	for _, pc := range b.pieces() {
+		lo, hi := b.cpEdges(pc)
+		if !b.isFlat(pc) && lt(lo, hi) && le(lo, p) && lt(p, hi) && b.tokensOf(pc) > 0 {
+			return pc, true
+		}
+	}
+	return piece{}, false
+}
+
+// bandDown: the segment with lo < p <= hi and money (no range bids under the price).
+func (b *Book) bandDown() (int, bool) {
+	p := b.SqrtP
+	for j := 0; j < int(b.NBands); j++ {
+		lo, hi := b.BandEdge[j+1], b.BandEdge[j]
+		if lt(lo, hi) && lt(lo, p) && le(p, hi) && !isZ(b.BandMoney[j]) {
+			return j, true
+		}
+	}
+	return 0, false
+}
+
+// nextUp: the lowest edge above p where something sells.
+func (b *Book) nextUp() (U, bool) {
+	p := b.SqrtP
+	var best U
+	found := false
+	for _, pc := range b.pieces() {
+		if b.tokensOf(pc) == 0 {
+			continue
+		}
+		var s U
+		if b.isFlat(pc) {
+			s = b.flatS(pc)
+		} else {
+			lo, hi := b.cpEdges(pc)
+			if !lt(lo, hi) {
+				continue
+			}
+			s = lo
+		}
+		if gt(s, p) && (!found || lt(s, best)) {
+			best, found = s, true
+		}
+	}
+	return best, found
+}
+
+// nextDown: the highest edge below p where something buys.
+func (b *Book) nextDown() (U, bool) {
+	p := b.SqrtP
+	var best U
+	found := false
+	for _, pc := range b.pieces() {
+		var s U
+		switch {
+		case pc.k == pRange && b.Ranges[pc.i].IsFlat():
+			if !b.flatBids(pc.i) {
+				continue
+			}
+			s = b.Ranges[pc.i].SqrtA
+		case pc.k == pFloor:
+			if !b.floorBids() {
+				continue
+			}
+			s = b.SqrtF
+		case pc.k == pBand:
+			lo, hi := b.cpEdges(pc)
+			if !lt(lo, hi) || isZ(b.BandMoney[pc.i]) {
+				continue
+			}
+			s = hi
+		default:
+			continue
+		}
+		if lt(s, p) && (!found || gt(s, best)) {
+			best, found = s, true
+		}
+	}
+	return best, found
+}
+
+func (b *Book) lUp(pc piece, hi U) (U, error) {
+	if pc.k == pRange {
+		return b.Ranges[pc.i].Liquidity()
+	}
+	return LiquidityForTokens(b.SqrtP, hi, n(b.tokensOf(pc)))
+}
+
+// graduate: Bonding sold out; its money becomes floor money, f0 is its price.
+func (b *Book) graduate() error {
+	r := &b.Ranges[0]
+	f, err := addM(b.Floor, r.Place)
+	if err != nil {
+		return err
+	}
+	b.Floor = f
+	r.Place = zero
+	b.SqrtF = r.SqrtA
+	b.SqrtLMax = umax(b.SqrtLMax, r.SqrtA)
+	b.Graduated = true
+	return nil
+}
+
+// floorRebuy: the F point sells take of its tokens for cost. The money joins the point; C + K's parked tokens are bought
+// back pro rata (floor(cost*xE / x) of the money back to its parked money, ceil(take*xE / x) of its tokens, capped).
+func (b *Book) floorRebuy(take uint64, cost U) error {
+	x0, xe := b.FloorTokens, b.CkFloorTokens
+	if xe > 0 {
+		back, err := mulDiv(cost, n(xe), n(x0), Down)
+		if err != nil {
+			return err
+		}
+		goneU, err := mulDiv(n(take), n(xe), n(x0), Up)
+		if err != nil {
+			return err
+		}
+		if b.CkAtF, err = addM(b.CkAtF, back); err != nil {
+			return err
+		}
+		b.CkFloorTokens -= lo64(umin(goneU, n(xe)))
+	}
+	f, err := addM(b.Floor, cost)
+	if err != nil {
+		return err
+	}
+	b.Floor = f
+	b.FloorTokens -= take
+	return nil
+}
+
+// bandRebuy: segment j sells dt of its tokens for q. The money joins the segment, and F's claim on them returns to F's
+// share inside it (min(q, claim, ceil(claim*dt / tokens))).
+func (b *Book) bandRebuy(j int, dt uint64, q U) error {
+	claim := b.BandFClaim[j]
+	r, err := mulDiv(claim, n(dt), n(b.BandTokens[j]), Up)
+	if err != nil {
+		return err
+	}
+	r = umin(umin(r, claim), q)
+	m, err := addM(b.BandMoney[j], q)
+	if err != nil {
+		return err
+	}
+	b.BandMoney[j] = m
+	b.BandTokens[j] -= dt
+	b.BandF[j] = add(b.BandF[j], r)
+	b.BandFClaim[j] = sub(claim, r)
+	return nil
+}
+
+// WalkUp spends at most budget (the book's amount, fees not included): a buy. It mutates the book; the caller works on a
+// copy when a refusal must move nothing.
+func (b *Book) WalkUp(budget U) (WalkUp, error) {
+	acc := NewFeeAcc(b.FeesNow())
+	return b.WalkUpFrom(budget, WalkUp{}, &acc, MaxWalkSteps)
+}
+
+// WalkUpFrom is WalkUp continuing an earlier walk w0 of the same trade (steps counted on, totals added); every step's money
+// is charged into acc. maxSteps is the trade's bound (MaxWalkSteps, or a chain's lower one: SolBuyWalkSteps).
+func (b *Book) WalkUpFrom(budget U, w0 WalkUp, acc *FeeAcc, maxSteps uint8) (WalkUp, error) {
+	rem := budget
+	w := w0
+	w.BudgetHit = false
+	for !isZ(rem) {
+		if w.Steps >= min(maxSteps, MaxWalkSteps) {
+			w.BudgetHit = true
+			break
+		}
+		w.Steps++
+		if pc, ok := b.flatUp(); ok {
+			s := b.flatS(pc)
+			can, err := FlatTokensForMoney(s, rem, Down)
+			if err != nil {
+				return w, err
+			}
+			take := lo64(umin(can, n(b.tokensOf(pc))))
+			if take == 0 {
+				break
+			}
+			cost, err := FlatMoneyForTokens(s, n(take), Up)
+			if err != nil {
+				return w, err
+			}
+			rem = sub(rem, cost)
+			w.Money = add(w.Money, cost)
+			w.Tokens += take
+			if err := b.charge(acc, cost); err != nil {
+				return w, err
+			}
+			if pc.k == pFloor {
+				if err := b.floorRebuy(take, cost); err != nil {
+					return w, err
+				}
+				w.FromResale += take
+			} else {
+				r := &b.Ranges[pc.i]
+				tb := min(take, r.Back)
+				r.Back -= tb
+				r.AskLeft -= take - tb
+				w.FromResale += tb
+				w.FromFirst += take - tb
+				if r.Kind == KindBonding {
+					if r.Place, err = addM(r.Place, cost); err != nil {
+						return w, err
+					}
+					if r.Held() == 0 && !b.Graduated {
+						if err := b.graduate(); err != nil {
+							return w, err
+						}
+						w.GraduatedNow = true
+					}
+				} else {
+					// a flat issuance piece: its first-time money goes to the split
+					b.SqrtLMax = umax(b.SqrtLMax, s)
+					w.FirstMoney = add(w.FirstMoney, cost)
+				}
+			}
+			if b.tokensOf(pc) > 0 {
+				break // the money ran out at this price
+			}
+			continue
+		}
+		if pc, ok := b.cpPieceUp(); ok {
+			_, hi := b.cpEdges(pc)
+			l, err := b.lUp(pc, hi)
+			if err != nil {
+				return w, err
+			}
+			var moved bool
+			if pc.k == pRange {
+				if moved, err = b.rangeUp(pc.i, l, hi, &rem, &w, acc); err != nil {
+					return w, err
+				}
+			} else {
+				dt, q, p2, err := cpUp(l, b.SqrtP, hi, rem, b.tokensOf(pc), true)
+				if err != nil {
+					return w, err
+				}
+				if dt > 0 {
+					if err := b.bandRebuy(pc.i, dt, q); err != nil {
+						return w, err
+					}
+					b.SqrtP = p2
+					rem = sub(rem, q)
+					w.Money = add(w.Money, q)
+					w.Tokens += dt
+					w.FromResale += dt
+					if err := b.charge(acc, q); err != nil {
+						return w, err
+					}
+				}
+				moved = dt > 0
+			}
+			if eq(b.SqrtP, hi) {
+				continue
+			}
+			if !moved && !isZ(rem) {
+				// the slice [p, hi) holds no whole token (segment dust a rounding left under its top): the tokens
+				// stay, the walk looks further up. A range's sliver is first-time issuance: the buyer pays its
+				// money (rounded up, against the trader) for no token, or the walk stops there
+				all, err := TokensBetween(l, b.SqrtP, hi, Down)
+				if err != nil {
+					return w, err
+				}
+				if isZ(all) {
+					if pc.k == pRange {
+						q, err := MoneyBetween(l, b.SqrtP, hi, Up)
+						if err != nil {
+							return w, err
+						}
+						if gt(q, rem) {
+							break
+						}
+						rem = sub(rem, q)
+						w.Money = add(w.Money, q)
+						if err := b.charge(acc, q); err != nil {
+							return w, err
+						}
+						b.SqrtLMax = umax(b.SqrtLMax, hi)
+					}
+					b.SqrtP = hi
+					continue
+				}
+			}
+			if !moved || isZ(rem) || b.tokensOf(pc) > 0 {
+				break
+			}
+			continue // the piece ran dry short of its top (dust): look further up
+		}
+		s, ok := b.nextUp()
+		if !ok {
+			break
+		}
+		b.SqrtP = s
+	}
+	return w, nil
+}
+
+// rangeUp is one constant-product row range going up: first-time tokens from AskLeft, their money for the split.
+func (b *Book) rangeUp(i int, l, hi U, rem *U, w *WalkUp, acc *FeeAcc) (bool, error) {
+	dt, q, p2, err := cpUp(l, b.SqrtP, hi, *rem, b.Ranges[i].AskLeft, false)
+	if err != nil || dt == 0 {
+		return false, err
+	}
+	b.Ranges[i].AskLeft -= dt
+	b.SqrtP = p2
+	b.SqrtLMax = umax(b.SqrtLMax, p2)
+	*rem = sub(*rem, q)
+	w.Money = add(w.Money, q)
+	w.FirstMoney = add(w.FirstMoney, q)
+	w.Tokens += dt
+	w.FromFirst += dt
+	return true, b.charge(acc, q)
+}
+
+// WalkDown takes at most tokens from a seller: a sell. It mutates the book.
+func (b *Book) WalkDown(tokens uint64) (WalkDown, error) {
+	acc := NewFeeAcc(b.FeesNow())
+	return b.WalkDownAcc(tokens, &acc)
+}
+
+// WalkDownAcc is WalkDown, every step's money charged into acc at the price where the step ends.
+func (b *Book) WalkDownAcc(tokens uint64, acc *FeeAcc) (WalkDown, error) {
+	rem := tokens
+	var w WalkDown
+	for rem > 0 {
+		if w.Steps == MaxWalkSteps {
+			w.BudgetHit = true
+			break
+		}
+		w.Steps++
+		if pc, ok := b.flatDown(); ok {
+			s := b.flatS(pc)
+			money := b.moneyOf(pc)
+			can, err := FlatTokensForMoney(s, money, Down)
+			if err != nil {
+				return w, err
+			}
+			take := lo64(umin(can, n(rem)))
+			var q U
+			if take != 0 {
+				qU, err := FlatMoneyForTokens(s, n(take), Down)
+				if err != nil {
+					return w, err
+				}
+				q = umin(qU, money)
+			}
+			if isZ(q) {
+				break
+			}
+			rem -= take
+			w.Tokens += take
+			w.Money = add(w.Money, q)
+			if err := b.charge(acc, q); err != nil {
+				return w, err
+			}
+			if pc.k == pFloor {
+				// C + K's parked money pays first; the tokens it buys are C + K's
+				if ce := umin(q, b.CkAtF); !isZ(ce) {
+					xeU, err := FlatTokensForMoney(s, ce, Down)
+					if err != nil {
+						return w, err
+					}
+					if b.CkFloorTokens, err = add64(b.CkFloorTokens, lo64(umin(xeU, n(take)))); err != nil {
+						return w, err
+					}
+					b.CkAtF = sub(b.CkAtF, ce)
+				}
+				b.Floor = sub(b.Floor, q)
+				var err error
+				if b.FloorTokens, err = add64(b.FloorTokens, take); err != nil {
+					return w, err
+				}
+				w.FromF = add(w.FromF, q)
+			} else {
+				r := &b.Ranges[pc.i]
+				r.Place = sub(r.Place, q)
+				var err error
+				if r.Back, err = add64(r.Back, take); err != nil {
+					return w, err
+				}
+				w.FromPlace = add(w.FromPlace, q)
+			}
+			continue
+		}
+		if j, ok := b.bandDown(); ok {
+			lo := b.BandEdge[j+1]
+			l, err := LiquidityForMoney(lo, b.SqrtP, b.BandMoney[j])
+			if err != nil {
+				return w, err
+			}
+			dx, q, p2, err := cpDown(l, lo, b.SqrtP, rem, b.BandMoney[j])
+			if err != nil {
+				return w, err
+			}
+			if dx == 0 {
+				// the slice (lo, p] pays nothing for all it holds (dust a rounding left over a sliver): the money stays
+				// and the walk looks further down
+				all, err := MoneyBetween(l, lo, b.SqrtP, Down)
+				if err != nil {
+					return w, err
+				}
+				if isZ(all) {
+					s, ok := b.nextDown()
+					if !ok {
+						break
+					}
+					b.SqrtP = s
+					continue
+				}
+				break
+			}
+			// F pays its f per token out of its share; C + K pays the premium
+			dfU, err := FlatMoneyForTokens(b.SqrtF, n(dx), Down)
+			if err != nil {
+				return w, err
+			}
+			dF := umin(umin(dfU, b.BandF[j]), q)
+			// the seller never takes F's share past its f per token: what rounding leaves of it stays F's
+			q = umin(q, add(sub(b.BandMoney[j], b.BandF[j]), dF))
+			claim, err := addM(b.BandFClaim[j], dF)
+			if err != nil {
+				return w, err
+			}
+			tk, err := add64(b.BandTokens[j], dx)
+			if err != nil {
+				return w, err
+			}
+			b.BandF[j] = sub(b.BandF[j], dF)
+			b.BandFClaim[j] = claim
+			b.BandMoney[j] = sub(b.BandMoney[j], q)
+			b.BandTokens[j] = tk
+			if j < int(b.NC) {
+				w.FromC = add(w.FromC, q)
+			} else {
+				w.FromK = add(w.FromK, q)
+			}
+			b.SqrtP = p2
+			rem -= dx
+			w.Tokens += dx
+			w.Money = add(w.Money, q)
+			if err := b.charge(acc, q); err != nil {
+				return w, err
+			}
+			if eq(p2, lo) && !isZ(b.BandMoney[j]) {
+				// a segment walked to its bottom: the rounding rest left in it joins F's point (F's share as F's, the
+				// rest as C + K's money at f), so F's flat bid below sees it
+				fl, err := addM(b.Floor, b.BandMoney[j])
+				if err != nil {
+					return w, err
+				}
+				ck, err := addM(b.CkAtF, sub(b.BandMoney[j], b.BandF[j]))
+				if err != nil {
+					return w, err
+				}
+				b.Floor, b.CkAtF = fl, ck
+				b.BandMoney[j], b.BandF[j] = U{}, U{}
+			}
+			if eq(p2, lo) || isZ(b.BandMoney[j]) {
+				if !eq(p2, lo) {
+					// ran dry short of its bottom (dust): look further down
+					s, ok := b.nextDown()
+					if !ok {
+						break
+					}
+					b.SqrtP = s
+				}
+				continue
+			}
+			break
+		}
+		s, ok := b.nextDown()
+		if !ok {
+			break
+		}
+		b.SqrtP = s
+	}
+	return w, nil
+}
+
+// lo64 is `as u64` on a value already under 2^64.
+func lo64(x U) uint64 { return x.Uint64() }
diff --git a/pkg/liquidity-source/floor-amm/math/v2/fees.go b/pkg/liquidity-source/floor-amm/math/v2/fees.go
new file mode 100644
index 00000000..b1e0350a
--- /dev/null
+++ b/pkg/liquidity-source/floor-amm/math/v2/fees.go
@@ -0,0 +1,228 @@
+package floorv2
+
+// The five fee legs (Rust: v2::fees): backing, team, platform, $FLOOR, holder, each ⌈amount·ppm ÷ 10⁶⌉ on the book's amount.
+
+const (
+	FeeLegs       = 5
+	FeeDefaultPpm = 100
+	LegBacking    = 0
+	LegTeam       = 1
+	LegPlatform   = 2
+	LegFloor      = 3
+	LegHolder     = 4
+	ppm           = 1_000_000
+)
+
+// DefaultFeePpm is v2::fees::DEFAULT_FEE_PPM.
+var DefaultFeePpm = [FeeLegs]uint32{FeeDefaultPpm, FeeDefaultPpm, FeeDefaultPpm, FeeDefaultPpm, FeeDefaultPpm}
+
+// FeeLeg is ⌈amount·ppm ÷ 10⁶⌉ (money u128; ppm ≤ 10⁶ keeps it ≤ amount).
+func FeeLeg(amount U, p uint32) U {
+	v, err := mulDiv(amount, n(uint64(p)), n(ppm), Up)
+	if err != nil || !fits128(v) {
+		return amount
+	}
+	return v
+}
+
+// FeeLegsOf is v2::fees::fee_legs.
+func FeeLegsOf(amount U, p *[FeeLegs]uint32) [FeeLegs]U {
+	var f [FeeLegs]U
+	for i := range f {
+		f[i] = FeeLeg(amount, p[i])
+	}
+	return f
+}
+
+// FeeTotal is Σ legs, saturating at 2^128 − 1.
+func FeeTotal(f *[FeeLegs]U) U {
+	var t U
+	for _, x := range f {
+		t = satAdd128(t, x)
+	}
+	return t
+}
+
+func satAdd128(a, b U) U {
+	c := add(a, b)
+	if !fits128(c) {
+		return sub(pow2(128), n(1))
+	}
+	return c
+}
+
+// GrossForNet is net + Σ legs(net); ok = false past u128.
+func GrossForNet(net U, p *[FeeLegs]uint32) (U, bool) {
+	f := FeeLegsOf(net, p)
+	g, err := addM(net, FeeTotal(&f))
+	return g, err == nil
+}
+
+// NetFromGross is the largest net with GrossForNet(net) ≤ gross.
+func NetFromGross(gross U, p *[FeeLegs]uint32) U {
+	var sum uint64
+	for _, x := range p {
+		sum += uint64(x)
+	}
+	net, err := mulDiv(gross, n(ppm), n(ppm+sum), Down)
+	if err != nil {
+		net = zero
+	}
+	one := n(1)
+	for lt(net, gross) {
+		g, ok := GrossForNet(add(net, one), p)
+		if !ok || gt(g, gross) {
+			break
+		}
+		net = add(net, one)
+	}
+	for !isZ(net) {
+		g, ok := GrossForNet(net, p)
+		if ok && le(g, gross) {
+			break
+		}
+		net = sub(net, one)
+	}
+	return net
+}
+
+// log2X64 is fixed::log2_x64: log2(v) for v ≥ 1 as Q64.64,
+// rounded down; false for 0.
+func log2X64(v U) (U, bool) {
+	if isZ(v) {
+		return zero, false
+	}
+	msb := uint(v.BitLen() - 1)
+	var m U
+	m.Lsh(&v, 127-msb)
+	var frac uint64
+	for i := 0; i < 64; i++ {
+		var p, bit U
+		p.Mul(&m, &m)
+		bit.Rsh(&p, 255)
+		frac = frac<<1 | bit.Uint64()
+		if bit.Uint64() == 1 {
+			m.Rsh(&p, 128)
+		} else {
+			m.Rsh(&p, 127)
+		}
+	}
+	var r U
+	r.SetUint64(uint64(msb))
+	r.Lsh(&r, 64)
+	var f U
+	f.SetUint64(frac)
+	r.Or(&r, &f)
+	return r, true
+}
+
+// PregradPpm is v2::fees::PREGRAD_PPM: before graduation Platform 0.40 % + $FLOOR 0.10 %, flat; the other
+// legs 0.
+var PregradPpm = [FeeLegs]uint32{0, 0, 4_000, 1_000, 0}
+
+// RatesAt is v2::fees::rates_at: PregradPpm while not graduated, unless own (a genesis book keeps its row's curve);
+// from graduation on the curve (PpmAt).
+func RatesAt(graduated, own bool, end, start *[FeeLegs]uint32, sqrtA, sqrtB, sqrtP U) [FeeLegs]uint32 {
+	if !graduated && !own {
+		return PregradPpm
+	}
+	return PpmAt(end, start, sqrtA, sqrtB, sqrtP)
+}
+
+// PpmAt is v2::fees::ppm_at: the legs' rates at sqrtP on a fee curve. Each leg is start at or under sqrtA, end at or over
+// sqrtB, between them even in log2 of the price: ⌈(start·w + end·(2⁶⁴ − w)) ÷ 2⁶⁴⌉. sqrtB == 0 is no curve.
+func PpmAt(end, start *[FeeLegs]uint32, sqrtA, sqrtB, sqrtP U) [FeeLegs]uint32 {
+	if isZ(sqrtB) || ge(sqrtP, sqrtB) {
+		return *end
+	}
+	if le(sqrtP, sqrtA) {
+		return *start
+	}
+	lg := func(x U) U { v, _ := log2X64(x); return v }
+	la, lb, lp := lg(sqrtA), lg(sqrtB), lg(sqrtP)
+	one := pow2(64)
+	var w U
+	if gt(lb, la) {
+		var d U
+		if gt(lb, lp) {
+			d = sub(lb, lp)
+		}
+		q, err := mulDiv(d, one, sub(lb, la), Down)
+		if err != nil {
+			q = zero
+		}
+		w = umin(q, one)
+	}
+	var f [FeeLegs]uint32
+	for i := range f {
+		x := add(mul(n(uint64(start[i])), w), mul(n(uint64(end[i])), sub(one, w)))
+		x = add(x, sub(one, n(1)))
+		x.Rsh(&x, 64)
+		f[i] = uint32(x.Uint64())
+	}
+	return f
+}
+
+// Cheaper is, leg by leg, the lower of two rate sets (a buy's re-fill sizes at the cheaper of where it started and where
+// its first walk ended).
+func Cheaper(a, b *[FeeLegs]uint32) [FeeLegs]uint32 {
+	var c [FeeLegs]uint32
+	for i := range c {
+		c[i] = min(a[i], b[i])
+	}
+	return c
+}
+
+// FeeAcc is v2::fees::FeeAcc: a trade's fee legs on the curve, step by step. Each walk step's money q is charged at the
+// cheaper, leg by leg, of the rates at the TRADE's start (Pre) and where the STEP ends; each leg is ⌈Σ q·rate ÷ 10⁶⌉ once
+// (Whole plus a remainder under 10⁶). Without a curve every step is at Pre: bit for bit FeeLeg.
+type FeeAcc struct {
+	Pre        [FeeLegs]uint32
+	Whole, Rem [FeeLegs]U
+}
+
+// NewFeeAcc starts a charge at the trade's start rates.
+func NewFeeAcc(pre [FeeLegs]uint32) FeeAcc { return FeeAcc{Pre: pre} }
+
+// Add charges one step's money q at min(Pre, at); false past u128.
+func (a *FeeAcc) Add(q U, at *[FeeLegs]uint32) bool {
+	m := n(ppm)
+	var qh, ql U
+	qh.Div(&q, &m)
+	ql.Mod(&q, &m)
+	w, r2 := a.Whole, a.Rem
+	for i := 0; i < FeeLegs; i++ {
+		r := n(uint64(min(a.Pre[i], at[i])))
+		lo := mul(ql, r)
+		var lm, ld, rd U
+		lm.Mod(&lo, &m)
+		ld.Div(&lo, &m)
+		rem := add(r2[i], lm)
+		rd.Div(&rem, &m)
+		x := add(add(add(w[i], mul(qh, r)), ld), rd)
+		if !fits128(x) {
+			return false
+		}
+		w[i] = x
+		r2[i].Mod(&rem, &m)
+	}
+	a.Whole, a.Rem = w, r2
+	return true
+}
+
+// Legs is the legs charged: ⌈Σ q·rate ÷ 10⁶⌉ each (saturating at u128).
+func (a *FeeAcc) Legs() [FeeLegs]U {
+	var f [FeeLegs]U
+	max := sub(pow2(128), n(1))
+	for i := range f {
+		v := a.Whole[i]
+		if !isZ(a.Rem[i]) {
+			v = add(v, n(1))
+		}
+		if gt(v, max) {
+			v = max
+		}
+		f[i] = v
+	}
+	return f
+}
diff --git a/pkg/liquidity-source/floor-amm/math/v2/golden_launch_test.go b/pkg/liquidity-source/floor-amm/math/v2/golden_launch_test.go
