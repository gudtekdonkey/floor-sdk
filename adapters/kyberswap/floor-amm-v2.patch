@@ -0,0 +1,28 @@
+package flooramm
+
+import (
+	"bytes"
+
+	"github.com/ethereum/go-ethereum/accounts/abi"
+)
+
+var floorAmmABI, floorAmmViewsABI abi.ABI
+
+const (
+	methodLaunchCount = "launchCount"
+	methodLaunchToken = "launchToken"
+	methodLaunchQuote = "launchQuote"
+	methodQuoteEntry  = "quoteEntry"
+	methodLaunchBook  = "launchBook"
+	methodFeeCurve    = "launchFeeCurve"
+)
+
+func init() {
+	var err error
+	if floorAmmABI, err = abi.JSON(bytes.NewReader(floorAmmJson)); err != nil {
+		panic(err)
+	}
+	if floorAmmViewsABI, err = abi.JSON(bytes.NewReader(floorAmmViewsV2Json)); err != nil {
+		panic(err)
+	}
+}
