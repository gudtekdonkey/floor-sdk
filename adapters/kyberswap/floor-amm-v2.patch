--- /dev/null
+++ b/pkg/liquidity-source/floor-amm/math/v2/golden_launch_test.go
@@ -0,0 +1,105 @@
+package floorv2
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/holiman/uint256"
+)
+
+// TestGoldenClimb replays testdata/climb.json (85 buys up a launch's climb) receipt for receipt.
+func TestGoldenClimb(t *testing.T) {
+	counts := replayBook(t, "climb")
+	if counts["buy"] != 85 || len(counts) != 1 {
+		t.Fatalf("climb: want 85 buys, got %v", counts)
+	}
+}
+
+type lbBounds map[string]string
+
+func (b lbBounds) u(t *testing.T, k string) U {
+	t.Helper()
+	s, ok := b[k]
+	if !ok {
+		return U{}
+	}
+	return *uint256.MustFromDecimal(s)
+}
+
+// TestGoldenLaunchBook bounds-checks testdata/launch_book.json (the engine's launch book, 1,020 trades): the fees are
+// exact on the book amount, the trader never beats the engine, and the outputs sit within the printed [min, max].
+func TestGoldenLaunchBook(t *testing.T) {
+	buys, sells, refused := 0, 0, 0
+	for _, c := range loadGolden(t, "launch_book") {
+		var o lbBounds
+		if err := json.Unmarshal(c.Out, &o); err != nil {
+			t.Fatal(err)
+		}
+		bk := bookFromJSON(t, c.StateIn)
+		// the engine book charges its five legs at fee_ppm in Bonding too (own fees), not the presets' two
+		bk.OwnFees = true
+		switch c.Fn {
+		case "buy":
+			buys++
+			g := gU(t, c.Args["gross"])
+			r, err := Buy(&bk, g, 0)
+			if err != nil {
+				refused++
+				if !isZ(o.u(t, "tokens_out_min")) || (err != ErrNothingToDo && err != ErrBookEmpty) {
+					t.Errorf("%s: buy %s refused %v with tokens_out_min %s", c.ID, g.Dec(), err, o["tokens_out_min"])
+				}
+				continue
+			}
+			if FeeLegsOf(r.Net, &bk.FeePpm) != r.Fees {
+				t.Errorf("%s: fees are not exact on the book amount", c.ID)
+			}
+			if r.Tokens > g64u(o.u(t, "tokens_out_max")) || r.Tokens < g64u(o.u(t, "tokens_out_min")) {
+				t.Errorf("%s: tokens %d outside [%s, %s]", c.ID, r.Tokens, o["tokens_out_min"], o["tokens_out_max"])
+			}
+			if gt(r.Net, o.u(t, "book_in_max")) || lt(r.Net, o.u(t, "book_in_min")) {
+				t.Errorf("%s: net %s outside [%s, %s]", c.ID, r.Net.Dec(), o["book_in_min"], o["book_in_max"])
+			}
+			if m := o.u(t, "p_after_max"); gt(r.SqrtAfter, add(m, slackOf(m))) {
+				t.Errorf("%s: sqrt_after %s above the engine's %s (+1e-7 rounding slack)", c.ID, r.SqrtAfter.Dec(), o["p_after_max"])
+			}
+		case "sell":
+			sells++
+			x := g64(t, c.Args["tokens"])
+			r, err := Sell(&bk, x, U{})
+			if err != nil {
+				refused++
+				small := o.u(t, "book_out_min")
+				if (err != ErrNothingToDo && err != ErrBookEmpty) || gt(small, o.u(t, "book_out_max")) {
+					t.Errorf("%s: sell %d refused %v", c.ID, x, err)
+				}
+				continue
+			}
+			if FeeLegsOf(r.Gross, &bk.FeePpm) != r.Fees {
+				t.Errorf("%s: fees are not exact on the gross", c.ID)
+			}
+			filled := r.TokensIn - r.Unfilled
+			if gt(r.Gross, o.u(t, "book_out_max")) || lt(r.Gross, o.u(t, "book_out_min")) {
+				t.Errorf("%s: gross %s outside [%s, %s]", c.ID, r.Gross.Dec(), o["book_out_min"], o["book_out_max"])
+			}
+			if filled > g64u(o.u(t, "tokens_in_max")) || filled < g64u(o.u(t, "tokens_in_min")) {
+				t.Errorf("%s: filled %d outside [%s, %s]", c.ID, filled, o["tokens_in_min"], o["tokens_in_max"])
+			}
+			if p := o.u(t, "p_after_min"); lt(r.SqrtAfter, p) {
+				t.Errorf("%s: sqrt_after %s below the engine's %s", c.ID, r.SqrtAfter.Dec(), p.Dec())
+			}
+		default:
+			t.Fatalf("%s: unknown fn %q", c.ID, c.Fn)
+		}
+	}
+	if buys+sells != 1020 {
+		t.Fatalf("launch_book: want 1,020 trades, got %d buys + %d sells", buys, sells)
+	}
+	t.Logf("%d buys, %d sells, %d refused", buys, sells, refused)
+}
+
+func g64u(v U) uint64 { return v.Uint64() }
+
+// slackOf is the engine bound's rounding slack on a price: the printed p_after is the ideal at the amount actually traded;
+// the engine check (research/v2-model/check.py) widens it by the walk's money slack, which a tenth of a millionth covers
+// on every printed case (the measured worst is 1.6e-8).
+func slackOf(m U) U { var z U; z.Div(&m, uint256.NewInt(10_000_000)); return z }
diff --git a/pkg/liquidity-source/floor-amm/math/v2/golden_test.go b/pkg/liquidity-source/floor-amm/math/v2/golden_test.go
new file mode 100644
index 00000000..82903953
--- /dev/null
+++ b/pkg/liquidity-source/floor-amm/math/v2/golden_test.go
@@ -0,0 +1,430 @@
+package floorv2
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"reflect"
+	"strconv"
+	"testing"
+
+	"github.com/holiman/uint256"
+)
+
+// golden/v2 (book, fees, supply) and the walk-cap family (walkcap) replayed bit for bit: every case's outputs and, for buy / sell, the trader's receipt and
+// the parts of the book after that the walk alone decides (the program's split and re-lay of C + K are not ported: no
+// quote reads them).
+// testdata/v2 is copied from floor-math by adapters' fixtures_v2.py, walkcap.json printed by walkcap_gen from floor-math's
+// own buy_steps_with; never edited by hand.
+
+type gCase struct {
+	ID       string                     `json:"id"`
+	Fn       string                     `json:"fn"`
+	StateIn  map[string]json.RawMessage `json:"state_in"`
+	Args     map[string]json.RawMessage `json:"args"`
+	Out      json.RawMessage            `json:"out"`
+	StateOut json.RawMessage            `json:"state_out"`
+}
+
+func loadGolden(t *testing.T, section string) []gCase {
+	t.Helper()
+	raw, err := os.ReadFile("testdata/" + section + ".json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var f struct {
+		Schema  string  `json:"schema"`
+		Version int     `json:"version"`
+		Cases   []gCase `json:"cases"`
+	}
+	if err := json.Unmarshal(raw, &f); err != nil {
+		t.Fatal(err)
+	}
+	if f.Schema != "floor-math/v2/"+section || f.Version != 1 || len(f.Cases) == 0 {
+		t.Fatalf("%s: schema %q v%d, %d cases", section, f.Schema, f.Version, len(f.Cases))
+	}
+	return f.Cases
+}
+
+func str(t *testing.T, m json.RawMessage) string {
+	var s string
+	if err := json.Unmarshal(m, &s); err != nil {
+		t.Fatalf("not a string: %s", m)
+	}
+	return s
+}
+
+func gU(t *testing.T, m json.RawMessage) U { return *uint256.MustFromDecimal(str(t, m)) }
+func g64(t *testing.T, m json.RawMessage) uint64 {
+	v, err := strconv.ParseUint(str(t, m), 10, 64)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return v
+}
+
+func gInt(t *testing.T, m json.RawMessage) uint64 {
+	var v uint64
+	if err := json.Unmarshal(m, &v); err != nil {
+		t.Fatal(err)
+	}
+	return v
+}
+
+func gStrs(t *testing.T, m json.RawMessage) []json.RawMessage {
+	var a []json.RawMessage
+	if err := json.Unmarshal(m, &a); err != nil {
+		t.Fatal(err)
+	}
+	return a
+}
+
+func bookFromJSON(t *testing.T, s map[string]json.RawMessage) Book {
+	var b Book
+	b.SqrtP, b.SqrtF, b.SqrtLMax = gU(t, s["sqrt_p"]), gU(t, s["sqrt_f"]), gU(t, s["sqrt_l_max"])
+	b.Floor, b.FloorTokens = gU(t, s["floor"]), g64(t, s["floor_tokens"])
+	b.NBands, b.NC = uint8(gInt(t, s["n_bands"])), uint8(gInt(t, s["n_c"]))
+	for i, v := range gStrs(t, s["band_edge"]) {
+		b.BandEdge[i] = gU(t, v)
+	}
+	for i, v := range gStrs(t, s["band_money"]) {
+		b.BandMoney[i] = gU(t, v)
+	}
+	for i, v := range gStrs(t, s["band_tokens"]) {
+		b.BandTokens[i] = g64(t, v)
+	}
+	for i, v := range gStrs(t, s["band_f"]) {
+		b.BandF[i] = gU(t, v)
+	}
+	for i, v := range gStrs(t, s["band_f_claim"]) {
+		b.BandFClaim[i] = gU(t, v)
+	}
+	b.CkAtF, b.CkFloorTokens = gU(t, s["ck_at_f"]), g64(t, s["ck_floor_tokens"])
+	for i, v := range gStrs(t, s["fee_ppm"]) {
+		b.FeePpm[i] = uint32(g64(t, v))
+	}
+	if raw, ok := s["fee_start_ppm"]; ok {
+		for i, v := range gStrs(t, raw) {
+			b.FeeStartPpm[i] = uint32(g64(t, v))
+		}
+		b.SqrtFeeA, b.SqrtFeeB = gU(t, s["sqrt_fee_a"]), gU(t, s["sqrt_fee_b"])
+	}
+	if err := json.Unmarshal(s["graduated"], &b.Graduated); err != nil {
+		t.Fatal(err)
+	}
+	b.NRanges = uint8(gInt(t, s["n_ranges"]))
+	var rs []map[string]json.RawMessage
+	if err := json.Unmarshal(s["ranges"], &rs); err != nil {
+		t.Fatal(err)
+	}
+	for i, r := range rs {
+		b.Ranges[i] = Range{SqrtA: gU(t, r["sqrt_a"]), SqrtB: gU(t, r["sqrt_b"]), Tokens: g64(t, r["tokens"]),
+			AskLeft: g64(t, r["ask_left"]), Back: g64(t, r["back"]), Place: gU(t, r["place"]),
+			ThetaBps: uint16(gInt(t, r["theta_bps"])),
+			PsiBps:   uint16(gInt(t, r["psi_bps"])), Kind: uint8(gInt(t, r["kind"])), Class: uint8(gInt(t, r["class"]))}
+	}
+	return b
+}
+
+func d64(v uint64) string { return strconv.FormatUint(v, 10) }
+func dU(v U) string       { return v.Dec() }
+
+func arr64[T uint64 | uint32](a []T) []string {
+	s := make([]string, len(a))
+	for i, v := range a {
+		s[i] = d64(uint64(v))
+	}
+	return s
+}
+
+func arrU(a []U) []string {
+	s := make([]string, len(a))
+	for i, v := range a {
+		s[i] = dU(v)
+	}
+	return s
+}
+
+func bookMap(b *Book) map[string]any {
+	edges := make([]string, len(b.BandEdge))
+	for i, v := range b.BandEdge {
+		edges[i] = dU(v)
+	}
+	rs := make([]map[string]any, b.NRanges)
+	for i := range rs {
+		r := b.Ranges[i]
+		rs[i] = map[string]any{"sqrt_a": dU(r.SqrtA), "sqrt_b": dU(r.SqrtB), "tokens": d64(r.Tokens),
+			"ask_left": d64(r.AskLeft), "back": d64(r.Back), "place": dU(r.Place),
+			"theta_bps": r.ThetaBps, "psi_bps": r.PsiBps, "kind": r.Kind, "class": r.Class}
+	}
+	m := map[string]any{"sqrt_p": dU(b.SqrtP), "sqrt_f": dU(b.SqrtF), "sqrt_l_max": dU(b.SqrtLMax),
+		"floor": dU(b.Floor), "floor_tokens": d64(b.FloorTokens),
+		"n_bands": b.NBands, "n_c": b.NC, "band_edge": edges, "band_money": arrU(b.BandMoney[:]), "band_tokens": arr64(b.BandTokens[:]),
+		"band_f": arrU(b.BandF[:]), "band_f_claim": arrU(b.BandFClaim[:]), "ck_at_f": dU(b.CkAtF),
+		"ck_floor_tokens": d64(b.CkFloorTokens), "fee_ppm": arr64(b.FeePpm[:]), "graduated": b.Graduated,
+		"n_ranges": b.NRanges, "ranges": rs}
+	if b.FeeStartPpm != [FeeLegs]uint32{} || !isZ(b.SqrtFeeA) || !isZ(b.SqrtFeeB) {
+		m["fee_start_ppm"], m["sqrt_fee_a"], m["sqrt_fee_b"] = arr64(b.FeeStartPpm[:]), dU(b.SqrtFeeA), dU(b.SqrtFeeB)
+	}
+	return m
+}
+
+func errMap(err error) map[string]any { return map[string]any{"err": err.Error()} }
+
+// same compares a Go value with the golden's JSON after one round trip through encoding/json.
+func same(t *testing.T, id, what string, got any, want json.RawMessage) {
+	t.Helper()
+	raw, err := json.Marshal(got)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var g, w any
+	_ = json.Unmarshal(raw, &g)
+	if err := json.Unmarshal(want, &w); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(g, w) {
+		t.Errorf("%s %s:\n got  %s\n want %s", id, what, raw, want)
+	}
+}
+
+// walkKeys are the book fields the walk alone decides: the split and the re-lay (not ported) move none of them.
+var walkKeys = []string{"sqrt_p", "sqrt_l_max", "floor_tokens", "ck_floor_tokens", "graduated", "n_ranges", "ranges"}
+
+// programKeys are a receipt's parts the program computes after the walk (the split of a buy, the re-lay of a trade).
+var programKeys = map[string]bool{"split": true, "relay": true}
+
+// sameOut compares a receipt with the golden one on every field the walk and the fee legs decide.
+func sameOut(t *testing.T, id string, got map[string]any, want json.RawMessage) {
+	t.Helper()
+	var w map[string]json.RawMessage
+	if err := json.Unmarshal(want, &w); err != nil {
+		t.Fatal(err)
+	}
+	for k := range w {
+		if _, ok := got[k]; !ok && !programKeys[k] {
+			t.Errorf("%s: golden receipt field %q is not checked", id, k)
+		}
+	}
+	for k, v := range got {
+		raw, ok := w[k]
+		if !ok {
+			t.Errorf("%s: receipt field %q is not in the golden one", id, k)
+			continue
+		}
+		same(t, id, "out."+k, v, raw)
+	}
+}
+
+// sameWalk compares the walk-decided fields of the book after with the golden book after.
+func sameWalk(t *testing.T, c gCase, bk *Book) {
+	t.Helper()
+	var want map[string]json.RawMessage
+	if err := json.Unmarshal(c.StateOut, &want); err != nil {
+		t.Fatal(err)
+	}
+	got := bookMap(bk)
+	for _, k := range walkKeys {
+		w := want[k]
+		if k == "ranges" {
+			// the per-range Milestone cap is the split's, not the walk's, and no view returns it
+			var rs []map[string]json.RawMessage
+			if err := json.Unmarshal(w, &rs); err != nil {
+				t.Fatal(err)
+			}
+			for _, r := range rs {
+				delete(r, "ms_cap_ppm")
+			}
+			w, _ = json.Marshal(rs)
+		}
+		same(t, c.ID, "state_out."+k, got[k], w)
+	}
+}
+
+func feePpm(t *testing.T, m json.RawMessage) [FeeLegs]uint32 {
+	var p [FeeLegs]uint32
+	for i, v := range gStrs(t, m) {
+		p[i] = uint32(g64(t, v))
+	}
+	return p
+}
+
+// oracle/fees.json: the fee legs on an amount and a buy's book money from its gross.
+func TestGoldenFees(t *testing.T) {
+	counts := map[string]int{}
+	for _, c := range loadGolden(t, "fees") {
+		counts[c.Fn]++
+		p := feePpm(t, c.Args["fee_ppm"])
+		switch c.Fn {
+		case "fee_legs":
+			legs := FeeLegsOf(gU(t, c.Args["amount"]), &p)
+			same(t, c.ID, "out", map[string]any{"fees": arrU(legs[:])}, c.Out)
+		case "book_from_gross":
+			net := NetFromGross(gU(t, c.Args["gross"]), &p)
+			legs := FeeLegsOf(net, &p)
+			same(t, c.ID, "out", map[string]any{"net": dU(net), "fees": arrU(legs[:])}, c.Out)
+		default:
+			t.Fatalf("%s: unknown fn %q", c.ID, c.Fn)
+		}
+	}
+	t.Log(fmt.Sprint(counts))
+}
+
+// oracle/supply.json: circulating and s_below. The dead-address families are the tracker's reads, not the math's.
+func TestGoldenSupply(t *testing.T) {
+	counts := map[string]int{}
+	for _, c := range loadGolden(t, "supply") {
+		counts[c.Fn]++
+		switch c.Fn {
+		case "circulating":
+			s, err := Circulating(g64(t, c.Args["minted"]), g64(t, c.Args["burned"]), g64(t, c.Args["for_sale"]),
+				g64(t, c.Args["bought_back"]), g64(t, c.Args["dead"]))
+			if err != nil {
+				same(t, c.ID, "out", errMap(err), c.Out)
+			} else {
+				same(t, c.ID, "out", map[string]any{"s": d64(s)}, c.Out)
+			}
+		case "s_below":
+			v := SBelow(g64(t, c.Args["s"]), g64(t, c.Args["x_c"]), g64(t, c.Args["x_k"]))
+			same(t, c.ID, "out", map[string]any{"s_below": d64(v)}, c.Out)
+		case "is_evm_dead", "is_solana_dead_holder":
+		default:
+			t.Fatalf("%s: unknown fn %q", c.ID, c.Fn)
+		}
+	}
+	t.Log(fmt.Sprint(counts))
+}
+
+// oracle/sqrt.json: the range math, one rounding each (line_sqrt is sqrt_scale_down_bps, as floor-math replays it).
+func TestGoldenSqrt(t *testing.T) {
+	counts := map[string]int{}
+	for _, c := range loadGolden(t, "sqrt") {
+		counts[c.Fn]++
+		a := func(k string) U { return gU(t, c.Args[k]) }
+		r := Down
+		if raw, ok := c.Args["round"]; ok && str(t, raw) == "up" {
+			r = Up
+		}
+		var v U
+		var err error
+		switch c.Fn {
+		case "money_between":
+			v, err = MoneyBetween(a("l"), a("a"), a("b"), r)
+		case "tokens_between":
+			v, err = TokensBetween(a("l"), a("a"), a("b"), r)
+		case "sqrt_after_money":
+			v, err = SqrtAfterMoney(a("l"), a("p"), a("money"))
+		case "sqrt_after_tokens":
+			v, err = SqrtAfterTokens(a("l"), a("p"), a("tokens"))
+		case "liquidity_for_tokens":
+			v, err = LiquidityForTokens(a("a"), a("b"), a("tokens"))
+		case "liquidity_for_money":
+			v, err = LiquidityForMoney(a("a"), a("b"), a("money"))
+		case "flat_tokens_for_money":
+			v, err = FlatTokensForMoney(a("s"), a("money"), r)
+		case "flat_money_for_tokens":
+			v, err = FlatMoneyForTokens(a("s"), a("tokens"), r)
+		case "sqrt_of_ratio":
+			v, err = SqrtOfRatio(a("money"), a("tokens"))
+		case "line_sqrt":
+			v, err = SqrtScaleDownBps(a("low"), uint16(g64(t, c.Args["w_bps"])))
+		default:
+			t.Fatalf("%s: unknown fn %q", c.ID, c.Fn)
+		}
+		// the oracle prints the exact value; one past u128 is the Rust's None (as floor-math's own replay reads it)
+		var o map[string]json.RawMessage
+		_ = json.Unmarshal(c.Out, &o)
+		want, overflow := uint256.FromDecimal(str(t, o["value"]))
+		if overflow != nil || !fits128(*want) {
+			if err == nil {
+				t.Errorf("%s %s: got %s, want out of u128", c.ID, c.Fn, v.Dec())
+			}
+			continue
+		}
+		if err != nil || !eq(v, *want) {
+			t.Errorf("%s %s: got %s (%v), want %s", c.ID, c.Fn, v.Dec(), err, want.Dec())
+		}
+	}
+	t.Log(fmt.Sprint(counts))
+}
+
+func TestGoldenBook(t *testing.T) {
+	counts := replayBook(t, "book")
+	if counts["buy"] == 0 || counts["sell"] == 0 {
+		t.Fatalf("golden sections missing: %v", counts)
+	}
+	t.Log(fmt.Sprint(counts))
+}
+
+// TestGoldenWalkCap replays the walk-cap family (testdata/walkcap.json, printed by floor-math's own
+// trade::buy_steps_with): buys bounded below MaxWalkSteps, Solana's SolBuyWalkSteps among them, receipt for receipt.
+func TestGoldenWalkCap(t *testing.T) {
+	capped := 0
+	for _, c := range loadGolden(t, "walkcap") {
+		if c.Fn != "buy" || c.Args["walk_steps"] == nil {
+			t.Fatalf("%s: a walk-cap case is a bounded buy", c.ID)
+		}
+		var o struct {
+			Steps     uint8 `json:"steps"`
+			BudgetHit bool  `json:"budget_hit"`
+		}
+		_ = json.Unmarshal(c.Out, &o)
+		if o.BudgetHit && o.Steps < MaxWalkSteps && uint64(o.Steps) == gInt(t, c.Args["walk_steps"]) {
+			capped++
+		}
+	}
+	if capped == 0 {
+		t.Fatal("walkcap: no case stops at a bound below MaxWalkSteps")
+	}
+	counts := replayBook(t, "walkcap")
+	t.Log(fmt.Sprint(counts), " capped below MaxWalkSteps: ", capped)
+}
+
+// replayBook replays one book-shaped section: buys (bounded by args.walk_steps when present) and sells.
+func replayBook(t *testing.T, section string) map[string]int {
+	counts := map[string]int{}
+	for _, c := range loadGolden(t, section) {
+		counts[c.Fn]++
+		switch c.Fn {
+		case "buy":
+			bk := bookFromJSON(t, c.StateIn)
+			before := bk
+			steps := uint8(MaxWalkSteps)
+			if raw, ok := c.Args["walk_steps"]; ok {
+				steps = uint8(gInt(t, raw))
+			}
+			r, err := BuySteps(&bk, gU(t, c.Args["gross"]), g64(t, c.Args["min_tokens"]), steps)
+			if err != nil {
+				same(t, c.ID, "out", errMap(err), c.Out)
+				if bk != before {
+					t.Errorf("%s: a refused buy moved the book", c.ID)
+				}
+			} else {
+				sameOut(t, c.ID, map[string]any{"gross": dU(r.Gross), "net": dU(r.Net), "refund": dU(r.Refund),
+					"tokens": d64(r.Tokens), "fees": arrU(r.Fees[:]), "from_resale": d64(r.FromResale),
+					"from_first": d64(r.FromFirst), "steps": r.Steps, "budget_hit": r.BudgetHit,
+					"graduated_now": r.GraduatedNow, "sqrt_before": dU(r.SqrtBefore), "sqrt_after": dU(r.SqrtAfter)}, c.Out)
+				sameWalk(t, c, &bk)
+			}
+		case "sell":
+			bk := bookFromJSON(t, c.StateIn)
+			before := bk
+			r, err := Sell(&bk, g64(t, c.Args["tokens"]), gU(t, c.Args["min_out"]))
+			if err != nil {
+				same(t, c.ID, "out", errMap(err), c.Out)
+				if bk != before {
+					t.Errorf("%s: a refused sell moved the book", c.ID)
+				}
+			} else {
+				sameOut(t, c.ID, map[string]any{"tokens_in": d64(r.TokensIn), "unfilled": d64(r.Unfilled),
+					"gross": dU(r.Gross), "fees": arrU(r.Fees[:]), "out": dU(r.Out), "steps": r.Steps,
+					"sqrt_before": dU(r.SqrtBefore), "sqrt_after": dU(r.SqrtAfter), "from_f": dU(r.FromF),
+					"from_k": dU(r.FromK), "from_c": dU(r.FromC)}, c.Out)
+				sameWalk(t, c, &bk)
+			}
+		default:
+			t.Fatalf("%s: unknown fn %q", c.ID, c.Fn)
+		}
+	}
+	return counts
+}
diff --git a/pkg/liquidity-source/floor-amm/math/v2/json.go b/pkg/liquidity-source/floor-amm/math/v2/json.go
new file mode 100644
index 00000000..4ad55b54
--- /dev/null
+++ b/pkg/liquidity-source/floor-amm/math/v2/json.go
@@ -0,0 +1,177 @@
+package floorv2
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// The book as JSON. The book is golden/v2's `book_json`, byte for byte: every integer but the small ones a
+// decimal string, the band arrays BidsMax (+ 1) wide. A pool's Extra carries these, so the
+// decoder refuses anything the math could not hold (a money value past u128, a band or range count past its bound).
+
+var ErrBookJSON = errors.New("floorv2: malformed book")
+
+func dec(v U) string        { return `"` + v.Dec() + `"` }
+func dec64(v uint64) string { return `"` + strconv.FormatUint(v, 10) + `"` }
+
+func decs[T any](a []T, f func(T) string) string {
+	p := make([]string, len(a))
+	for i, v := range a {
+		p[i] = f(v)
+	}
+	return "[" + strings.Join(p, ",") + "]"
+}
+
+// MarshalJSON prints golden/v2's book_json.
+func (b Book) MarshalJSON() ([]byte, error) {
+	rs := make([]string, b.NRanges)
+	for i := range rs {
+		r := &b.Ranges[i]
+		rs[i] = fmt.Sprintf(`{"sqrt_a":%s,"sqrt_b":%s,"tokens":%s,"ask_left":%s,"back":%s,"place":%s,"theta_bps":%d,"psi_bps":%d,"kind":%d,"class":%d}`,
+			dec(r.SqrtA), dec(r.SqrtB), dec64(r.Tokens), dec64(r.AskLeft), dec64(r.Back), dec(r.Place),
+			r.ThetaBps, r.PsiBps, r.Kind, r.Class)
+	}
+	return []byte(fmt.Sprintf(`{"sqrt_p":%s,"sqrt_f":%s,"sqrt_l_max":%s,"floor":%s,"floor_tokens":%s,"n_bands":%d,"n_c":%d,"band_edge":%s,"band_money":%s,"band_tokens":%s,"band_f":%s,"band_f_claim":%s,"ck_at_f":%s,"ck_floor_tokens":%s,"fee_ppm":%s%s,"graduated":%t%s,"n_ranges":%d,"ranges":[%s]}`,
+		dec(b.SqrtP), dec(b.SqrtF), dec(b.SqrtLMax), dec(b.Floor), dec64(b.FloorTokens), b.NBands, b.NC,
+		decs(b.BandEdge[:], dec), decs(b.BandMoney[:], dec), decs(b.BandTokens[:], dec64), decs(b.BandF[:], dec),
+		decs(b.BandFClaim[:], dec), dec(b.CkAtF), dec64(b.CkFloorTokens),
+		decs(b.FeePpm[:], func(v uint32) string { return dec64(uint64(v)) }), b.curveJSON(), b.Graduated, b.ownFeesJSON(), b.NRanges, strings.Join(rs, ","))), nil
+}
+
+// ownFeesJSON prints own_fees only when set (golden/v2 never prints it: every golden book is false).
+func (b Book) ownFeesJSON() string {
+	if b.OwnFees {
+		return `,"own_fees":true`
+	}
+	return ""
+}
+
+// curveJSON prints the fee curve as golden/v2 does: nothing when the book has none.
+func (b Book) curveJSON() string {
+	if b.FeeStartPpm == [FeeLegs]uint32{} && isZ(b.SqrtFeeA) && isZ(b.SqrtFeeB) {
+		return ""
+	}
+	return `,"fee_start_ppm":` + decs(b.FeeStartPpm[:], func(v uint32) string { return dec64(uint64(v)) }) +
+		`,"sqrt_fee_a":` + dec(b.SqrtFeeA) + `,"sqrt_fee_b":` + dec(b.SqrtFeeB)
+}
+
+// num is a decimal string that fits u128.
+type num U
+
+func (x *num) UnmarshalJSON(raw []byte) error {
+	var s string
+	if err := json.Unmarshal(raw, &s); err != nil {
+		return ErrBookJSON
+	}
+	var v U
+	if err := v.SetFromDecimal(s); err != nil || v.BitLen() > 128 {
+		return ErrBookJSON
+	}
+	*x = num(v)
+	return nil
+}
+
+// num64 is a decimal string that fits u64.
+type num64 uint64
+
+func (x *num64) UnmarshalJSON(raw []byte) error {
+	var s string
+	if err := json.Unmarshal(raw, &s); err != nil {
+		return ErrBookJSON
+	}
+	v, err := strconv.ParseUint(s, 10, 64)
+	if err != nil {
+		return ErrBookJSON
+	}
+	*x = num64(v)
+	return nil
+}
+
+type rangeWire struct {
+	SqrtA    num    `json:"sqrt_a"`
+	SqrtB    num    `json:"sqrt_b"`
+	Tokens   num64  `json:"tokens"`
+	AskLeft  num64  `json:"ask_left"`
+	Back     num64  `json:"back"`
+	Place    num    `json:"place"`
+	ThetaBps uint16 `json:"theta_bps"`
+	PsiBps   uint16 `json:"psi_bps"`
+	Kind     uint8  `json:"kind"`
+	Class    uint8  `json:"class"`
+}
+
+type bookWire struct {
+	SqrtP         num         `json:"sqrt_p"`
+	SqrtF         num         `json:"sqrt_f"`
+	SqrtLMax      num         `json:"sqrt_l_max"`
+	Floor         num         `json:"floor"`
+	FloorTokens   num64       `json:"floor_tokens"`
+	NBands        uint8       `json:"n_bands"`
+	NC            uint8       `json:"n_c"`
+	BandEdge      []num       `json:"band_edge"`
+	BandMoney     []num       `json:"band_money"`
+	BandTokens    []num64     `json:"band_tokens"`
+	BandF         []num       `json:"band_f"`
+	BandFClaim    []num       `json:"band_f_claim"`
+	CkAtF         num         `json:"ck_at_f"`
+	CkFloorTokens num64       `json:"ck_floor_tokens"`
+	FeePpm        []num64     `json:"fee_ppm"`
+	FeeStartPpm   []num64     `json:"fee_start_ppm"`
+	SqrtFeeA      num         `json:"sqrt_fee_a"`
+	SqrtFeeB      num         `json:"sqrt_fee_b"`
+	Graduated     bool        `json:"graduated"`
+	OwnFees       bool        `json:"own_fees"`
+	NRanges       uint8       `json:"n_ranges"`
+	Ranges        []rangeWire `json:"ranges"`
+}
+
+// UnmarshalJSON reads book_json. It checks the shape only; Check is the book's own invariants.
+func (b *Book) UnmarshalJSON(raw []byte) error {
+	var j bookWire
+	if err := json.Unmarshal(raw, &j); err != nil {
+		return err
+	}
+	if len(j.BandEdge) != BidsMax+1 || len(j.BandMoney) != BidsMax || len(j.BandTokens) != BidsMax ||
+		len(j.BandF) != BidsMax || len(j.BandFClaim) != BidsMax || int(j.NC) > int(j.NBands) || len(j.FeePpm) != FeeLegs || int(j.NBands) > BidsMax || int(j.NRanges) > RangesMax ||
+		len(j.Ranges) != int(j.NRanges) {
+		return ErrBookJSON
+	}
+	var o Book
+	o.SqrtP, o.SqrtF, o.SqrtLMax, o.Floor = U(j.SqrtP), U(j.SqrtF), U(j.SqrtLMax), U(j.Floor)
+	o.FloorTokens, o.NBands, o.NC = uint64(j.FloorTokens), j.NBands, j.NC
+	for i := range o.BandEdge {
+		o.BandEdge[i] = U(j.BandEdge[i])
+	}
+	for i := range o.BandMoney {
+		o.BandMoney[i], o.BandTokens[i] = U(j.BandMoney[i]), uint64(j.BandTokens[i])
+		o.BandF[i], o.BandFClaim[i] = U(j.BandF[i]), U(j.BandFClaim[i])
+	}
+	o.CkAtF, o.CkFloorTokens = U(j.CkAtF), uint64(j.CkFloorTokens)
+	for i := range o.FeePpm {
+		if j.FeePpm[i] > 1_000_000 {
+			return ErrBookJSON
+		}
+		o.FeePpm[i] = uint32(j.FeePpm[i])
+	}
+	if len(j.FeeStartPpm) != 0 && len(j.FeeStartPpm) != FeeLegs {
+		return ErrBookJSON
+	}
+	for i := range j.FeeStartPpm {
+		if j.FeeStartPpm[i] > 1_000_000 {
+			return ErrBookJSON
+		}
+		o.FeeStartPpm[i] = uint32(j.FeeStartPpm[i])
+	}
+	o.SqrtFeeA, o.SqrtFeeB = U(j.SqrtFeeA), U(j.SqrtFeeB)
+	o.Graduated, o.OwnFees, o.NRanges = j.Graduated, j.OwnFees, j.NRanges
+	for i, r := range j.Ranges {
+		o.Ranges[i] = Range{SqrtA: U(r.SqrtA), SqrtB: U(r.SqrtB), Tokens: uint64(r.Tokens), AskLeft: uint64(r.AskLeft),
+			Back: uint64(r.Back), Place: U(r.Place), ThetaBps: r.ThetaBps, PsiBps: r.PsiBps,
+			Kind: r.Kind, Class: r.Class}
+	}
+	*b = o
+	return nil
+}
diff --git a/pkg/liquidity-source/floor-amm/math/v2/props_test.go b/pkg/liquidity-source/floor-amm/math/v2/props_test.go
new file mode 100644
index 00000000..9d4e3f10
--- /dev/null
+++ b/pkg/liquidity-source/floor-amm/math/v2/props_test.go
@@ -0,0 +1,168 @@
+package floorv2
+
+import (
+	"encoding/json"
+	"math/big"
+	"math/rand"
+	"testing"
+)
+
+// The helpers against exact big-integer arithmetic (tests only), and random buy / sell chains from every golden state:
+// quote conserved to the unit (book money + fees paid out + first-time money, which the program splits after the walk, moves by exactly paid / −out), tokens conserved, a refusal moves
+// nothing, Check holds, quotes equal trades.
+
+func bi(u U) *big.Int { return u.ToBig() }
+
+func rdiv(num, den *big.Int, r Round) *big.Int {
+	q, m := new(big.Int).QuoRem(num, den, new(big.Int))
+	if r == Up && m.Sign() != 0 {
+		q.Add(q, big.NewInt(1))
+	}
+	return q
+}
+
+func randU(rng *rand.Rand, bits int) U {
+	var z U
+	for i := 0; i < 4; i++ {
+		z[i] = rng.Uint64()
+	}
+	z.Rsh(&z, uint(256-(1+rng.Intn(bits))))
+	return z
+}
+
+var lim128 = new(big.Int).Lsh(big.NewInt(1), 128)
+
+func check128(t *testing.T, name string, got U, err error, want *big.Int) {
+	t.Helper()
+	if want.Cmp(lim128) >= 0 {
+		if err == nil {
+			t.Fatalf("%s: want Overflow, got %s", name, got.Dec())
+		}
+		return
+	}
+	if err != nil || bi(got).Cmp(want) != 0 {
+		t.Fatalf("%s: got %s (%v) want %s", name, got.Dec(), err, want)
+	}
+}
+
+func TestHelpersAgainstBig(t *testing.T) {
+	rng := rand.New(rand.NewSource(7))
+	p72, p144 := new(big.Int).Lsh(big.NewInt(1), 72), new(big.Int).Lsh(big.NewInt(1), 144)
+	for i := 0; i < 20000; i++ {
+		r := Round(i & 1)
+		l, m := randU(rng, 128), randU(rng, 64)
+		lo, hi := randU(rng, 127), randU(rng, 127)
+		if gt(lo, hi) {
+			lo, hi = hi, lo
+		}
+		if isZ(lo) {
+			lo = n(1)
+		}
+		hi = umax(hi, lo)
+		d := new(big.Int).Sub(bi(hi), bi(lo))
+		v, err := MoneyBetween(l, lo, hi, r)
+		check128(t, "MoneyBetween", v, err, rdiv(new(big.Int).Mul(bi(l), d), p72, r))
+		v, err = TokensBetween(l, lo, hi, r)
+		check128(t, "TokensBetween", v, err, rdiv(new(big.Int).Mul(new(big.Int).Mul(bi(l), d), p72), new(big.Int).Mul(bi(lo), bi(hi)), r))
+		v, err = FlatMoneyForTokens(hi, m, r)
+		check128(t, "FlatMoneyForTokens", v, err, rdiv(new(big.Int).Mul(bi(m), new(big.Int).Mul(bi(hi), bi(hi))), p144, r))
+		v, err = FlatTokensForMoney(hi, m, r)
+		check128(t, "FlatTokensForMoney", v, err, rdiv(new(big.Int).Mul(bi(m), p144), new(big.Int).Mul(bi(hi), bi(hi)), r))
+		if !isZ(l) {
+			lp72 := new(big.Int).Mul(new(big.Int).Mul(bi(l), bi(hi)), p72)
+			l72, tp := new(big.Int).Mul(bi(l), p72), new(big.Int).Mul(bi(m), bi(hi))
+			v, err = SqrtAfterTokens(l, hi, m)
+			check128(t, "SqrtAfterTokens", v, err, rdiv(lp72, new(big.Int).Add(l72, tp), Up))
+			if l72.Cmp(tp) > 0 {
+				v, err = SqrtAfterBuyingTokens(l, hi, m)
+				check128(t, "SqrtAfterBuyingTokens", v, err, rdiv(lp72, new(big.Int).Sub(l72, tp), Up))
+			}
+		}
+		if lt(lo, hi) {
+			v, err = LiquidityForTokens(lo, hi, m)
+			check128(t, "LiquidityForTokens", v, err, rdiv(new(big.Int).Mul(new(big.Int).Mul(bi(m), bi(lo)), bi(hi)), new(big.Int).Mul(p72, d), Down))
+		}
+	}
+}
+
+func goldenStates(t *testing.T) []Book {
+	var out []Book
+	for _, c := range loadGolden(t, "book") {
+		if c.Fn == "buy" || c.Fn == "sell" {
+			out = append(out, bookFromJSON(t, c.StateIn))
+		}
+	}
+	return out
+}
+
+func TestRandomChainsFromGoldenStates(t *testing.T) {
+	rng := rand.New(rand.NewSource(17))
+	for si, start := range goldenStates(t) {
+		for run := 0; run < 50; run++ {
+			bk := start
+			if err := bk.CheckWalked(); err != nil {
+				t.Fatalf("state %d: %v", si, err)
+			}
+			var paidOut U // fee legs other than Backing leave the book
+			var trader uint64
+			base := add(bk.MoneyHeld(), n(0))
+			supply := bk.TokensHeld()
+			var in, out, firstTime U // firstTime: first-time money, which the program splits after the walk
+			for op := 0; op < 30; op++ {
+				before := bk
+				if rng.Intn(2) == 0 || trader == 0 {
+					g := uint64(1) << uint(rng.Intn(44))
+					g += uint64(rng.Int63n(int64(g)))
+					q, qerr := QuoteBuy(&bk, n(g))
+					r, err := Buy(&bk, n(g), 0)
+					if (err == nil) != (qerr == nil) || (err == nil && !same64(q, r)) {
+						t.Fatalf("state %d: quote_buy differs from buy", si)
+					}
+					if err != nil {
+						if bk != before {
+							t.Fatal("refused buy moved the book")
+						}
+						continue
+					}
+					if !eq(r.Gross, add(add(r.Net, FeeTotal(&r.Fees)), r.Refund)) || r.Tokens != r.FromResale+r.FromFirst {
+						t.Fatal("buy receipt")
+					}
+					in = add(in, add(r.Net, FeeTotal(&r.Fees)))
+					firstTime = add(firstTime, r.FirstMoney)
+					paidOut = add(paidOut, sub(FeeTotal(&r.Fees), r.Fees[LegBacking]))
+					trader += r.Tokens
+				} else {
+					x := 1 + uint64(rng.Int63n(int64(trader)))
+					r, err := Sell(&bk, x, zero)
+					if err != nil {
+						if bk != before {
+							t.Fatal("refused sell moved the book")
+						}
+						continue
+					}
+					if !eq(r.Out, sub(r.Gross, FeeTotal(&r.Fees))) || !eq(r.Gross, add(add(r.FromF, r.FromK), add(r.FromC, r.FromPlace))) {
+						t.Fatal("sell receipt")
+					}
+					out = add(out, r.Out)
+					paidOut = add(paidOut, sub(FeeTotal(&r.Fees), r.Fees[LegBacking]))
+					trader -= x - r.Unfilled
+				}
+				if !eq(add(add(add(bk.MoneyHeld(), paidOut), out), firstTime), add(base, in)) {
+					t.Fatalf("state %d op %d: quote not conserved", si, op)
+				}
+				if !eq(add(bk.TokensHeld(), n(trader)), supply) {
+					t.Fatalf("state %d op %d: tokens not conserved", si, op)
+				}
+				if err := bk.CheckWalked(); err != nil {
+					t.Fatalf("state %d op %d: %v", si, op, err)
+				}
+			}
+		}
+	}
+}
+
+func same64(a, b BookBuy) bool {
+	x, _ := json.Marshal(a)
+	y, _ := json.Marshal(b)
+	return string(x) == string(y)
+}
diff --git a/pkg/liquidity-source/floor-amm/math/v2/sqrt.go b/pkg/liquidity-source/floor-amm/math/v2/sqrt.go
new file mode 100644
index 00000000..b3cd4f9d
--- /dev/null
+++ b/pkg/liquidity-source/floor-amm/math/v2/sqrt.go
@@ -0,0 +1,151 @@
+package floorv2
+
+// Uniswap-v3 range math on Q56.72 square roots (Rust: v2::sqrt). Every function names its rounding.
+
+// Frac is the fraction bits of a Sqrt (Q56.72).
+const Frac = 72
+
+var (
+	// One is 1.0 as a Sqrt.
+	One = pow2(Frac)
+	// SqrtTailEnd is the highest square root (the Tail's upper edge).
+	SqrtTailEnd = pow2(127)
+	two144      = pow2(2 * Frac)
+)
+
+// MoneyBetween is l·(b−a) ÷ 2^72.
+func MoneyBetween(l, a, b U, r Round) (U, error) {
+	if lt(b, a) {
+		return zero, ErrOverflow
+	}
+	return MulShr(l, sub(b, a), Frac, r)
+}
+
+// TokensBetween is l·(b−a)·2^72 ÷ b ÷ a.
+func TokensBetween(l, a, b U, r Round) (U, error) {
+	if isZ(a) || lt(b, a) {
+		return zero, ErrOverflow
+	}
+	t, err := ShlDiv(mul(l, sub(b, a)), Frac, b, r)
+	if err != nil {
+		return zero, err
+	}
+	return to128(DivU256(t, a, r))
+}
+
+// SqrtAfterMoney is p + ⌊money·2^72 ÷ l⌋.
+func SqrtAfterMoney(l, p, money U) (U, error) {
+	dp, err := to128(ShlDiv(money, Frac, l, Down))
+	if err != nil {
+		return zero, err
+	}
+	return to128(add(p, dp), nil)
+}
+
+// SqrtAfterTokens is ⌈l·p·2^72 ÷ (l·2^72 + tokens·p)⌉ (a sell), one rounding, never below the exact value.
+func SqrtAfterTokens(l, p, tokens U) (U, error) {
+	lp, lsh, err := sqrtAfterParts(l, p)
+	if err != nil {
+		return zero, err
+	}
+	tp := mul(tokens, p)
+	den := add(lsh, tp)
+	if lt(den, lsh) {
+		return zero, ErrOverflow
+	}
+	return to128(mulDiv(lp, One, den, Up))
+}
+
+// SqrtAfterBuyingTokens is ⌈l·p·2^72 ÷ (l·2^72 − tokens·p)⌉ (a buy of exactly tokens), one rounding; ErrOverflow when
+// the range cannot hold them.
+func SqrtAfterBuyingTokens(l, p, tokens U) (U, error) {
+	lp, lsh, err := sqrtAfterParts(l, p)
+	if err != nil {
+		return zero, err
+	}
+	tp := mul(tokens, p)
+	if le(lsh, tp) {
+		return zero, ErrOverflow
+	}
+	return to128(mulDiv(lp, One, sub(lsh, tp), Up))
+}
+
+// sqrtAfterParts: l·p and l·2^72, both under 2^256 for l, p, tokens under 2^128 (the Rust's 384-bit numerator is l·p·2^72,
+// divided here by mulDiv's 512-bit product).
+func sqrtAfterParts(l, p U) (U, U, error) {
+	if !fits128(l) || !fits128(p) {
+		return zero, zero, ErrOverflow
+	}
+	var lsh U
+	lsh.Lsh(&l, Frac)
+	return mul(l, p), lsh, nil
+}
+
+// LiquidityForTokens is ⌊⌊tokens·a·b ÷ 2^72⌋ ÷ (b−a)⌋.
+func LiquidityForTokens(a, b, tokens U) (U, error) {
+	if le(b, a) {
+		return zero, ErrOverflow
+	}
+	// ⌊⌊n ÷ 2^72⌋ ÷ d⌋ = ⌊n ÷ (2^72·d)⌋, and 2^72·d < 2^200
+	return to128(mulDiv(mul(tokens, a), b, mul(One, sub(b, a)), Down))
+}
+
+// LiquidityForMoney is ⌊money·2^72 ÷ (b−a)⌋.
+func LiquidityForMoney(a, b, money U) (U, error) {
+	if le(b, a) {
+		return zero, ErrOverflow
+	}
+	return to128(ShlDiv(money, Frac, sub(b, a), Down))
+}
+
+// FlatTokensForMoney is money·2^144 ÷ s ÷ s, each division rounded as asked.
+func FlatTokensForMoney(s, money U, r Round) (U, error) {
+	if isZ(s) {
+		return zero, ErrOverflow
+	}
+	t, err := ShlDiv(money, 2*Frac, s, r)
+	if err != nil {
+		return zero, err
+	}
+	return to128(DivU256(t, s, r))
+}
+
+// FlatMoneyForTokens is tokens·s·s ÷ 2^144.
+func FlatMoneyForTokens(s, tokens U, r Round) (U, error) {
+	return to128(mulDiv(mul(tokens, s), s, two144, r))
+}
+
+// SqrtOfRatio is ⌊√(⌊money·2^144 ÷ tokens⌋)⌋: √f from F ÷ s_below.
+func SqrtOfRatio(money, tokens U) (U, error) {
+	if isZ(tokens) {
+		return zero, ErrOverflow
+	}
+	q, err := ShlDiv(money, 2*Frac, tokens, Down)
+	if err != nil {
+		return zero, err
+	}
+	return Isqrt(q), nil
+}
+
+// SqrtScaleDownBps is ⌊s·⌊√(⌊(10⁴−bps)·2^144 ÷ 10⁴⌋)⌋ ÷ 2^72⌋.
+func SqrtScaleDownBps(s U, bps uint16) (U, error) {
+	if bps > 10_000 {
+		return zero, ErrOverflow
+	}
+	q, err := ShlDiv(n(uint64(10_000-bps)), 2*Frac, n(10_000), Down)
+	if err != nil {
+		return zero, err
+	}
+	return MulShr(s, Isqrt(q), Frac, Down)
+}
+
+// PriceX64 is ⌊s² ÷ 2^80⌋ (Q64.64), saturating at 2^128 − 1; display only.
+func PriceX64(s U) U {
+	var v U
+	sq := mul(s, s)
+	v.Rsh(&sq, 2*Frac-64)
+	if !fits128(v) {
+		return sub(pow2(128), n(1))
+	}
+	return v
+}
diff --git a/pkg/liquidity-source/floor-amm/math/v2/supply.go b/pkg/liquidity-source/floor-amm/math/v2/supply.go
new file mode 100644
index 00000000..0ee1b5eb
--- /dev/null
+++ b/pkg/liquidity-source/floor-amm/math/v2/supply.go
@@ -0,0 +1,31 @@
+package floorv2
+
+// Circulating supply (Rust: v2::supply).
+
+// Circulating is minted − burned − for_sale − bought_back − dead, checked.
+func Circulating(minted, burned, forSale, boughtBack, dead uint64) (uint64, error) {
+	x := minted
+	for _, y := range []uint64{burned, forSale, boughtBack, dead} {
+		if x < y {
+			return 0, ErrOverflow
+		}
+		x -= y
+	}
+	return x, nil
+}
+
+// SBelow is s − x_c − x_k, saturating, at least 1.
+func SBelow(s, xc, xk uint64) uint64 {
+	v := s
+	for _, y := range []uint64{xc, xk} {
+		if v < y {
+			v = 0
+		} else {
+			v -= y
+		}
+	}
+	if v < 1 {
+		return 1
+	}
+	return v
+}
