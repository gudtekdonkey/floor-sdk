index 00000000..dc579f7b
--- /dev/null
+++ b/pkg/liquidity-source/floor-amm/math/v2/trade.go
@@ -0,0 +1,128 @@
+package floorv2
+
+// Book-level buy and sell (Rust: v2::trade): the walk, then the five fee legs on top. A refused trade moves nothing (the
+// Rust rolls back from an undo log; here the walk runs on a copy). The program then splits a buy's first-time money and
+// lays C + K again under the price; neither moves anything the walk reads, so these are the trader's numbers (tokens,
+// fees, refund, out, unfilled) and the book after is the walk's, not the program's.
+
+// BookBuy is the buy receipt without the split. FirstMoney is the net money paid for first-time tokens (the split's).
+// Money is u128.
+type BookBuy struct {
+	Gross, Net, Refund      U
+	FirstMoney              U
+	Tokens                  uint64
+	Fees                    [FeeLegs]U
+	FromResale, FromFirst   uint64
+	Steps                   uint8
+	BudgetHit, GraduatedNow bool
+	SqrtBefore, SqrtAfter   U
+}
+
+// BookSell is the sell receipt without the re-lay.
+type BookSell struct {
+	TokensIn, Unfilled             uint64
+	Gross                          U
+	Fees                           [FeeLegs]U
+	Out                            U
+	Steps                          uint8
+	SqrtBefore, SqrtAfter          U
+	FromF, FromK, FromC, FromPlace U
+}
+
+// Buy spends at most gross (fees on top of the book's amount); the unspent part is refunded. The fee curve's charge: every
+// walk step at the cheaper of the trade's start rates and the rates where the step ends; when a leg is cheaper where the
+// first walk ends, what the gross has left walks on ONCE at those rates (Rust buy_inner).
+func Buy(bk *Book, gross U, minTokens uint64) (BookBuy, error) {
+	return BuySteps(bk, gross, minTokens, MaxWalkSteps)
+}
+
+// BuySteps is Buy entering at most walkSteps pieces (Rust buy_steps_with; a Solana buy walks SolBuyWalkSteps);
+// past them the rest is refunded. MaxWalkSteps is Buy exactly.
+func BuySteps(bk *Book, gross U, minTokens uint64, walkSteps uint8) (BookBuy, error) {
+	ppmNow := bk.FeesNow()
+	budget := NetFromGross(gross, &ppmNow)
+	if isZ(budget) {
+		return BookBuy{}, ErrNothingToDo
+	}
+	w := *bk
+	acc := NewFeeAcc(ppmNow)
+	walked, err := w.WalkUpFrom(budget, WalkUp{}, &acc, walkSteps)
+	if err != nil {
+		return BookBuy{}, err
+	}
+	at := w.FeesAt(w.SqrtP)
+	c := Cheaper(&ppmNow, &at)
+	if c != ppmNow && walked.Tokens > 0 {
+		legs := acc.Legs()
+		spent, err := addM(walked.Money, FeeTotal(&legs))
+		if err != nil || gt(spent, gross) {
+			return BookBuy{}, ErrOverflow
+		}
+		if budget2 := NetFromGross(sub(gross, spent), &c); !isZ(budget2) {
+			if walked, err = w.WalkUpFrom(budget2, walked, &acc, walkSteps); err != nil {
+				return BookBuy{}, err
+			}
+		}
+	}
+	if walked.Tokens == 0 {
+		if isZ(w.TokensHeld()) {
+			return BookBuy{}, ErrBookEmpty
+		}
+		return BookBuy{}, ErrNothingToDo
+	}
+	if walked.Tokens < minTokens {
+		return BookBuy{}, ErrSlippageExceeded
+	}
+	fees := acc.Legs()
+	paid, err := addM(walked.Money, FeeTotal(&fees))
+	if err != nil || gt(paid, gross) {
+		return BookBuy{}, ErrOverflow
+	}
+	if w.Floor, err = addM(w.Floor, fees[LegBacking]); err != nil {
+		return BookBuy{}, err
+	}
+	r := BookBuy{Gross: gross, Net: walked.Money, FirstMoney: walked.FirstMoney, Refund: sub(gross, paid), Tokens: walked.Tokens, Fees: fees,
+		FromResale: walked.FromResale, FromFirst: walked.FromFirst, Steps: walked.Steps, BudgetHit: walked.BudgetHit,
+		GraduatedNow: walked.GraduatedNow, SqrtBefore: bk.SqrtP, SqrtAfter: w.SqrtP}
+	*bk = w
+	return r, nil
+}
+
+// Sell sells tokens; what the bid cannot take (or the step bound leaves) is Unfilled.
+func Sell(bk *Book, tokens uint64, minOut U) (BookSell, error) {
+	if tokens == 0 {
+		return BookSell{}, ErrNothingToDo
+	}
+	w := *bk
+	acc := NewFeeAcc(w.FeesNow())
+	walked, err := w.WalkDownAcc(tokens, &acc)
+	if err != nil {
+		return BookSell{}, err
+	}
+	fees := acc.Legs()
+	total := FeeTotal(&fees)
+	if walked.Tokens == 0 || le(walked.Money, total) {
+		if isZ(walked.Money) && isZ(w.MoneyHeld()) {
+			return BookSell{}, ErrBookEmpty
+		}
+		return BookSell{}, ErrNothingToDo
+	}
+	out := sub(walked.Money, total)
+	if lt(out, minOut) {
+		return BookSell{}, ErrSlippageExceeded
+	}
+	if w.Floor, err = addM(w.Floor, fees[LegBacking]); err != nil {
+		return BookSell{}, err
+	}
+	r := BookSell{TokensIn: tokens, Unfilled: tokens - walked.Tokens, Gross: walked.Money, Fees: fees, Out: out,
+		Steps: walked.Steps, SqrtBefore: bk.SqrtP, SqrtAfter: w.SqrtP, FromF: walked.FromF, FromK: walked.FromK,
+		FromC: walked.FromC, FromPlace: walked.FromPlace}
+	*bk = w
+	return r, nil
+}
+
+// QuoteBuy is Buy on a copy, bit for bit.
+func QuoteBuy(bk *Book, gross U) (BookBuy, error) { c := *bk; return Buy(&c, gross, 0) }
+
+// QuoteSell is Sell on a copy.
+func QuoteSell(bk *Book, tokens uint64) (BookSell, error) { c := *bk; return Sell(&c, tokens, zero) }
diff --git a/pkg/liquidity-source/floor-amm/math/v2/wide.go b/pkg/liquidity-source/floor-amm/math/v2/wide.go
new file mode 100644
index 00000000..03f839c1
--- /dev/null
+++ b/pkg/liquidity-source/floor-amm/math/v2/wide.go
@@ -0,0 +1,115 @@
+// Package floorv2 is a Go port of the protocol's v2 reference math (Rust: floor_math::v2): the one book (the row's
+// constant-product ranges, the mirror segments of C and K, the floor flat at f, Bonding flat before graduation), its walk
+// up (buy) and down (sell), the five fee legs and circulating supply. It reproduces golden/v2 bit for bit
+// (golden_test.go). The Rust crate is the source; this follows it, never the other way.
+//
+// Every Rust u128 / U256 is a uint256.Int value; a Rust None is ErrOverflow. Amounts are uint64 math units / base units.
+package floorv2
+
+import "github.com/holiman/uint256"
+
+// U is one Rust u128 (or U256) value.
+type U = uint256.Int
+
+// MathError is floor_math::MathError; the string is the variant's name, as the goldens print it.
+type MathError string
+
+func (e MathError) Error() string { return string(e) }
+
+const (
+	ErrOverflow         MathError = "Overflow"
+	ErrNothingToDo      MathError = "NothingToDo"
+	ErrBookEmpty        MathError = "BookEmpty"
+	ErrSqrtRange        MathError = "SqrtRange"
+	ErrRowTooManyRanges MathError = "RowTooManyRanges"
+	ErrSlippageExceeded MathError = "SlippageExceeded"
+)
+
+// Round is v2::wide::Round.
+type Round int
+
+const (
+	Down Round = iota
+	Up
+)
+
+var zero U
+
+func n(v uint64) U     { var z U; z.SetUint64(v); return z }
+func pow2(k uint) U    { var z U; z.Lsh(uint256.NewInt(1), k); return z }
+func add(a, b U) U     { var z U; z.Add(&a, &b); return z }
+func sub(a, b U) U     { var z U; z.Sub(&a, &b); return z }
+func mul(a, b U) U     { var z U; z.Mul(&a, &b); return z }
+func lt(a, b U) bool   { return a.Lt(&b) }
+func gt(a, b U) bool   { return a.Gt(&b) }
+func le(a, b U) bool   { return !a.Gt(&b) }
+func ge(a, b U) bool   { return !a.Lt(&b) }
+func eq(a, b U) bool   { return a.Eq(&b) }
+func isZ(a U) bool     { return a.IsZero() }
+func fits128(a U) bool { return a.BitLen() <= 128 }
+func umin(a, b U) U {
+	if lt(a, b) {
+		return a
+	}
+	return b
+}
+func umax(a, b U) U {
+	if gt(a, b) {
+		return a
+	}
+	return b
+}
+
+// to128 is U256::to_u128.
+func to128(a U, err error) (U, error) {
+	if err != nil {
+		return zero, err
+	}
+	if !fits128(a) {
+		return zero, ErrOverflow
+	}
+	return a, nil
+}
+
+// mulDiv is ⌊x·m ÷ d⌋ or the ceiling, exact over 512 bits; ErrOverflow when the quotient needs more than 256 bits, as the
+// Rust's div_w (a ceiling past 2^256 too) or d = 0.
+func mulDiv(x, m, d U, r Round) (U, error) {
+	if isZ(d) {
+		return zero, ErrOverflow
+	}
+	var q U
+	if _, over := q.MulDivOverflow(&x, &m, &d); over {
+		return zero, ErrOverflow
+	}
+	if r == Up {
+		var rem U
+		rem.MulMod(&x, &m, &d)
+		if !isZ(rem) {
+			if q.BitLen() == 256 && q.Eq(new(U).SetAllOne()) {
+				return zero, ErrOverflow
+			}
+			q = add(q, n(1))
+		}
+	}
+	return q, nil
+}
+
+// DivU256 is wide::div_u256: x ÷ d.
+func DivU256(x, d U, r Round) (U, error) { return mulDiv(x, n(1), d, r) }
+
+// MulDiv is wide::mul_div: a·b ÷ d as a u128.
+func MulDiv(a, b, d U, r Round) (U, error) { return to128(mulDiv(a, b, d, r)) }
+
+// MulShr is wide::mul_shr: a·b ÷ 2^k as a u128 (a, b under 2^128, k < 256).
+func MulShr(a, b U, k uint, r Round) (U, error) { return to128(mulDiv(a, b, pow2(k), r)) }
+
+// ShlDiv is wide::shl_div: x·2^k ÷ d (None when x·2^k needs more than 384 bits, as shl_w; k < 256).
+func ShlDiv(x U, k uint, d U, r Round) (U, error) {
+	if !isZ(x) && uint(x.BitLen())+k > 384 {
+		return zero, ErrOverflow
+	}
+	return mulDiv(x, pow2(k), d, r)
+}
+
+// Isqrt is wide::isqrt: ⌊√n⌋.
+func Isqrt(a U) U { var z U; z.Sqrt(&a); return z }
diff --git a/pkg/liquidity-source/floor-amm/pool_list_updater.go b/pkg/liquidity-source/floor-amm/pool_list_updater.go
new file mode 100644
index 00000000..13f1091e
--- /dev/null
+++ b/pkg/liquidity-source/floor-amm/pool_list_updater.go
@@ -0,0 +1,164 @@
+package flooramm
+
+import (
+	"context"
+	"math/big"
+	"strings"
+	"time"
+
+	"github.com/KyberNetwork/ethrpc"
+	"github.com/KyberNetwork/logger"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/common/hexutil"
+	"github.com/goccy/go-json"
+
+	"github.com/KyberNetwork/kyberswap-dex-lib/pkg/entity"
+	poollist "github.com/KyberNetwork/kyberswap-dex-lib/pkg/source/pool/list"
+	"github.com/KyberNetwork/kyberswap-dex-lib/pkg/valueobject"
+)
+
+var _ = poollist.RegisterFactoryCE(DexType, NewPoolsListUpdater)
+
+// PoolsListUpdater discovers launches on-chain: ids are sequential from 1, `launchCount()` is the last.
+type PoolsListUpdater struct {
+	config       *Config
+	ethrpcClient *ethrpc.Client
+}
+
+type Metadata struct {
+	// Offset is the last launch id listed.
+	Offset uint64 `json:"offset"`
+	// Unlisted are the launches skipped because their quote was not listed; each pass re-reads their quote's registry
+	// entry and lists a launch once its quote is listed.
+	Unlisted []unlistedLaunch `json:"unlisted,omitempty"`
+}
+
+// unlistedLaunch is a launch held back until its quote is listed.
+type unlistedLaunch struct {
+	ID    uint64         `json:"id"`
+	Token common.Address `json:"token"`
+	Quote common.Address `json:"quote"`
+}
+
+func NewPoolsListUpdater(config *Config, ethrpcClient *ethrpc.Client) *PoolsListUpdater {
+	return &PoolsListUpdater{config: config, ethrpcClient: ethrpcClient}
+}
+
+func (u *PoolsListUpdater) GetNewPools(ctx context.Context, metadataBytes []byte) ([]entity.Pool, []byte, error) {
+	var md Metadata
+	if len(metadataBytes) > 0 {
+		if err := json.Unmarshal(metadataBytes, &md); err != nil {
+			return nil, metadataBytes, err
+		}
+	}
+	var count *big.Int
+	if _, err := u.ethrpcClient.NewRequest().SetContext(ctx).AddCall(&ethrpc.Call{
+		ABI: floorAmmABI, Target: u.config.FloorAmm, Method: methodLaunchCount,
+	}, []any{&count}).Call(); err != nil {
+		return nil, metadataBytes, err
+	}
+	limit := uint64(u.config.NewPoolLimit)
+	if limit == 0 {
+		limit = defaultNewPoolLimit
+	}
+	last := max(md.Offset, min(count.Uint64(), md.Offset+limit))
+
+	// the launches held back earlier come first (their quote may be listed now), then the new ids
+	launches := append([]unlistedLaunch(nil), md.Unlisted...)
+	fresh := make([]unlistedLaunch, 0, last-md.Offset)
+	if last > md.Offset {
+		req := u.ethrpcClient.NewRequest().SetContext(ctx)
+		for id := md.Offset + 1; id <= last; id++ {
+			fresh = append(fresh, unlistedLaunch{ID: id})
+		}
+		for i := range fresh {
+			id := new(big.Int).SetUint64(fresh[i].ID)
+			req.AddCall(&ethrpc.Call{ABI: floorAmmABI, Target: u.config.FloorAmm, Method: methodLaunchToken,
+				Params: []any{id}}, []any{&fresh[i].Token})
+			req.AddCall(&ethrpc.Call{ABI: floorAmmABI, Target: u.config.FloorAmm, Method: methodLaunchQuote,
+				Params: []any{id}}, []any{&fresh[i].Quote})
+		}
+		if _, err := req.Aggregate(); err != nil {
+			return nil, metadataBytes, err
+		}
+	}
+	launches = append(launches, fresh...)
+	if len(launches) == 0 {
+		return nil, metadataBytes, nil
+	}
+	entries, err := u.quoteEntries(ctx, launches)
+	if err != nil {
+		return nil, metadataBytes, err
+	}
+	keep, still := vetLaunches(launches, entries, u.config.RouteUnlisted)
+	pools := make([]entity.Pool, 0, len(keep))
+	for _, l := range keep {
+		isNative := l.Quote == (common.Address{})
+		quote := hexutil.Encode(l.Quote[:])
+		if isNative {
+			quote = strings.ToLower(valueobject.WrappedNativeMap[u.config.ChainID])
+		}
+		token := hexutil.Encode(l.Token[:])
+		staticExtra, err := json.Marshal(StaticExtra{
+			FloorAmm: strings.ToLower(u.config.FloorAmm), LaunchID: l.ID, IsNative: isNative,
+		})
+		if err != nil {
+			return nil, metadataBytes, err
+		}
+		pools = append(pools, entity.Pool{
+			Address:     token, // one launch per token
+			Exchange:    u.config.DexID,
+			Type:        DexType,
+			Timestamp:   time.Now().Unix(),
+			Reserves:    entity.PoolReserves{"0", "0"},
+			Tokens:      []*entity.PoolToken{{Address: quote, Swappable: true}, {Address: token, Swappable: true}},
+			Extra:       "{}",
+			StaticExtra: string(staticExtra),
+		})
+	}
+	for _, l := range still {
+		if l.ID > md.Offset {
+			logger.Infof("floor-amm: launch %d: quote %s is not listed, held back", l.ID, l.Quote.Hex())
+		}
+	}
+	newMd, err := json.Marshal(Metadata{Offset: last, Unlisted: still})
+	if err != nil {
+		return nil, metadataBytes, err
+	}
+	return pools, newMd, nil
+}
+
+// vetLaunches applies quoteVetted to each launch: which to list, and which to hold back for a later pass.
+func vetLaunches(launches []unlistedLaunch, entries map[common.Address]*quoteEntry,
+	routeUnlisted bool) (keep, still []unlistedLaunch) {
+	for _, l := range launches {
+		if quoteVetted(entries[l.Quote], routeUnlisted) {
+			keep = append(keep, l)
+		} else {
+			still = append(still, l)
+		}
+	}
+	return keep, still
+}
+
+// quoteEntries reads the registry's entry of each quote, once per quote.
+func (u *PoolsListUpdater) quoteEntries(ctx context.Context, launches []unlistedLaunch) (map[common.Address]*quoteEntry, error) {
+	entries := map[common.Address]*quoteEntry{}
+	if u.config.RouteUnlisted {
+		return entries, nil
+	}
+	req := u.ethrpcClient.NewRequest().SetContext(ctx)
+	for _, l := range launches {
+		if entries[l.Quote] != nil {
+			continue
+		}
+		e := &quoteEntryOut{}
+		entries[l.Quote] = &e.Entry
+		req.AddCall(&ethrpc.Call{ABI: floorAmmABI, Target: u.config.FloorAmm, Method: methodQuoteEntry,
+			Params: []any{l.Quote}}, []any{e})
+	}
+	if _, err := req.Aggregate(); err != nil {
+		return nil, err
+	}
+	return entries, nil
+}
diff --git a/pkg/liquidity-source/floor-amm/pool_simulator.go b/pkg/liquidity-source/floor-amm/pool_simulator.go
new file mode 100644
index 00000000..f31b8998
--- /dev/null
+++ b/pkg/liquidity-source/floor-amm/pool_simulator.go
@@ -0,0 +1,205 @@
+package flooramm
+
+import (
+	"math/big"
+
+	"github.com/goccy/go-json"
+	"github.com/holiman/uint256"
+	"github.com/samber/lo"
+
+	"github.com/KyberNetwork/kyberswap-dex-lib/pkg/entity"
+	floorv2 "github.com/KyberNetwork/kyberswap-dex-lib/pkg/liquidity-source/floor-amm/math/v2"
+	"github.com/KyberNetwork/kyberswap-dex-lib/pkg/source/pool"
+	"github.com/KyberNetwork/kyberswap-dex-lib/pkg/util/bignumber"
+	"github.com/KyberNetwork/kyberswap-dex-lib/pkg/valueobject"
+)
+
+var _ = pool.RegisterFactory(DexType, func(params pool.FactoryParams) (*PoolSimulator, error) {
+	return NewPoolSimulator(params.EntityPool, params.ChainID)
+})
+
+// PoolSimulator quotes one launch on its book, as the program's book walk (`math/v2`, a port of the protocol's reference
+// math held to its golden walks bit for bit) runs it. On chain a buy then splits its first-time money and every
+// trade lays C + K again under the price; neither is ported, so one quote from a fresh state is exact, but the book
+// after a trade (UpdateBalance) is the walk's, not the program's, and a later walk on it can differ. UpdateBalance
+// therefore marks the simulator stale and every later quote returns ErrStaleAfterSwap until the tracker refreshes
+// the state from chain (a new simulator).
+type PoolSimulator struct {
+	pool.Pool
+	book       floorv2.Book
+	tokenScale uint256.Int // token chain units per math unit (10^(decimals − 6))
+	floorAmm   string
+	launchID   uint64
+	isNative   bool
+	chainID    valueobject.ChainID // a native launch's quote side is at the wrapped-native entry's decimals (Arc: 6, not 18)
+	stale      bool                // a trade was applied: the book is no longer the program's
+}
+
+func NewPoolSimulator(ep entity.Pool, chainID valueobject.ChainID) (*PoolSimulator, error) {
+	var se StaticExtra
+	if err := json.Unmarshal([]byte(ep.StaticExtra), &se); err != nil {
+		return nil, err
+	}
+	var ex Extra
+	if err := json.Unmarshal([]byte(ep.Extra), &ex); err != nil {
+		return nil, err
+	}
+	if len(ep.Tokens) != 2 {
+		return nil, ErrInvalidToken
+	}
+	// the quote is Tokens[0], the launch's token Tokens[1]
+	dec := ep.Tokens[1].Decimals
+	if dec < tokenMathDecimals {
+		return nil, ErrTokenDecimals
+	}
+	if err := ex.Book.Check(); err != nil {
+		return nil, ErrInvalidSnapshot
+	}
+	var scale uint256.Int
+	scale.Exp(uint256.NewInt(10), uint256.NewInt(uint64(dec-tokenMathDecimals)))
+	return &PoolSimulator{
+		Pool: pool.Pool{Info: pool.PoolInfo{
+			Address:     ep.Address,
+			Exchange:    ep.Exchange,
+			Type:        ep.Type,
+			Tokens:      lo.Map(ep.Tokens, func(t *entity.PoolToken, _ int) string { return t.Address }),
+			Reserves:    lo.Map(ep.Reserves, func(r string, _ int) *big.Int { return bignumber.NewBig(r) }),
+			BlockNumber: ep.BlockNumber,
+		}},
+		book:       ex.Book,
+		tokenScale: scale,
+		floorAmm:   se.FloorAmm,
+		launchID:   se.LaunchID,
+		isNative:   se.IsNative,
+		chainID:    chainID,
+	}, nil
+}
+
+func (s *PoolSimulator) CalcAmountOut(params pool.CalcAmountOutParams) (*pool.CalcAmountOutResult, error) {
+	if s.stale {
+		return nil, ErrStaleAfterSwap
+	}
+	in, out := s.GetTokenIndex(params.TokenAmountIn.Token), s.GetTokenIndex(params.TokenOut)
+	if in < 0 || out < 0 || in == out {
+		return nil, ErrInvalidToken
+	}
+	rawIn := params.TokenAmountIn.Amount
+	if in == 0 && s.isNative {
+		rawIn = valueobject.UnwrapNativeAmount(s.chainID, rawIn) // the launch's money is native base units
+	}
+	amountIn, overflow := uint256.FromBig(rawIn)
+	if overflow || amountIn.BitLen() > 128 {
+		return nil, ErrOverflow
+	}
+	book := s.book // a copy: the quote never touches the simulator's state
+	if in == 0 {
+		r, err := floorv2.Buy(&book, *amountIn, 0)
+		if err != nil {
+			return nil, err
+		}
+		if r.Tokens == 0 {
+			return nil, ErrZeroOut
+		}
+		var outTokens uint256.Int
+		outTokens.Mul(uint256.NewInt(r.Tokens), &s.tokenScale)
+		res := &pool.CalcAmountOutResult{
+			TokenAmountOut: &pool.TokenAmount{Token: s.Info.Tokens[1], Amount: outTokens.ToBig()},
+			Fee:            &pool.TokenAmount{Token: s.Info.Tokens[0], Amount: s.quoteAmount(feeSum(&r.Fees))},
+			Gas:            buyGas,
+			SwapInfo: &SwapInfo{IsBuy: true, LaunchID: s.launchID, FloorAmm: s.floorAmm, Refund: r.Refund.Dec(),
+				after: &book},
+		}
+		if !r.Refund.IsZero() {
+			res.RemainingTokenAmountIn = &pool.TokenAmount{Token: s.Info.Tokens[0], Amount: s.quoteAmount(&r.Refund)}
+		}
+		return res, nil
+	}
+	// a sell takes whole math units; the sub-unit rest stays with the trader
+	var units, rest uint256.Int
+	units.DivMod(amountIn, &s.tokenScale, &rest)
+	if units.IsZero() {
+		return nil, ErrSubUnit
+	}
+	if !units.IsUint64() {
+		return nil, ErrOverflow
+	}
+	r, err := floorv2.Sell(&book, units.Uint64(), uint256.Int{})
+	if err != nil {
+		return nil, err
+	}
+	if r.Out.IsZero() {
+		return nil, ErrZeroOut
+	}
+	res := &pool.CalcAmountOutResult{
+		TokenAmountOut: &pool.TokenAmount{Token: s.Info.Tokens[0], Amount: s.quoteAmount(&r.Out)},
+		Fee:            &pool.TokenAmount{Token: s.Info.Tokens[0], Amount: s.quoteAmount(feeSum(&r.Fees))},
+		Gas:            sellGas,
+		SwapInfo:       &SwapInfo{LaunchID: s.launchID, FloorAmm: s.floorAmm, after: &book},
+	}
+	// tokens the book could not take (the walk's step bound, nothing left to bid) come back with the sub-unit rest
+	var back uint256.Int
+	back.Mul(uint256.NewInt(r.Unfilled), &s.tokenScale).Add(&back, &rest)
+	if !back.IsZero() {
+		res.RemainingTokenAmountIn = &pool.TokenAmount{Token: s.Info.Tokens[1], Amount: back.ToBig()}
+	}
+	return res, nil
+}
+
+// quoteAmount is a money amount (the launch's base units) at the pool's quote token's decimals: the same but for a native
+// launch on Arc, whose wrapped-native entry (6 decimals) shares the native coin's balance (18), rounded down.
+func (s *PoolSimulator) quoteAmount(v *uint256.Int) *big.Int {
+	if s.isNative {
+		return valueobject.WrapNativeAmount(s.chainID, v.ToBig())
+	}
+	return v.ToBig()
+}
+
+func feeSum(f *[floorv2.FeeLegs]uint256.Int) *uint256.Int {
+	var t uint256.Int
+	for i := range f {
+		t.Add(&t, &f[i])
+	}
+	return &t
+}
+
+func (s *PoolSimulator) UpdateBalance(params pool.UpdateBalanceParams) {
+	si, ok := params.SwapInfo.(*SwapInfo)
+	if !ok || si.after == nil {
+		return
+	}
+	s.book = *si.after
+	s.stale = true
+	s.Info.Reserves = bookReserves(&s.book, &s.tokenScale, s.isNative, s.chainID)
+}
+
+// bookReserves is the launch's liquidity: the quote side F + C + K (the bid money) + the money in place (the Bonding flat's,
+// before graduation), the token side every token the book holds, in chain units; a native launch's quote side at the
+// wrapped-native entry's decimals (Arc's differ). A new slice.
+func bookReserves(b *floorv2.Book, scale *uint256.Int, isNative bool, chainID valueobject.ChainID) []*big.Int {
+	quote := b.MoneyHeld()
+	held := b.TokensHeld()
+	held.Mul(&held, scale)
+	q := quote.ToBig()
+	if isNative {
+		q = valueobject.WrapNativeAmount(chainID, q)
+	}
+	return []*big.Int{q, held.ToBig()}
+}
+
+// CloneState: the state is a value (arrays only), so a struct copy is a deep copy.
+func (s *PoolSimulator) CloneState() pool.IPoolSimulator {
+	cloned := *s
+	return &cloned
+}
+
+func (s *PoolSimulator) GetMetaInfo(_, _ string) any {
+	return MetaInfo{BlockNumber: s.Info.BlockNumber, FloorAmm: s.floorAmm, LaunchID: s.launchID, IsNative: s.isNative}
+}
+
+func (s *PoolSimulator) SwapReceiveNativeIn(tokenIn, _ string, _ valueobject.ChainID) bool {
+	return s.isNative && s.GetTokenIndex(tokenIn) == 0
+}
+
+func (s *PoolSimulator) SwapReturnNativeOut(tokenIn, _ string, _ valueobject.ChainID) bool {
+	return s.isNative && s.GetTokenIndex(tokenIn) == 1
+}
diff --git a/pkg/liquidity-source/floor-amm/pool_simulator_test.go b/pkg/liquidity-source/floor-amm/pool_simulator_test.go
new file mode 100644
index 00000000..ec1cb11e
--- /dev/null
+++ b/pkg/liquidity-source/floor-amm/pool_simulator_test.go
@@ -0,0 +1,291 @@
+package flooramm
+
+import (
+	"math/big"
+	"os"
+	"testing"
+
+	"github.com/goccy/go-json"
+	"github.com/holiman/uint256"
+
+	"github.com/KyberNetwork/kyberswap-dex-lib/pkg/entity"
+	floorv2 "github.com/KyberNetwork/kyberswap-dex-lib/pkg/liquidity-source/floor-amm/math/v2"
+	"github.com/KyberNetwork/kyberswap-dex-lib/pkg/source/pool"
+	"github.com/KyberNetwork/kyberswap-dex-lib/pkg/valueobject"
+)
+
+// The simulator replays math/v2/testdata/book.json (the protocol's own book walks, copied verbatim from its goldens):
+// every buy and sell through CalcAmountOut, the receipt against the golden one, then UpdateBalance against the golden
+// book after on the fields the walk decides (the split and the re-lay are the program's, not quoted); a refused trade is
+// an error and moves nothing.
+
+type bookCase struct {
+	ID       string          `json:"id"`
+	Fn       string          `json:"fn"`
+	StateIn  json.RawMessage `json:"state_in"`
+	Args     map[string]any  `json:"args"`
+	Out      map[string]any  `json:"out"`
+	StateOut json.RawMessage `json:"state_out"`
+}
+
+func loadBookCases(t *testing.T) []bookCase {
+	t.Helper()
+	raw, err := os.ReadFile("math/v2/testdata/book.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var f struct {
+		Cases []bookCase `json:"cases"`
+	}
+	if err := json.Unmarshal(raw, &f); err != nil {
+		t.Fatal(err)
+	}
+	return f.Cases
+}
+
+func mustU(t *testing.T, v any) *uint256.Int {
+	t.Helper()
+	s, _ := v.(string)
+	z, err := uint256.FromDecimal(s)
+	if err != nil {
+		t.Fatalf("u256 %v", v)
+	}
+	return z
+}
+
+// poolOf is the entity a tracker would write for a book, with a token of dec decimals.
+func poolOf(t *testing.T, book json.RawMessage, dec uint8) *PoolSimulator {
+	return poolOn(t, book, dec, false, valueobject.ChainIDEthereum)
+}
+
+func poolOn(t *testing.T, book json.RawMessage, dec uint8, native bool, chain valueobject.ChainID) *PoolSimulator {
+	t.Helper()
+	extra, _ := json.Marshal(map[string]json.RawMessage{"book": book})
+	static, _ := json.Marshal(StaticExtra{FloorAmm: "0xf100", LaunchID: 7, IsNative: native})
+	s, err := NewPoolSimulator(entity.Pool{Address: "0xf100-7", Exchange: DexType, Type: DexType,
+		Tokens:   []*entity.PoolToken{{Address: "quote", Decimals: 6}, {Address: "token", Decimals: dec}},
+		Reserves: entity.PoolReserves{"0", "0"}, Extra: string(extra), StaticExtra: string(static)}, chain)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return s
+}
+
+func bookOf(t *testing.T, raw json.RawMessage) floorv2.Book {
+	t.Helper()
+	var b floorv2.Book
+	if err := json.Unmarshal(raw, &b); err != nil {
+		t.Fatal(err)
+	}
+	return b
+}
+
+func TestSimulatorReplaysGoldenBook(t *testing.T) {
+	scale := new(big.Int).Exp(big.NewInt(10), big.NewInt(12), nil)
+	n := map[string]int{}
+	for _, c := range loadBookCases(t) {
+		if (c.Fn != "buy" && c.Fn != "sell") || c.StateIn == nil {
+			continue
+		}
+		s := poolOf(t, c.StateIn, 18)
+		before := s.book
+		_, refusedCase := c.Out["err"]
+		var p pool.CalcAmountOutParams
+		if c.Fn == "buy" {
+			if mustU(t, c.Args["min_tokens"]).Sign() != 0 {
+				continue
+			}
+			p = pool.CalcAmountOutParams{TokenAmountIn: pool.TokenAmount{Token: "quote", Amount: mustU(t, c.Args["gross"]).ToBig()}, TokenOut: "token"}
+		} else {
+			if mustU(t, c.Args["min_out"]).Sign() != 0 {
+				continue
+			}
+			in := new(big.Int).Mul(mustU(t, c.Args["tokens"]).ToBig(), scale)
+			p = pool.CalcAmountOutParams{TokenAmountIn: pool.TokenAmount{Token: "token", Amount: in}, TokenOut: "quote"}
+		}
+		res, err := s.CalcAmountOut(p)
+		if s.book != before {
+			t.Fatalf("%s: the quote moved the simulator's book", c.ID)
+		}
+		if refusedCase || (c.Fn == "buy" && mustU(t, c.Out["tokens"]).IsZero()) || (c.Fn == "sell" && mustU(t, c.Out["out"]).IsZero()) {
+			if err == nil {
+				t.Fatalf("%s: priced a trade the book refuses", c.ID)
+			}
+			n["refused"]++
+			continue
+		}
+		if err != nil {
+			t.Fatalf("%s: %v", c.ID, err)
+		}
+		var want, back *big.Int
+		if c.Fn == "buy" {
+			want = new(big.Int).Mul(mustU(t, c.Out["tokens"]).ToBig(), scale)
+			back = mustU(t, c.Out["refund"]).ToBig()
+		} else {
+			want = mustU(t, c.Out["out"]).ToBig()
+			back = new(big.Int).Mul(mustU(t, c.Out["unfilled"]).ToBig(), scale)
+		}
+		if res.TokenAmountOut.Amount.Cmp(want) != 0 {
+			t.Fatalf("%s: out %s, golden %s", c.ID, res.TokenAmountOut.Amount, want)
+		}
+		got := big.NewInt(0)
+		if res.RemainingTokenAmountIn != nil {
+			got = res.RemainingTokenAmountIn.Amount
+		}
+		if got.Cmp(back) != 0 {
+			t.Fatalf("%s: remaining %s, golden %s", c.ID, got, back)
+		}
+		s.UpdateBalance(pool.UpdateBalanceParams{SwapInfo: res.SwapInfo})
+		if c.StateOut != nil {
+			got, want := s.book, bookOf(t, c.StateOut)
+			if got.SqrtP != want.SqrtP || got.SqrtLMax != want.SqrtLMax || got.FloorTokens != want.FloorTokens ||
+				got.CkFloorTokens != want.CkFloorTokens || got.Graduated != want.Graduated || got.Ranges != want.Ranges {
+				t.Fatalf("%s: the walk's book after is not the golden one", c.ID)
+			}
+			if err := got.CheckWalked(); err != nil {
+				t.Fatalf("%s: the book after: %v", c.ID, err)
+			}
+		}
+		n[c.Fn]++
+	}
+	if n["buy"] < 10 || n["sell"] < 5 {
+		t.Fatalf("not exercised: %v", n)
+	}
+	t.Logf("%v", n)
+}
+
+func TestSimulatorRefusesShape(t *testing.T) {
+	c := loadBookCases(t)[0]
+	for _, tc := range []struct {
+		name string
+		dec  uint8
+		ex   string
+	}{{"decimals under 6", 5, `{"book":` + string(c.StateIn) + `}`}, {"not a book", 18, `{"book":{"sqrt_p":1}}`}} {
+		_, err := NewPoolSimulator(entity.Pool{Tokens: []*entity.PoolToken{{Address: "q"}, {Address: "t", Decimals: tc.dec}},
+			Extra: tc.ex, StaticExtra: "{}"}, valueobject.ChainIDEthereum)
+		if err == nil {
+			t.Errorf("%s: accepted", tc.name)
+		}
+	}
+	s := poolOf(t, c.StateIn, 18)
+	if _, err := s.CalcAmountOut(pool.CalcAmountOutParams{TokenAmountIn: pool.TokenAmount{Token: "token",
+		Amount: big.NewInt(999_999_999_999)}, TokenOut: "quote"}); err != ErrSubUnit {
+		t.Errorf("a sell under one math unit: %v", err)
+	}
+	if _, err := s.CalcAmountOut(pool.CalcAmountOutParams{TokenAmountIn: pool.TokenAmount{Token: "quote",
+		Amount: new(big.Int).Lsh(big.NewInt(1), 128)}, TokenOut: "token"}); err != ErrOverflow {
+		t.Errorf("a buy past u128: %v", err)
+	}
+	if _, err := s.CalcAmountOut(pool.CalcAmountOutParams{TokenAmountIn: pool.TokenAmount{Token: "quote",
+		Amount: big.NewInt(1)}, TokenOut: "quote"}); err != ErrInvalidToken {
+		t.Errorf("quote to quote: %v", err)
+	}
+}
+
+func TestSimulatorStaleAfterSwap(t *testing.T) {
+	var c bookCase
+	for _, k := range loadBookCases(t) {
+		if k.Fn == "buy" && k.StateIn != nil && mustU(t, k.Args["min_tokens"]).Sign() == 0 {
+			if _, refused := k.Out["err"]; !refused && !mustU(t, k.Out["tokens"]).IsZero() {
+				c = k
+				break
+			}
+		}
+	}
+	if c.StateIn == nil {
+		t.Fatal("no buy case")
+	}
+	p := pool.CalcAmountOutParams{TokenAmountIn: pool.TokenAmount{Token: "quote", Amount: mustU(t, c.Args["gross"]).ToBig()}, TokenOut: "token"}
+	s := poolOf(t, c.StateIn, 18)
+	res, err := s.CalcAmountOut(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// a quote alone changes nothing: it can be asked again
+	if _, err := s.CalcAmountOut(p); err != nil {
+		t.Fatalf("second quote before any swap: %v", err)
+	}
+	s.UpdateBalance(pool.UpdateBalanceParams{SwapInfo: res.SwapInfo})
+	if _, err := s.CalcAmountOut(p); err != ErrStaleAfterSwap {
+		t.Fatalf("quote after UpdateBalance: %v", err)
+	}
+	// a clone of the stale simulator is stale too
+	if _, err := s.CloneState().(*PoolSimulator).CalcAmountOut(p); err != ErrStaleAfterSwap {
+		t.Fatalf("quote on a clone of a stale simulator: %v", err)
+	}
+	// the tracker's refresh is a new simulator from the chain state
+	if _, err := poolOf(t, c.StateIn, 18).CalcAmountOut(p); err != nil {
+		t.Fatalf("fresh simulator: %v", err)
+	}
+}
+
+// TestSimulatorArcNative: on Arc a native launch's money is the native coin's 18-decimal base units while the pool's
+// quote token is the wrapped-native entry (the 6-decimal USDC interface on the same balance): amounts in are scaled up
+// before the walk; money out, fees, the refund and the quote reserve down (rounded down). Elsewhere, and for an ERC-20
+// quote on Arc, nothing is scaled.
+func TestSimulatorArcNative(t *testing.T) {
+	var c bookCase
+	for _, k := range loadBookCases(t) {
+		if k.Fn == "buy" && k.StateIn != nil && mustU(t, k.Args["min_tokens"]).Sign() == 0 {
+			if _, refused := k.Out["err"]; !refused && !mustU(t, k.Out["tokens"]).IsZero() {
+				c = k
+				break
+			}
+		}
+	}
+	if c.StateIn == nil {
+		t.Fatal("no buy case")
+	}
+	gross := mustU(t, c.Args["gross"]) // native base units
+	scale := big.NewInt(1e12)
+	in6 := new(big.Int).Quo(gross.ToBig(), scale)
+	in6.Add(in6, big.NewInt(1)) // a whole 6-decimal amount past the golden gross
+	arc := poolOn(t, c.StateIn, 18, true, valueobject.ChainIDArc)
+	got, err := arc.CalcAmountOut(pool.CalcAmountOutParams{TokenAmountIn: pool.TokenAmount{Token: "quote", Amount: in6}, TokenOut: "token"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	bk := bookOf(t, c.StateIn)
+	g, _ := uint256.FromBig(new(big.Int).Mul(in6, scale))
+	want, err := floorv2.Buy(&bk, *g, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var tok uint256.Int
+	tok.Mul(uint256.NewInt(want.Tokens), uint256.NewInt(1e12))
+	if got.TokenAmountOut.Amount.Cmp(tok.ToBig()) != 0 {
+		t.Errorf("Arc native buy: %v tokens, want %v", got.TokenAmountOut.Amount, tok.ToBig())
+	}
+	if f := new(big.Int).Quo(feeSum(&want.Fees).ToBig(), scale); got.Fee.Amount.Cmp(f) != 0 {
+		t.Errorf("Arc native fee: %v, want %v", got.Fee.Amount, f)
+	}
+	// the same pool off Arc, or with an ERC-20 quote on Arc, reads the amount as base units
+	for _, p := range []*PoolSimulator{poolOn(t, c.StateIn, 18, true, valueobject.ChainIDBase), poolOn(t, c.StateIn, 18, false, valueobject.ChainIDArc)} {
+		r, err := p.CalcAmountOut(pool.CalcAmountOutParams{TokenAmountIn: pool.TokenAmount{Token: "quote", Amount: gross.ToBig()}, TokenOut: "token"})
+		if err != nil {
+			t.Fatal(err)
+		}
+		b := bookOf(t, c.StateIn)
+		if exp, _ := floorv2.QuoteBuy(&b, *gross); r.TokenAmountOut.Amount.Cmp(new(big.Int).Mul(new(big.Int).SetUint64(exp.Tokens), scale)) != 0 {
+			t.Errorf("unscaled pool: %v tokens", r.TokenAmountOut.Amount)
+		}
+	}
+	// the sell's money out comes back at 6 decimals (both refuse alike on a book with no bid)
+	sold, errA := arc.CalcAmountOut(pool.CalcAmountOutParams{TokenAmountIn: pool.TokenAmount{Token: "token", Amount: tok.ToBig()}, TokenOut: "quote"})
+	b2 := bookOf(t, c.StateIn)
+	ws, errW := floorv2.Sell(&b2, want.Tokens, uint256.Int{})
+	if (errA == nil) != (errW == nil) {
+		t.Fatalf("Arc native sell: %v, the math: %v", errA, errW)
+	}
+	if errA == nil {
+		if o := new(big.Int).Quo(ws.Out.ToBig(), scale); sold.TokenAmountOut.Amount.Cmp(o) != 0 {
+			t.Errorf("Arc native sell out: %v, want %v", sold.TokenAmountOut.Amount, o)
+		}
+	}
+	// the reserve after the buy: the bid money and the money in place, at 6 decimals
+	arc.UpdateBalance(pool.UpdateBalanceParams{SwapInfo: got.SwapInfo})
+	mh := bk.MoneyHeld()
+	if r0 := arc.Info.Reserves[0]; r0.Cmp(new(big.Int).Quo(mh.ToBig(), scale)) != 0 {
+		t.Errorf("Arc native reserve: %v, want %v", r0, new(big.Int).Quo(mh.ToBig(), scale))
+	}
+}
diff --git a/pkg/liquidity-source/floor-amm/pool_tracker.go b/pkg/liquidity-source/floor-amm/pool_tracker.go
new file mode 100644
index 00000000..3fd293a4
--- /dev/null
+++ b/pkg/liquidity-source/floor-amm/pool_tracker.go
@@ -0,0 +1,183 @@
+package flooramm
+
+import (
+	"context"
+	"math/big"
+	"time"
+
+	"github.com/KyberNetwork/ethrpc"
+	"github.com/goccy/go-json"
+	"github.com/holiman/uint256"
+
+	"github.com/KyberNetwork/kyberswap-dex-lib/pkg/entity"
+	floorv2 "github.com/KyberNetwork/kyberswap-dex-lib/pkg/liquidity-source/floor-amm/math/v2"
+	"github.com/KyberNetwork/kyberswap-dex-lib/pkg/source/pool"
+	pooltrack "github.com/KyberNetwork/kyberswap-dex-lib/pkg/source/pool/tracker"
+)
+
+var _ = pooltrack.RegisterFactoryCE0(DexType, NewPoolTracker)
+
+// bookRangeV is FloorBookTypes.BookRange as go-ethereum decodes it.
+type bookRangeV struct {
+	SqrtA    *big.Int
+	SqrtB    *big.Int
+	Tokens   uint64
+	AskLeft  uint64
+	Back     uint64
+	Place    *big.Int
+	ThetaBps uint16
+	PsiBps   uint16
+	Kind     uint8
+	Class    uint8
+}
+
+// launchBookV is FloorBookTypes.LaunchBook.
+type launchBookV struct {
+	SqrtP         *big.Int
+	SqrtF         *big.Int
+	F             *big.Int
+	BandMoney     []*big.Int
+	NRanges       uint8
+	Ranges        [floorv2.RangesMax]bookRangeV
+	SqrtLMax      *big.Int
+	FloorTokens   uint64
+	BandTokens    []uint64
+	BandEdge      []*big.Int
+	NBands        uint8
+	NC            uint8
+	BandF         []*big.Int
+	BandFClaim    []*big.Int
+	CkAtF         *big.Int
+	CkFloorTokens uint64
+	Graduated     bool
+	FeePpm        [floorv2.FeeLegs]uint32
+}
+
+// u128 is a view's money or √p: nil is 0; past u128 is refused (the math holds u128 only).
+func u128(x *big.Int) (uint256.Int, error) {
+	var v uint256.Int
+	if x == nil {
+		return v, nil
+	}
+	if x.Sign() < 0 || x.BitLen() > 128 {
+		return v, ErrViewShape
+	}
+	v.SetFromBig(x)
+	return v, nil
+}
+
+// feeCurveV is FloorBookTypes.FeeCurve: each leg's start rate and the knots' √ (`SqrtFeeB` 0 = no curve).
+type feeCurveV struct {
+	FeeStartPpm [floorv2.FeeLegs]uint32
+	SqrtFeeA    *big.Int
+	SqrtFeeB    *big.Int
+}
+
+// extraOf maps one block's launchBook and launchFeeCurve onto the simulator's state. The book's band arrays are the
+// storage's band slots wide (at most BidsMax, the edges one more). `FeePpm` is the curve's end; the curve's start and
+// knots are launchFeeCurve's, so a curve launch prices exactly.
+func extraOf(bv *launchBookV, cv *feeCurveV) (Extra, error) {
+	var ex Extra
+	b := &ex.Book
+	if int(bv.NRanges) > floorv2.RangesMax || int(bv.NBands) > floorv2.BidsMax || bv.NC > bv.NBands || len(bv.BandMoney) > floorv2.BidsMax ||
+		len(bv.BandTokens) > floorv2.BidsMax || len(bv.BandEdge) > floorv2.BidsMax+1 || len(bv.BandF) > floorv2.BidsMax ||
+		len(bv.BandFClaim) > floorv2.BidsMax {
+		return ex, ErrViewShape
+	}
+	var err error
+	set := func(dst *uint256.Int, x *big.Int) {
+		if err == nil {
+			*dst, err = u128(x)
+		}
+	}
+	set(&b.SqrtP, bv.SqrtP)
+	set(&b.SqrtF, bv.SqrtF)
+	set(&b.SqrtLMax, bv.SqrtLMax)
+	set(&b.Floor, bv.F)
+	set(&b.CkAtF, bv.CkAtF)
+	set(&b.SqrtFeeA, cv.SqrtFeeA)
+	set(&b.SqrtFeeB, cv.SqrtFeeB)
+	b.FeeStartPpm = cv.FeeStartPpm
+	for i, x := range bv.BandMoney {
+		set(&b.BandMoney[i], x)
+	}
+	for i, x := range bv.BandF {
+		set(&b.BandF[i], x)
+	}
+	for i, x := range bv.BandFClaim {
+		set(&b.BandFClaim[i], x)
+	}
+	for i, x := range bv.BandEdge {
+		set(&b.BandEdge[i], x)
+	}
+	copy(b.BandTokens[:], bv.BandTokens)
+	b.FloorTokens, b.CkFloorTokens, b.NBands, b.NC, b.Graduated, b.FeePpm = bv.FloorTokens, bv.CkFloorTokens, bv.NBands, bv.NC, bv.Graduated, bv.FeePpm
+	b.NRanges = bv.NRanges
+	for i := range bv.Ranges[:bv.NRanges] {
+		r, o := &bv.Ranges[i], &b.Ranges[i]
+		set(&o.SqrtA, r.SqrtA)
+		set(&o.SqrtB, r.SqrtB)
+		set(&o.Place, r.Place)
+		o.Tokens, o.AskLeft, o.Back = r.Tokens, r.AskLeft, r.Back
+		o.ThetaBps, o.PsiBps, o.Kind, o.Class = r.ThetaBps, r.PsiBps, r.Kind, r.Class
+	}
+	if err != nil {
+		return ex, err
+	}
+	if err := b.Check(); err != nil {
+		return ex, ErrInvalidSnapshot
+	}
+	return ex, nil
+}
+
+// PoolTracker snapshots a launch's book for PoolSimulator.
+type PoolTracker struct {
+	config       *Config
+	ethrpcClient *ethrpc.Client
+}
+
+func NewPoolTracker(config *Config, ethrpcClient *ethrpc.Client) *PoolTracker {
+	return &PoolTracker{config: config, ethrpcClient: ethrpcClient}
+}
+
+// GetNewPoolState reads launchBook and launchFeeCurve at one block. Nothing pauses a buy or a sell: there is no pause flag to track.
+func (t *PoolTracker) GetNewPoolState(ctx context.Context, p entity.Pool, _ pool.GetNewPoolStateParams) (entity.Pool, error) {
+	var se StaticExtra
+	if err := json.Unmarshal([]byte(p.StaticExtra), &se); err != nil {
+		return p, err
+	}
+	if len(p.Tokens) != 2 || p.Tokens[1].Decimals < tokenMathDecimals {
+		return p, ErrTokenDecimals
+	}
+	id := new(big.Int).SetUint64(se.LaunchID)
+	// each view returns ONE tuple: go-ethereum unpacks a single output into the destination's first field
+	var bookOut struct{ Book launchBookV }
+	var curveOut struct{ Curve feeCurveV }
+	res, err := t.ethrpcClient.NewRequest().SetContext(ctx).
+		AddCall(&ethrpc.Call{ABI: floorAmmViewsABI, Target: se.FloorAmm, Method: methodLaunchBook, Params: []any{id}},
+			[]any{&bookOut}).
+		AddCall(&ethrpc.Call{ABI: floorAmmViewsABI, Target: se.FloorAmm, Method: methodFeeCurve, Params: []any{id}},
+			[]any{&curveOut}).
+		Aggregate()
+	if err != nil {
+		return p, err
+	}
+	ex, err := extraOf(&bookOut.Book, &curveOut.Curve)
+	if err != nil {
+		return p, err
+	}
+	extra, err := json.Marshal(ex)
+	if err != nil {
+		return p, err
+	}
+	var scale uint256.Int
+	scale.Exp(uint256.NewInt(10), uint256.NewInt(uint64(p.Tokens[1].Decimals-tokenMathDecimals)))
+	rs := bookReserves(&ex.Book, &scale, se.IsNative, t.config.ChainID)
+	p.Extra = string(extra)
+	p.Reserves = entity.PoolReserves{rs[0].String(), rs[1].String()}
+	if res.BlockNumber != nil {
+		p.BlockNumber = res.BlockNumber.Uint64()
+	}
+	p.Timestamp = time.Now().Unix()
+	return p, nil
+}
diff --git a/pkg/liquidity-source/floor-amm/pool_tracker_test.go b/pkg/liquidity-source/floor-amm/pool_tracker_test.go
new file mode 100644
index 00000000..037f3aec
--- /dev/null
+++ b/pkg/liquidity-source/floor-amm/pool_tracker_test.go
@@ -0,0 +1,214 @@
+package flooramm
+
+import (
+	"fmt"
+	"math/big"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/goccy/go-json"
+
+	"github.com/KyberNetwork/kyberswap-dex-lib/pkg/source/pool"
+
+	floorv2 "github.com/KyberNetwork/kyberswap-dex-lib/pkg/liquidity-source/floor-amm/math/v2"
+)
+
+// The tracker's decode: every golden book (before and after each walk) as FloorAmmViewsV2's launchBook and
+// launchFeeCurve would return it, ABI-encoded with the forge ABI, decoded the way ethrpc does (UnpackIntoInterface into
+// the first field), mapped by extraOf: the book must come back identical, its fee curve included, at the storage's band
+// width (24) and at a 4-slot one.
+
+func viewOf(b *floorv2.Book, slots int) launchBookV {
+	bv := launchBookV{SqrtP: b.SqrtP.ToBig(), SqrtF: b.SqrtF.ToBig(), F: b.Floor.ToBig(), NRanges: b.NRanges,
+		SqrtLMax: b.SqrtLMax.ToBig(), FloorTokens: b.FloorTokens, NBands: b.NBands, NC: b.NC, CkAtF: b.CkAtF.ToBig(),
+		CkFloorTokens: b.CkFloorTokens, Graduated: b.Graduated, FeePpm: b.FeePpm,
+		BandMoney: make([]*big.Int, slots), BandTokens: make([]uint64, slots), BandEdge: make([]*big.Int, slots+1),
+		BandF: make([]*big.Int, slots), BandFClaim: make([]*big.Int, slots)}
+	for i := 0; i < slots; i++ {
+		bv.BandMoney[i], bv.BandTokens[i] = b.BandMoney[i].ToBig(), b.BandTokens[i]
+		bv.BandF[i], bv.BandFClaim[i] = b.BandF[i].ToBig(), b.BandFClaim[i].ToBig()
+	}
+	for i := 0; i <= slots; i++ {
+		bv.BandEdge[i] = b.BandEdge[i].ToBig()
+	}
+	for i := range bv.Ranges {
+		r := &b.Ranges[i]
+		bv.Ranges[i] = bookRangeV{SqrtA: r.SqrtA.ToBig(), SqrtB: r.SqrtB.ToBig(), Tokens: r.Tokens, AskLeft: r.AskLeft,
+			Back: r.Back, Place: r.Place.ToBig(), ThetaBps: r.ThetaBps, PsiBps: r.PsiBps, Kind: r.Kind, Class: r.Class}
+	}
+	return bv
+}
+
+func curveOf(b *floorv2.Book) feeCurveV {
+	return feeCurveV{FeeStartPpm: b.FeeStartPpm, SqrtFeeA: b.SqrtFeeA.ToBig(), SqrtFeeB: b.SqrtFeeB.ToBig()}
+}
+
+// overTheWire packs the views with the forge ABI and decodes them as ethrpc does.
+func overTheWire(t *testing.T, bv launchBookV, cv feeCurveV) (launchBookV, feeCurveV) {
+	t.Helper()
+	raw, err := floorAmmViewsABI.Methods[methodLaunchBook].Outputs.Pack(bv)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var out struct{ Book launchBookV }
+	if err := floorAmmViewsABI.UnpackIntoInterface(&out, methodLaunchBook, raw); err != nil {
+		t.Fatal(err)
+	}
+	rawCurve, err := floorAmmViewsABI.Methods[methodFeeCurve].Outputs.Pack(cv)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var outCurve struct{ Curve feeCurveV }
+	if err := floorAmmViewsABI.UnpackIntoInterface(&outCurve, methodFeeCurve, rawCurve); err != nil {
+		t.Fatal(err)
+	}
+	return out.Book, outCurve.Curve
+}
+
+func fitsSlots(b *floorv2.Book, k int) bool {
+	for i := k; i < floorv2.BidsMax; i++ {
+		if !b.BandMoney[i].IsZero() || b.BandTokens[i] != 0 || !b.BandEdge[i+1].IsZero() || !b.BandF[i].IsZero() ||
+			!b.BandFClaim[i].IsZero() {
+			return false
+		}
+	}
+	return true
+}
+
+func TestTrackerDecodesViews(t *testing.T) {
+	n := map[string]int{}
+	for _, c := range loadBookCases(t) {
+		for _, raw := range []json.RawMessage{c.StateIn, c.StateOut} {
+			if raw == nil {
+				continue
+			}
+			b := bookOf(t, raw)
+			slots := []int{floorv2.BidsMax}
+			if fitsSlots(&b, 4) {
+				slots = append(slots, 4)
+			}
+			for _, k := range slots {
+				bv, cv := overTheWire(t, viewOf(&b, k), curveOf(&b))
+				ex, err := extraOf(&bv, &cv)
+				if err != nil {
+					t.Fatalf("%s: %v", c.ID, err)
+				}
+				if ex.Book != b {
+					t.Fatalf("%s (%d slots): the view decodes to another book", c.ID, k)
+				}
+				n[fmt.Sprintf("slots %d", k)]++
+				if !b.SqrtFeeB.IsZero() {
+					n["curve"]++
+				}
+			}
+		}
+	}
+	if n["slots 4"] == 0 || n["slots 24"] == 0 || n["curve"] == 0 {
+		t.Fatalf("not exercised: %v", n)
+	}
+	t.Logf("%v", n)
+}
+
+func TestTrackerRefusesViews(t *testing.T) {
+	b := bookOf(t, loadBookCases(t)[0].StateIn)
+	cv := curveOf(&b)
+	if bv := viewOf(&b, floorv2.BidsMax); func() error { _, err := extraOf(&bv, &cv); return err }() != nil {
+		t.Fatal("the good view is refused")
+	}
+	for name, mut := range map[string]func(*launchBookV){
+		"money past u128": func(v *launchBookV) { v.F = new(big.Int).Lsh(big.NewInt(1), 128) },
+		"bands past 24":   func(v *launchBookV) { v.BandMoney = append(v.BandMoney, big.NewInt(0)) },
+		"ranges past 48":  func(v *launchBookV) { v.NRanges = 49 },
+	} {
+		bv := viewOf(&b, floorv2.BidsMax)
+		mut(&bv)
+		if _, err := extraOf(&bv, &cv); err == nil {
+			t.Errorf("%s: accepted", name)
+		}
+	}
+	// the tracker's Extra feeds the simulator unchanged
+	bad := feeCurveV{SqrtFeeA: big.NewInt(0), SqrtFeeB: new(big.Int).Lsh(big.NewInt(1), 128)}
+	if bv := viewOf(&b, floorv2.BidsMax); func() error { _, err := extraOf(&bv, &bad); return err }() == nil {
+		t.Error("a curve knot past u128: accepted")
+	}
+	bv := viewOf(&b, floorv2.BidsMax)
+	ex, _ := extraOf(&bv, &cv)
+	raw, _ := json.Marshal(ex)
+	var back Extra
+	if err := json.Unmarshal(raw, &back); err != nil || back != ex {
+		t.Fatalf("Extra round trip: %v", err)
+	}
+}
+
+// A curve launch read through both views prices its golden sells exactly; read without launchFeeCurve (the curve's end
+// rate alone, as before the view) the same sells price otherwise.
+func TestTrackerPricesCurveLaunches(t *testing.T) {
+	scale := new(big.Int).Exp(big.NewInt(10), big.NewInt(12), nil)
+	exact, differ := 0, 0
+	for _, c := range loadBookCases(t) {
+		if c.Fn != "sell" || c.StateIn == nil || mustU(t, c.Args["min_out"]).Sign() != 0 {
+			continue
+		}
+		if _, refused := c.Out["err"]; refused || mustU(t, c.Out["out"]).IsZero() || !mustU(t, c.Out["unfilled"]).IsZero() {
+			continue
+		}
+		b := bookOf(t, c.StateIn)
+		if b.SqrtFeeB.IsZero() {
+			continue
+		}
+		in := new(big.Int).Mul(mustU(t, c.Args["tokens"]).ToBig(), scale)
+		price := func(cv feeCurveV) *big.Int {
+			bv, cv := overTheWire(t, viewOf(&b, floorv2.BidsMax), cv)
+			ex, err := extraOf(&bv, &cv)
+			if err != nil {
+				t.Fatalf("%s: %v", c.ID, err)
+			}
+			raw, _ := json.Marshal(ex.Book)
+			res, err := poolOf(t, raw, 18).CalcAmountOut(pool.CalcAmountOutParams{
+				TokenAmountIn: pool.TokenAmount{Token: "token", Amount: in}, TokenOut: "quote"})
+			if err != nil {
+				t.Fatalf("%s: %v", c.ID, err)
+			}
+			return res.TokenAmountOut.Amount
+		}
+		if got, want := price(curveOf(&b)), mustU(t, c.Out["out"]).ToBig(); got.Cmp(want) != 0 {
+			t.Fatalf("%s: out %s, golden %s", c.ID, got, want)
+		}
+		exact++
+		if price(feeCurveV{SqrtFeeA: big.NewInt(0), SqrtFeeB: big.NewInt(0)}).Cmp(mustU(t, c.Out["out"]).ToBig()) != 0 {
+			differ++
+		}
+	}
+	if exact == 0 || differ == 0 {
+		t.Fatalf("not exercised: %d exact, %d differ at the end rate", exact, differ)
+	}
+	t.Logf("%d curve sells exact, %d of them priced otherwise at the end rate", exact, differ)
+}
+
+func TestQuoteVetted(t *testing.T) {
+	listed := &quoteEntry{Listed: true}
+	if !quoteVetted(listed, false) || quoteVetted(&quoteEntry{}, false) || quoteVetted(nil, false) || !quoteVetted(nil, true) {
+		t.Fatal("quoteVetted")
+	}
+	keep, still := vetLaunches([]unlistedLaunch{{ID: 1}, {ID: 2, Quote: [20]byte{1}}},
+		map[common.Address]*quoteEntry{{}: listed, {1}: {}}, false)
+	if len(keep) != 1 || keep[0].ID != 1 || len(still) != 1 || still[0].ID != 2 {
+		t.Fatalf("vetLaunches: %v %v", keep, still)
+	}
+}
+
+// TestUnlistedLaunchListedLater: the lister reads the registry, not the create event's `listed` flag (a lister has no
+// log access), so a launch created with an unlisted quote is held back (pass 1) and listed once QuoteWritten has
+// listed its quote (pass 2); a launch whose quote was listed at create is listed at once.
+func TestUnlistedLaunchListedLater(t *testing.T) {
+	late, early := common.Address{2}, common.Address{3}
+	launches := []unlistedLaunch{{ID: 1, Quote: late}, {ID: 2, Quote: early}}
+	keep, still := vetLaunches(launches, map[common.Address]*quoteEntry{late: {}, early: {Listed: true}}, false)
+	if len(keep) != 1 || keep[0].ID != 2 || len(still) != 1 || still[0].ID != 1 {
+		t.Fatalf("pass 1: keep %v still %v", keep, still)
+	}
+	keep, still = vetLaunches(still, map[common.Address]*quoteEntry{late: {Listed: true}}, false)
+	if len(keep) != 1 || keep[0].ID != 1 || len(still) != 0 {
+		t.Fatalf("pass 2: keep %v still %v", keep, still)
+	}
+}
diff --git a/pkg/liquidity-source/floor-amm/type.go b/pkg/liquidity-source/floor-amm/type.go
new file mode 100644
index 00000000..9d7469bb
--- /dev/null
+++ b/pkg/liquidity-source/floor-amm/type.go
@@ -0,0 +1,61 @@
+package flooramm
+
+import (
+	"math/big"
+
+	floorv2 "github.com/KyberNetwork/kyberswap-dex-lib/pkg/liquidity-source/floor-amm/math/v2"
+)
+
+// StaticExtra is what never changes for a launch.
+type StaticExtra struct {
+	FloorAmm string `json:"floorAmm"`
+	LaunchID uint64 `json:"launchId"`
+	IsNative bool   `json:"isNative"`
+}
+
+// Extra is the tracker's snapshot of a launch: its book, as `launchBook` returns it, in golden/v2's book_json.
+type Extra struct {
+	Book floorv2.Book `json:"book"`
+}
+
+// SwapInfo is the trade's receipt and the book after it (UpdateBalance consumes it, never recomputes).
+type SwapInfo struct {
+	IsBuy    bool   `json:"isBuy"`
+	LaunchID uint64 `json:"launchId"`
+	FloorAmm string `json:"floorAmm"`
+	// Refund: the part of a buy the book did not take (an ERC-20 quote is never pulled for it).
+	Refund string `json:"refund,omitempty"`
+
+	after *floorv2.Book
+}
+
+// MetaInfo: what the executor needs.
+type MetaInfo struct {
+	BlockNumber uint64 `json:"blockNumber"`
+	FloorAmm    string `json:"floorAmm"`
+	LaunchID    uint64 `json:"launchId"`
+	IsNative    bool   `json:"isNative"`
+}
+
+// quoteEntry is the registry's QuoteEntry (quoteEntry(token)).
+type quoteEntry struct {
+	Listed      bool
+	Enabled     bool
+	Decimals    uint8
+	CreateFee   *big.Int
+	UsdCentsX64 *big.Int
+	Launches    uint64
+	UpdatedAt   uint64
+}
+
+// quoteEntryOut wraps quoteEntry's one tuple output (go-ethereum copies a single output into a struct's first field).
+type quoteEntryOut struct {
+	Entry quoteEntry
+}
+
+// quoteVetted is the lister's policy: a launch is listed as a pool only when its quote is in the registry. An unlisted
+// quote is any ERC-20 its creator priced; nothing has vetted its transfer behaviour, so such a launch is not routed
+// unless routeUnlisted is set.
+func quoteVetted(entry *quoteEntry, routeUnlisted bool) bool {
+	return routeUnlisted || (entry != nil && entry.Listed)
+}
