+package flooramm
+
+import (
+	"errors"
+)
+
+const (
+	DexType = "floor-amm"
+
+	// Gas: FloorAmmV2's buy and sell, the largest measured over every launch state and both presets (693,651 and
+	// 740,775), rounded up; a long walk costs more.
+	buyGas  = 700_000
+	sellGas = 750_000
+
+	defaultNewPoolLimit = 100
+
+	// tokenMathDecimals: a token math unit is 10⁻⁶ token on every chain.
+	tokenMathDecimals = 6
+)
+
+var (
+	ErrInvalidToken    = errors.New("invalid token")
+	ErrOverflow        = errors.New("overflow")
+	ErrZeroOut         = errors.New("zero amount out")
+	ErrInvalidSnapshot = errors.New("invalid launch snapshot")
+	ErrTokenDecimals   = errors.New("floor-amm: token decimals under 6")
+	ErrSubUnit         = errors.New("floor-amm: sell under one token math unit")
+	ErrStaleAfterSwap  = errors.New("floor-amm: book stale after a swap, refresh from chain")
+	ErrViewShape       = errors.New("floor-amm: view out of the math's bounds")
+)
